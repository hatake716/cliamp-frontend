@@ -0,0 +1,286 @@
+//go:build !windows
+
+package spotify
+
+// webonly.go — Spotify without librespot ("web-only" sessions).
+//
+// cliamp builds a go-librespot session from the OAuth token for streaming.
+// Spotify refuses that login for Free accounts and for tokens of many
+// user-registered Developer apps (login5 answers INVALID_CREDENTIALS), while
+// the same token works for the Web API. Instead of failing the whole provider,
+// the session then keeps the token and runs web-only: playlists, liked songs
+// and search come from the Web API, and every track is handed to the player as
+// a YouTube search (bridge.go). Premium sessions are unchanged.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"sync"
+
+	"github.com/devgianlu/go-librespot/ap"
+	"github.com/devgianlu/go-librespot/login5"
+	pb "github.com/devgianlu/go-librespot/proto/spotify"
+	login5pb "github.com/devgianlu/go-librespot/proto/spotify/login5/v3"
+	"golang.org/x/oauth2"
+
+	"cliamp/applog"
+	"cliamp/playlist"
+)
+
+// PlaybackYouTube is PlaybackVia's answer for a web-only session.
+const PlaybackYouTube = "youtube"
+
+// ErrStreamingUnavailable is returned for a spotify:track: URI when the
+// session has no librespot player (web-only).
+var ErrStreamingUnavailable = errors.New("spotify: streaming unavailable (this Spotify connection is Web API only; Spotify Premium is required to stream Spotify tracks)")
+
+// streamingRejected reports whether err from creating the librespot session
+// means Spotify refused these credentials or this account for streaming —
+// something retrying will not fix — and describes why. Only these count:
+//
+//   - login5 LoginError INVALID_CREDENTIALS or UNKNOWN_IDENTIFIER (the token
+//     or identity is not accepted; seen with user-registered client IDs).
+//   - access point APLoginFailed BadCredentials or PremiumAccountRequired.
+//
+// Everything else — network and TLS errors, context expiry, client token or
+// apresolve failures, login5 TIMEOUT / TRY_AGAIN_LATER / TOO_MANY_ATTEMPTS /
+// UNKNOWN_ERROR (also what an empty or garbled reply decodes to), access point
+// TryAnotherAP and the like — is not a rejection and keeps failing as before.
+func streamingRejected(err error) (string, bool) {
+	var le *login5.LoginError
+	if errors.As(err, &le) {
+		switch le.Code {
+		case login5pb.LoginError_INVALID_CREDENTIALS, login5pb.LoginError_UNKNOWN_IDENTIFIER:
+			return fmt.Sprintf("login5 refused the credentials (%s)", le.Code), true
+		}
+		return "", false
+	}
+	var ae *ap.AccesspointLoginError
+	if errors.As(err, &ae) {
+		// GetErrorCode is nil-safe (Message can be nil).
+		switch code := ae.Message.GetErrorCode(); code {
+		case pb.ErrorCode_BadCredentials, pb.ErrorCode_PremiumAccountRequired:
+			return fmt.Sprintf("the access point refused the login (%s)", code), true
+		}
+	}
+	return "", false
+}
+
+// webOnlyRestorable reports whether c describes a web-only session that can
+// be restored without a browser.
+func (c *storedCreds) webOnlyRestorable() bool {
+	return c.WebOnly && c.RefreshToken != ""
+}
+
+// newWebOnlySession builds a session that only talks to the Web API and
+// persists it as web-only, so later launches restore it silently.
+func newWebOnlySession(clientID, devID string, token *oauth2.Token, userID, reason string) *Session {
+	credsFileMu.Lock()
+	defer credsFileMu.Unlock()
+	return newWebOnlySessionLocked(clientID, devID, token, userID, reason)
+}
+
+// newWebOnlySessionLocked is newWebOnlySession for a caller holding credsFileMu.
+func newWebOnlySessionLocked(clientID, devID string, token *oauth2.Token, userID, reason string) *Session {
+	conf := spotifyOAuthConfig(clientID)
+	ts := &savingTokenSource{
+		src:  conf.TokenSource(context.Background(), token),
+		last: token.RefreshToken,
+	}
+	s := &Session{devID: devID, clientID: clientID, tokenSource: ts, webOnly: true, userID: userID}
+	if err := saveCreds(&storedCreds{
+		DeviceID:     devID,
+		RefreshToken: token.RefreshToken,
+		WebOnly:      true,
+		UserID:       userID,
+	}); err != nil {
+		applog.UserError("spotify: failed to save credentials: %v", err)
+	}
+	applog.Info("spotify: connected in web-only mode: %s; playlists and library come from the Web API and tracks play through YouTube (Spotify Premium is required to stream from Spotify)", reason)
+	return s
+}
+
+// newWebOnlyFromStored restores a web-only session from its refresh token.
+// It never opens a browser and does not try librespot again (run
+// 'cliamp spotify reset' after upgrading to Premium).
+//
+// A web-only session has nothing but its refresh token, and Spotify's rotated
+// refresh tokens are single use. So the read → refresh → save runs under
+// credsFileMu, and the token refreshed is the one on disk now rather than the
+// one creds was loaded with: a restore that ran meanwhile (a sign-in racing a
+// silent restore) has already used that one and stored its successor.
+func newWebOnlyFromStored(clientID string, creds *storedCreds) (*Session, error) {
+	credsFileMu.Lock()
+	defer credsFileMu.Unlock()
+	cur, err := loadCreds()
+	if err != nil || !cur.webOnlyRestorable() || (cur.Username != "" && len(cur.Data) > 0) {
+		// Cleared ('cliamp spotify reset', or a refused token) or replaced
+		// since it was read.
+		return nil, fmt.Errorf("spotify: stored web-only credentials are gone: %w", playlist.ErrNeedsAuth)
+	}
+	creds = cur
+	devID := creds.DeviceID
+	if devID == "" {
+		devID = generateDeviceID()
+	}
+	token, err := silentTokenRefresh(clientID, creds.RefreshToken)
+	if refreshRefused(err) {
+		// Only clear what was refused: another process may have stored a
+		// newer token in the meantime.
+		if now, lerr := loadCreds(); lerr == nil && now.RefreshToken != creds.RefreshToken {
+			applog.Warn("spotify: stored refresh token was refused (%v) but has since been replaced; keeping the new one", err)
+		} else {
+			applog.UserError("spotify: Spotify refused the stored sign-in (%v); clearing credentials, please sign in again", err)
+			if _, err := DeleteCreds(); err != nil {
+				applog.Warn("spotify: failed to clear stored credentials: %v", err)
+			}
+		}
+		return nil, fmt.Errorf("spotify: %w", playlist.ErrNeedsAuth)
+	}
+	if err != nil {
+		// Passing trouble (network, 5xx, 429): keep the refresh token; the
+		// token source refreshes again on the next Web API call.
+		applog.Warn("spotify: token refresh failed (%v); retrying on the next Web API call", err)
+		token = &oauth2.Token{RefreshToken: creds.RefreshToken}
+	}
+	return newWebOnlySessionLocked(clientID, devID, token, creds.UserID, "restored from stored web-only credentials"), nil
+}
+
+// refreshRefused reports whether a refresh-token grant failed because Spotify
+// refused it for good, so only a new sign-in helps: invalid_grant (revoked,
+// expired or already used) or any other 4xx answer of the token endpoint,
+// such as invalid_client (the Developer app was deleted or disabled, or the
+// client_id changed). Network errors, 5xx, 408, 429 and a 4xx that says
+// temporarily_unavailable or server_error are passing trouble.
+func refreshRefused(err error) bool {
+	var rerr *oauth2.RetrieveError
+	if !errors.As(err, &rerr) {
+		return false
+	}
+	switch rerr.ErrorCode {
+	case "invalid_grant":
+		return true
+	case "temporarily_unavailable", "server_error":
+		return false
+	}
+	if rerr.Response == nil {
+		return false
+	}
+	code := rerr.Response.StatusCode
+	return code >= 400 && code < 500 && code != http.StatusRequestTimeout && code != http.StatusTooManyRequests
+}
+
+// credsFileMu serialises read-modify-write updates of the credentials file.
+var credsFileMu sync.Mutex
+
+// updateWebOnlyCreds applies mutate to the stored credentials when they are
+// web-only, and saves them if mutate reports a change. Credentials of a
+// librespot session, or a missing file ('cliamp spotify reset'), are left alone.
+func updateWebOnlyCreds(mutate func(*storedCreds) bool) {
+	credsFileMu.Lock()
+	defer credsFileMu.Unlock()
+	creds, err := loadCreds()
+	if err != nil || !creds.WebOnly || !mutate(creds) {
+		return
+	}
+	if err := saveCreds(creds); err != nil {
+		applog.Warn("spotify: failed to update stored credentials: %v", err)
+	}
+}
+
+// savingTokenSource persists the refresh token of a web-only session when
+// Spotify rotates it, so the next launch still restores silently (a web-only
+// session has nothing else to fall back on).
+type savingTokenSource struct {
+	src  oauth2.TokenSource
+	mu   sync.Mutex
+	last string
+}
+
+func (t *savingTokenSource) Token() (*oauth2.Token, error) {
+	tok, err := t.src.Token()
+	if err != nil {
+		return nil, err
+	}
+	t.mu.Lock()
+	changed := tok.RefreshToken != "" && tok.RefreshToken != t.last
+	if changed {
+		t.last = tok.RefreshToken
+	}
+	t.mu.Unlock()
+	if changed {
+		updateWebOnlyCreds(func(c *storedCreds) bool {
+			c.RefreshToken = tok.RefreshToken
+			return true
+		})
+	}
+	return tok, nil
+}
+
+// signInRequired reports whether Spotify refused this web-only session's
+// refresh token for good during the run (see webApiWithBody), so only a new
+// sign-in can bring it back. Always false for a librespot session.
+func (s *Session) signInRequired() bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.refused
+}
+
+// WebOnly reports whether the session has no librespot player: Spotify refused
+// streaming, so tracks are bridged to YouTube.
+func (s *Session) WebOnly() bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.webOnly
+}
+
+// UserID returns the Spotify user id remembered by a web-only session ("" if
+// unknown or not web-only).
+func (s *Session) UserID() string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.userID
+}
+
+// rememberUserID stores the user id of a web-only session (in memory and in
+// the credentials file) so later launches skip /v1/me. No-op otherwise.
+func (s *Session) rememberUserID(id string) {
+	if id == "" {
+		return
+	}
+	s.mu.Lock()
+	if !s.webOnly || s.userID == id {
+		s.mu.Unlock()
+		return
+	}
+	s.userID = id
+	s.mu.Unlock()
+	updateWebOnlyCreds(func(c *storedCreds) bool {
+		if c.UserID == id {
+			return false
+		}
+		c.UserID = id
+		return true
+	})
+}
+
+// webOnly reports whether the provider's current session is web-only.
+func (p *SpotifyProvider) webOnly() bool {
+	p.mu.Lock()
+	sess := p.session
+	p.mu.Unlock()
+	return sess != nil && sess.WebOnly()
+}
+
+// PlaybackVia reports where this provider's tracks are played from when it is
+// not Spotify itself: PlaybackYouTube while the live session is web-only, ""
+// otherwise (Premium, or no session yet). The IPC catalog puts it in
+// ProviderInfo.playback.
+func (p *SpotifyProvider) PlaybackVia() string {
+	if p.webOnly() {
+		return PlaybackYouTube
+	}
+	return ""
+}
