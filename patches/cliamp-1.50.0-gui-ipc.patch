+package local
+
+// gui.go — GUI 向け拡張 IPC (cliamp の catalog.go) が使う書き込み。
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+
+	"cliamp/playlist"
+)
+
+// ErrTrackMismatch is returned by RemoveTrackIf when the track at the index
+// does not satisfy the caller's check (the caller's view is out of date).
+var ErrTrackMismatch = errors.New("track at index does not match")
+
+// RemoveTrackIf is RemoveTrack, but when match is non-nil the track at index
+// must satisfy it, checked under the same lock as the rewrite; otherwise
+// nothing changes and ErrTrackMismatch is returned.
+func (p *Provider) RemoveTrackIf(name string, index int, match func(playlist.Track) bool) error {
+	if isHistoryName(name) {
+		return errReservedHistoryName
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	tracks, err := p.loadTOMLByName(name)
+	if err != nil {
+		return err
+	}
+	if index < 0 || index >= len(tracks) {
+		return fmt.Errorf("track index %d out of range", index)
+	}
+	if match != nil && !match(tracks[index]) {
+		return ErrTrackMismatch
+	}
+	tracks = slices.Delete(tracks, index, index+1)
+	if len(tracks) == 0 {
+		return p.deletePlaylistLocked(name)
+	}
+	return p.savePlaylist(name, tracks)
+}
