+package spotify
+
+// fake_test.go — fakes for the librespot session, the browser sign-in, the
+// accounts service and the Web API. Nothing in these tests reaches Spotify:
+// init() points every seam at a guard that fails, and each test swaps in the
+// fakes it needs via isolate().
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
