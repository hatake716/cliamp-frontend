+func TestPlaylistSnapshot(t *testing.T) {
+	pl := playlist.New()
+	pl.Replace([]playlist.Track{{Path: "/a"}, {Path: "/b"}, {Path: "/c"}, {Path: "/d"}})
+	pl.SetIndex(1)
+	pl.Queue(3)
+	pl.Queue(0)
