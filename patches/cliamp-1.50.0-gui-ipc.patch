diff --git a/ipc/shutdown.go b/ipc/shutdown.go
new file mode 100644
index 0000000..917d5d0
--- /dev/null
+++ b/ipc/shutdown.go
@@ -0,0 +1,49 @@
+package ipc
+
+// shutdown.go — Close で開いている接続を閉じるための記録。
+//
+// handleConn は EOF・読み取りの失敗・60 秒の無通信でしか戻らない。GUI は
+// status を 1 本の接続で送り続けるので、接続を閉じずに wg.Wait すると
+// Close が戻らない (TUI を終えても daemon に SIGTERM を送っても cliamp が
+// 終わらず、ソケットだけ消えて PID ファイルが残り、次に起動した cliamp が
+// IPC 無しで動く)。Close は接続を閉じてから待つ。読みかけの要求は
+// 読み取りの失敗で終わり、処理中の要求は s.done で待ちを切り上げる。
+
+import "net"
+
+// trackConn は受け付けた接続を記録し、wg に数える。Close の後なら記録せず
+// false を返す (呼ぶ側が閉じる)。判定と wg.Add を同じ鍵の中で行うので、
+// Close の直前に受け付けた接続も取りこぼさない。
+func (s *Server) trackConn(conn net.Conn) bool {
+	s.connMu.Lock()
+	defer s.connMu.Unlock()
+	if s.closed {
+		return false
+	}
+	if s.conns == nil {
+		s.conns = make(map[net.Conn]struct{})
+	}
+	s.conns[conn] = struct{}{}
+	s.wg.Add(1)
+	return true
+}
+
+// untrackConn は接続の記録を消して閉じる。
+func (s *Server) untrackConn(conn net.Conn) {
+	s.connMu.Lock()
+	delete(s.conns, conn)
+	s.connMu.Unlock()
+	conn.Close()
+}
+
+// closeConns は記録にある接続をすべて閉じ、以後の接続を受け付けない。
+// 読み取りの期限を今にするだけでは足りない (handleConn は要求のたびに
+// 期限を 60 秒先へ延ばすので、上書きされうる)。
+func (s *Server) closeConns() {
+	s.connMu.Lock()
+	defer s.connMu.Unlock()
+	s.closed = true
+	for c := range s.conns {
+		c.Close()
+	}
+}
