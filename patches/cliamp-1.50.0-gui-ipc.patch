@@ -0,0 +1,25 @@
+package player
+
+// supersede.go — 古くなった再生の開始の結果を捨てる。
+//
+// Play / PlayYTDL はパイプラインを組んでから (yt-dlp なら数秒) 差し替える。
+// その間に Stop や別の曲の開始があると、遅れて終わった古い開始が新しい曲を
+// 上書きし、表示と違う曲が鳴っていた。開始と Stop のたびに playGen を進め、
+// 差し替える時点で自分の世代が最新でなければ捨てる。yt-dlp のシーク
+// (SeekYTDL) は、差し替える時点で曲が変わっていれば捨てる (player.go)。
+
+import "errors"
+
+// ErrSuperseded は、組み立て中に Stop や新しい開始があったため、その開始を
+// 捨てたことを示す。呼ぶ側にとっては失敗ではない (表示すべきエラーではない)。
+var ErrSuperseded = errors.New("player: start superseded")
+
+// beginStart は再生の開始の世代を進めて返す。
+func (p *Player) beginStart() uint64 {
+	return p.playGen.Add(1)
+}
+
+// invalidateStarts は組み立て中の開始をすべて無効にする (Stop)。
+func (p *Player) invalidateStarts() {
+	p.playGen.Add(1)
+}
