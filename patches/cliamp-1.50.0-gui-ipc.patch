@@ -0,0 +1,303 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"slices"
+	"testing"
+	"time"
+
+	"cliamp/external/local"
+	"cliamp/history"
+	"cliamp/ipc"
+	"cliamp/lyrics"
+	"cliamp/playlist"
+	"cliamp/resolve"
+	"cliamp/ui/model"
+)
+
+type catalogTestProvider struct {
+	name   string
+	tracks []playlist.Track
+	lists  []playlist.PlaylistInfo
+	err    error
+}
+
+func (p *catalogTestProvider) Name() string { return p.name }
+func (p *catalogTestProvider) Playlists() ([]playlist.PlaylistInfo, error) {
+	return p.lists, p.err
+}
+func (p *catalogTestProvider) Tracks(string) ([]playlist.Track, error) { return p.tracks, p.err }
+
+type catalogTestSearcher struct {
+	catalogTestProvider
+	gotQuery string
+	gotLimit int
+}
+
+func (s *catalogTestSearcher) SearchTracks(_ context.Context, q string, limit int) ([]playlist.Track, error) {
+	s.gotQuery, s.gotLimit = q, limit
+	return s.tracks, s.err
+}
+
+// newTestCatalog は外への呼び出しをすべて偽物にした guiCatalog を作る。
+func newTestCatalog(entries ...model.ProviderEntry) (*guiCatalog, *[]string) {
+	var remote []string
+	c := &guiCatalog{
+		entries: entries,
+		resolveArgs: func(args []string) (resolve.Result, error) {
+			return resolve.Result{Pending: args}, nil
+		},
+		resolveRemote: func(urls []string) ([]playlist.Track, error) {
+			remote = append(remote, urls...)
+			return []playlist.Track{{Path: "https://www.youtube.com/watch?v=x", Stream: true}}, nil
+		},
+		unwrap: func(t []playlist.Track) []playlist.Track { return t },
+		fetchLyrics: func(string, string) ([]lyrics.Line, error) {
+			return nil, lyrics.ErrNotFound
+		},
+	}
+	return c, &remote
+}
+
+func TestCatalogProviders(t *testing.T) {
+	spotify := &catalogTestSearcher{catalogTestProvider: catalogTestProvider{name: "Spotify"}}
+	c, _ := newTestCatalog(
+		model.ProviderEntry{Key: "radio", Name: "Radio", Provider: &catalogTestProvider{name: "Radio"}},
+		model.ProviderEntry{Key: "spotify", Name: "Spotify", Provider: spotify},
+		model.ProviderEntry{Key: "nil", Name: "Nil"},
+	)
+	got := c.Providers()
+	want := []ipc.ProviderInfo{
+		{Key: "radio", Name: "Radio", Search: false, Playlists: true},
+		{Key: "spotify", Name: "Spotify", Search: true, Playlists: true},
+		{Key: "youtube", Name: "YouTube", Search: true, Virtual: true},
+	}
+	if !slices.Equal(got, want) {
+		t.Fatalf("Providers() =\n %+v\nwant\n %+v", got, want)
+	}
+
+	// 登録された youtube があれば疑似プロバイダーは出さない。
+	c, _ = newTestCatalog(model.ProviderEntry{Key: "youtube", Name: "YouTube", Provider: &catalogTestProvider{name: "YT"}})
+	got = c.Providers()
+	if len(got) != 1 || got[0].Virtual || !got[0].Search {
+		t.Fatalf("Providers() with a registered youtube = %+v", got)
+	}
+}
+
+func TestCatalogSearchFallbacks(t *testing.T) {
+	spotify := &catalogTestSearcher{catalogTestProvider: catalogTestProvider{name: "Spotify", tracks: []playlist.Track{{Path: "spotify:track:1"}}}}
+	c, remote := newTestCatalog(
+		model.ProviderEntry{Key: "radio", Name: "Radio", Provider: &catalogTestProvider{name: "Radio"}},
+		model.ProviderEntry{Key: "spotify", Name: "Spotify", Provider: spotify},
+	)
+
+	if _, err := c.Search("", "米津玄師", 25); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Search("radio", "lofi", 10); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Search("soundcloud", "ambient", 5); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ytsearch25:米津玄師", "ytsearch10:lofi", "scsearch5:ambient"}
+	if !slices.Equal(*remote, want) {
+		t.Fatalf("yt-dlp queries = %v, want %v", *remote, want)
+	}
+
+	tracks, err := c.Search("spotify", "q", 20)
+	if err != nil || len(tracks) != 1 || spotify.gotQuery != "q" || spotify.gotLimit != 20 {
+		t.Fatalf("Searcher not used: tracks=%v err=%v query=%q limit=%d", tracks, err, spotify.gotQuery, spotify.gotLimit)
+	}
+	if len(*remote) != 3 {
+		t.Fatal("Searcher search also ran yt-dlp")
+	}
+
+	for _, key := range []string{"url", "nosuch"} {
+		if _, err := c.Search(key, "q", 5); err == nil {
+			t.Errorf("Search(%q) succeeded, want error", key)
+		}
+	}
+}
+
+func TestCatalogTracks(t *testing.T) {
+	radio := &catalogTestProvider{name: "Radio", tracks: []playlist.Track{{Path: "https://radio.cliamp.stream/streams.m3u", Title: "cliamp radio", Stream: true, Realtime: true}}}
+	c, remote := newTestCatalog(model.ProviderEntry{Key: "radio", Name: "Radio", Provider: radio})
+	unwrapped := false
+	c.unwrap = func(t []playlist.Track) []playlist.Track { unwrapped = true; return t }
+
+	tracks, err := c.Tracks("radio", "l:0")
+	if err != nil || len(tracks) != 1 || !unwrapped {
+		t.Fatalf("Tracks(radio) = %v, %v (unwrapped=%v)", tracks, err, unwrapped)
+	}
+
+	tracks, err = c.Tracks("url", " https://www.youtube.com/watch?v=abc&list=RDabc ")
+	if err != nil || len(tracks) != 1 || !slices.Equal(*remote, []string{"https://www.youtube.com/watch?v=abc&list=RDabc"}) {
+		t.Fatalf("Tracks(url) = %v, %v (remote %v)", tracks, err, *remote)
+	}
+	// 手元のパスは受け付けない。
+	for _, bad := range []string{"/etc/passwd", "~/Music", "file:///tmp/a.mp3", "ytsearch5:foo"} {
+		if _, err := c.Tracks("url", bad); err == nil {
+			t.Errorf("Tracks(url, %q) succeeded, want error", bad)
+		}
+	}
+	for _, key := range []string{"youtube", "nosuch"} {
+		if _, err := c.Tracks(key, "x"); err == nil {
+			t.Errorf("Tracks(%q) succeeded, want error", key)
+		}
+	}
+
+	// サインインが要るという失敗はそのまま返す (IPC が needs_auth にする)。
+	radio.err = playlist.ErrNeedsAuth
+	if _, err := c.Tracks("radio", "l:0"); !errors.Is(err, playlist.ErrNeedsAuth) {
+		t.Fatalf("err = %v, want ErrNeedsAuth", err)
+	}
+}
+
+func TestCatalogResolveURLUsesArgsForDirectStreams(t *testing.T) {
+	c, remote := newTestCatalog()
+	c.resolveArgs = func(args []string) (resolve.Result, error) {
+		return resolve.Result{Tracks: []playlist.Track{{Path: args[0], Stream: true}}}, nil
+	}
+	tracks, err := c.Tracks("url", "https://example.com/live.mp3")
+	if err != nil || len(tracks) != 1 || len(*remote) != 0 {
+		t.Fatalf("direct stream: tracks=%v err=%v remote=%v", tracks, err, *remote)
+	}
+}
+
+func TestCatalogPlaylists(t *testing.T) {
+	radio := &catalogTestProvider{name: "Radio", lists: []playlist.PlaylistInfo{{ID: "l:0", Name: "cliamp radio"}}}
+	c, _ := newTestCatalog(model.ProviderEntry{Key: "radio", Name: "Radio", Provider: radio})
+	lists, err := c.Playlists("radio")
+	if err != nil || len(lists) != 1 {
+		t.Fatalf("Playlists(radio) = %v, %v", lists, err)
+	}
+	for _, key := range []string{"youtube", "url", "nosuch"} {
+		if _, err := c.Playlists(key); err == nil {
+			t.Errorf("Playlists(%q) succeeded, want error", key)
+		}
+	}
+}
+
+func TestCatalogLyrics(t *testing.T) {
+	c, _ := newTestCatalog()
+	c.fetchLyrics = func(artist, title string) ([]lyrics.Line, error) {
+		return []lyrics.Line{{Start: 0, Text: "intro"}, {Start: 12500 * time.Millisecond, Text: "歌詞"}}, nil
+	}
+	lines, synced, err := c.Lyrics("a", "t")
+	if err != nil || !synced || len(lines) != 2 || lines[1].T != 12.5 || lines[1].Text != "歌詞" {
+		t.Fatalf("Lyrics = %v, %v, %v", lines, synced, err)
+	}
+
+	c.fetchLyrics = func(string, string) ([]lyrics.Line, error) {
+		return []lyrics.Line{{Text: "plain"}}, nil
+	}
+	if _, synced, _ := c.Lyrics("a", "t"); synced {
+		t.Fatal("plain lyrics reported as synced")
+	}
+
+	c.fetchLyrics = func(string, string) ([]lyrics.Line, error) { return nil, lyrics.ErrNotFound }
+	if _, _, err := c.Lyrics("a", "t"); !errors.Is(err, ipc.ErrNotFound) {
+		t.Fatalf("err = %v, want ipc.ErrNotFound", err)
+	}
+	c.fetchLyrics = func(string, string) ([]lyrics.Line, error) { return nil, errors.New("network down") }
+	if _, _, err := c.Lyrics("a", "t"); err == nil || errors.Is(err, ipc.ErrNotFound) {
+		t.Fatalf("err = %v, want the network error", err)
+	}
+}
+
+func TestCatalogHistory(t *testing.T) {
+	c, _ := newTestCatalog()
+	if got, err := c.History(10); err != nil || got != nil {
+		t.Fatalf("History without a store = %v, %v", got, err)
+	}
+
+	c.history = history.NewAt(filepath.Join(t.TempDir(), "history.toml"))
+	old := time.Date(2026, 9, 25, 10, 0, 0, 0, time.UTC)
+	_ = c.history.Record(playlist.Track{Path: "/a.flac", Title: "A", DurationSecs: 100}, old)
+	_ = c.history.Record(playlist.Track{Path: "/b.flac", Title: "B"}, old.Add(time.Hour))
+
+	got, err := c.History(10)
+	if err != nil || len(got) != 2 {
+		t.Fatalf("History = %v, %v", got, err)
+	}
+	if got[0].Title != "B" || got[0].PlayedAt != "2026-09-25T11:00:00Z" || got[1].Duration != 100 {
+		t.Fatalf("History = %+v", got)
+	}
+	if got, _ := c.History(1); len(got) != 1 {
+		t.Fatalf("History(1) returned %d entries", len(got))
+	}
+}
+
+func TestCatalogLocalPlaylistEdits(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	c, _ := newTestCatalog()
+	if err := c.PlaylistAdd("x", []playlist.Track{{Path: "/a"}}); err == nil {
+		t.Fatal("PlaylistAdd without a local provider succeeded")
+	}
+
+	c.local = local.New()
+	tracks := []playlist.Track{
+		{Path: "https://www.youtube.com/watch?v=1", Title: "One", Artist: "A", DurationSecs: 61},
+		{Path: "/music/two.flac", Title: "Two"},
+	}
+	if err := c.PlaylistAdd("朝の曲", tracks); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PlaylistAdd("朝の曲", tracks[:1]); err != nil {
+		t.Fatal(err)
+	}
+	got, err := c.local.Tracks("朝の曲")
+	if err != nil || len(got) != 3 || got[0].Title != "One" || got[0].DurationSecs != 61 {
+		t.Fatalf("saved tracks = %+v, %v", got, err)
+	}
+	if err := c.PlaylistRemoveTrack("朝の曲", 1); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := c.local.Tracks("朝の曲"); len(got) != 2 || got[1].Title != "One" {
+		t.Fatalf("after remove = %+v", got)
+	}
+	if err := c.PlaylistRemoveTrack("朝の曲", 5); err == nil {
+		t.Fatal("out of range remove succeeded")
+	}
+	if err := c.PlaylistAdd("../escape", tracks); err == nil {
+		t.Fatal("path traversal accepted")
+	}
+	if err := c.PlaylistAdd(history.PlaylistName, tracks); err == nil {
+		t.Fatal("writing to Recently Played accepted")
+	}
+	if err := c.PlaylistDelete("朝の曲"); err != nil {
+		t.Fatal(err)
+	}
+	if c.local.Exists("朝の曲") {
+		t.Fatal("playlist still exists after delete")
+	}
+	if err := c.PlaylistDelete("朝の曲"); err == nil {
+		t.Fatal("deleting a missing playlist succeeded")
+	}
+}
+
+func TestInstallGUIIPC(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "cliamp.sock")
+	srv, err := ipc.NewServer(sock, ipc.DispatcherFunc(func(any) {}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer srv.Close()
+	c, _ := newTestCatalog()
+	installGUIIPC(srv, c)
+
+	resp, err := ipc.Send(sock, ipc.Request{Cmd: "capabilities"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Contains(resp.Commands, "providers") || !slices.Equal(resp.EQPresets, model.EQPresetNames()) {
+		t.Fatalf("capabilities = %+v", resp)
+	}
+	resp, err = ipc.Send(sock, ipc.Request{Cmd: "providers"})
+	if err != nil || !resp.OK || len(resp.Providers) != 1 || resp.Providers[0].Key != "youtube" {
+		t.Fatalf("providers = %+v, %v", resp, err)
+	}
+}
