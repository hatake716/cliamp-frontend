+	}
+	m.playlist.Replace([]playlist.Track{tr})
+	m.setListSource(ipc.SourceInfo{Provider: "youtube", Name: "検索"})
+	m.streamTitle = "ICY - Title"
+	m.buffering = true
+
+	m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.StatusRequestMsg{Reply: r} })
+	if resp.API != ipc.APIVersion || resp.Gen != m.playlist.Gen() || resp.StreamTitle != "ICY - Title" {
+		t.Fatalf("status = %+v", resp)
+	}
+	if resp.Track == nil || resp.Track.Title != "Song" || resp.Track.Album != "Album" || resp.Track.Duration != 200 || resp.Track.Meta["art"] == "" {
+		t.Fatalf("track = %+v", resp.Track)
+	}
+	if len(resp.EQ) != 10 || resp.EQ[9] != 10 {
+		t.Fatalf("eq = %v", resp.EQ)
+	}
+	if resp.Buffering == nil || !*resp.Buffering {
+		t.Fatalf("buffering = %v", resp.Buffering)
+	}
+	if resp.Source == nil || resp.Source.Name != "検索" {
+		t.Fatalf("source = %v", resp.Source)
+	}
+	// 既存のフィールドはそのまま (平文の `cliamp status` が使う)。
+	if resp.State != "stopped" || resp.Total != 1 || resp.Shuffle == nil || resp.Repeat != "Off" {
+		t.Fatalf("base fields = %+v", resp)
+	}
+
+	// yt-dlp のシーク待ちの間はシーク先を返す。
+	eng.position = 5 * time.Second
+	m.seek.active = true
+	m.seek.targetPos = 90 * time.Second
+	_, resp = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.StatusRequestMsg{Reply: r} })
+	if resp.Position != 90 {
+		t.Fatalf("position during seek = %v, want 90", resp.Position)
+	}
+}
