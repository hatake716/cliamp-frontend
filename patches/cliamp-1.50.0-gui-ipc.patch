+func newGUITestModel(tracks ...string) (Model, *guiFakeEngine) {
+	eng := &guiFakeEngine{}
+	pl := playlist.New()
+	if len(tracks) > 0 {
+		pl.Replace(newGUITestTracks(tracks...))
+	}
+	m := Model{
+		player:   eng,
+		playlist: pl,
+		vis:      ui.NewVisualizer(float64(eng.SampleRate())),
+		themeIdx: -1,
+	}
+	return m, eng
+}
