+//go:build !windows
+
+package spotify
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/ap"
+	"github.com/devgianlu/go-librespot/login5"
+	pb "github.com/devgianlu/go-librespot/proto/spotify"
+	login5pb "github.com/devgianlu/go-librespot/proto/spotify/login5/v3"
+	"github.com/devgianlu/go-librespot/session"
+	"golang.org/x/oauth2"
+
+	"cliamp/playlist"
+)
+
+// librespot's errors as session.NewSessionFromOptions wraps them.
+func login5Err(code login5pb.LoginError) error {
+	return fmt.Errorf("failed authenticating with login5: %w", &login5.LoginError{Code: code})
+}
+
+func apErr(code pb.ErrorCode) error {
+	inner := fmt.Errorf("failed authenticating: %w", &ap.AccesspointLoginError{Message: &pb.APLoginFailed{ErrorCode: code.Enum()}})
+	return fmt.Errorf("failed authenticating accesspoint with username and spotify token: %w", inner)
+}
+
+func networkErr() error {
+	return fmt.Errorf("failed getting accesspoint from resolver: %w",
+		&url.Error{Op: "Get", URL: "https://apresolve.spotify.com/", Err: &net.OpError{Op: "dial", Net: "tcp", Err: errors.New("connect: network is unreachable")}})
+}
+
+func TestStreamingRejected(t *testing.T) {
+	tests := []struct {
+		name       string
+		err        error
+		want       bool
+		wantReason string
+	}{
+		{"nil", nil, false, ""},
+		{"login5 INVALID_CREDENTIALS (user's own client_id)", login5Err(login5pb.LoginError_INVALID_CREDENTIALS), true, "INVALID_CREDENTIALS"},
+		{"login5 UNKNOWN_IDENTIFIER", login5Err(login5pb.LoginError_UNKNOWN_IDENTIFIER), true, "UNKNOWN_IDENTIFIER"},
+		{"login5 bare error", &login5.LoginError{Code: login5pb.LoginError_INVALID_CREDENTIALS}, true, "INVALID_CREDENTIALS"},
+		{"access point PremiumAccountRequired", apErr(pb.ErrorCode_PremiumAccountRequired), true, "PremiumAccountRequired"},
+		{"access point BadCredentials", apErr(pb.ErrorCode_BadCredentials), true, "BadCredentials"},
+		{"login5 TRY_AGAIN_LATER", login5Err(login5pb.LoginError_TRY_AGAIN_LATER), false, ""},
+		{"login5 TOO_MANY_ATTEMPTS", login5Err(login5pb.LoginError_TOO_MANY_ATTEMPTS), false, ""},
+		{"login5 TIMEOUT", login5Err(login5pb.LoginError_TIMEOUT), false, ""},
+		{"login5 UNKNOWN_ERROR (empty reply)", login5Err(login5pb.LoginError_UNKNOWN_ERROR), false, ""},
+		{"access point TryAnotherAP", apErr(pb.ErrorCode_TryAnotherAP), false, ""},
+		{"access point error without message", &ap.AccesspointLoginError{}, false, ""},
+		{"network unreachable", networkErr(), false, ""},
+		{"client token failure", errors.New("failed obtaining client token: invalid status code from clienttoken: 503"), false, ""},
+		{"context deadline", fmt.Errorf("failed requesting login5 endpoint: %w", context.DeadlineExceeded), false, ""},
+		{"text mentioning INVALID_CREDENTIALS only", errors.New("proxy said INVALID_CREDENTIALS"), false, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			reason, got := streamingRejected(tt.err)
+			if got != tt.want {
+				t.Fatalf("streamingRejected(%v) = %v, want %v", tt.err, got, tt.want)
+			}
+			if !strings.Contains(reason, tt.wantReason) {
+				t.Errorf("reason = %q, want it to mention %q", reason, tt.wantReason)
+			}
+		})
+	}
+}
+
+// Spotify refuses librespot for the signed-in account: the session falls back
+// to web-only and persists that.
+func TestInteractiveSessionFallsBackToWebOnly(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+	}{
+		{"login5 INVALID_CREDENTIALS", login5Err(login5pb.LoginError_INVALID_CREDENTIALS)},
+		{"access point PremiumAccountRequired", apErr(pb.ErrorCode_PremiumAccountRequired)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			isolate(t)
+			signIns := setAuthorize(t, signInToken())
+			calls := setBackend(t, func(any) (streamBackend, error) { return nil, tt.err })
+
+			s, err := NewSession(context.Background(), "cid")
+			if err != nil {
+				t.Fatalf("NewSession: %v", err)
+			}
+			defer s.Close()
+			if !s.WebOnly() {
+				t.Fatal("session is not web-only")
+			}
+			if *signIns != 1 || len(*calls) != 1 {
+				t.Fatalf("sign-ins = %d, librespot attempts = %d, want 1 and 1", *signIns, len(*calls))
+			}
+			if c, ok := (*calls)[0].creds.(session.SpotifyTokenCredentials); !ok || c.Token != "at-signin" {
+				t.Fatalf("librespot was given %#v, want the sign-in token", (*calls)[0].creds)
+			}
+
+			// The token is kept for the Web API.
+			tok, err := s.tokenSource.Token()
+			if err != nil || tok.AccessToken != "at-signin" {
+				t.Fatalf("token = %v, %v", tok, err)
+			}
+
+			got := readCredsFile(t)
+			if got["web_only"] != true || got["refresh_token"] != "rt-signin" || got["username"] != "" || got["data"] != nil {
+				t.Fatalf("stored credentials = %v", got)
+			}
+			if id, _ := got["device_id"].(string); id != (*calls)[0].devID || len(id) != 40 {
+				t.Fatalf("device_id = %q, want the one librespot was given (%q)", id, (*calls)[0].devID)
+			}
+
+			// Streaming is unavailable, with the documented text.
+			_, err = s.NewStream(context.Background(), librespot.SpotifyId{}, 320)
+			if !errors.Is(err, ErrStreamingUnavailable) || !strings.Contains(err.Error(), "spotify: streaming unavailable") {
+				t.Fatalf("NewStream err = %v", err)
+			}
+		})
+	}
+}
+
+// Anything that is not a rejection fails exactly as before: no fallback and
+// nothing saved.
+func TestInteractiveSessionNoFallbackOnTransientErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+	}{
+		{"network unreachable", networkErr()},
+		{"context deadline", fmt.Errorf("failed requesting login5 endpoint: %w", context.DeadlineExceeded)},
+		{"login5 TRY_AGAIN_LATER", login5Err(login5pb.LoginError_TRY_AGAIN_LATER)},
+		{"access point TryAnotherAP", apErr(pb.ErrorCode_TryAnotherAP)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			isolate(t)
+			setAuthorize(t, signInToken())
+			setBackend(t, func(any) (streamBackend, error) { return nil, tt.err })
+
+			s, err := NewSession(context.Background(), "cid")
+			if err == nil {
+				s.Close()
+				t.Fatal("NewSession succeeded, want the librespot error")
+			}
+			if !errors.Is(err, errors.Unwrap(tt.err)) && !strings.Contains(err.Error(), tt.err.Error()) {
+				t.Fatalf("err = %v, want it to wrap %v", err, tt.err)
+			}
+			if !strings.HasPrefix(err.Error(), "spotify: session from token: ") {
+				t.Fatalf("err = %q, want the existing 'spotify: session from token:' error", err)
+			}
+			if got := readCredsFile(t); got != nil {
+				t.Fatalf("credentials were saved: %v", got)
+			}
+		})
+	}
+}
+
+// A Premium account keeps today's behaviour and file format.
+func TestPremiumInteractiveSessionUnchanged(t *testing.T) {
+	isolate(t)
+	setAuthorize(t, signInToken())
+	backend := &fakeBackend{username: "premiumuser", data: []byte("blob")}
+	setBackend(t, func(any) (streamBackend, error) { return backend, nil })
+
+	s, err := NewSession(context.Background(), "cid")
+	if err != nil {
+		t.Fatalf("NewSession: %v", err)
+	}
+	if s.WebOnly() || s.UserID() != "" {
+		t.Fatalf("premium session: webOnly=%v userID=%q", s.WebOnly(), s.UserID())
+	}
+	got := readCredsFile(t)
+	keys := make([]string, 0, len(got))
+	for k := range got {
+		keys = append(keys, k)
+	}
+	slices.Sort(keys)
+	if want := []string{"data", "device_id", "refresh_token", "username"}; !slices.Equal(keys, want) {
+		t.Fatalf("stored keys = %v, want %v (no web-only fields)", keys, want)
+	}
+	if got["username"] != "premiumuser" || got["data"] != "YmxvYg==" || got["refresh_token"] != "rt-signin" {
+		t.Fatalf("stored credentials = %v", got)
+	}
+
+	// Streams go to librespot.
+	sentinel := errors.New("librespot stream")
+	backend.streamFn = func(librespot.SpotifyId) error { return sentinel }
+	if _, err := s.NewStream(context.Background(), librespot.SpotifyId{}, 320); !errors.Is(err, sentinel) {
+		t.Fatalf("NewStream err = %v, want the backend's", err)
+	}
+	s.Close()
+	if !backend.closed {
+		t.Fatal("Close did not close the librespot backend")
+	}
+	if _, err := s.NewStream(context.Background(), librespot.SpotifyId{}, 320); err == nil || errors.Is(err, ErrStreamingUnavailable) {
+		t.Fatalf("NewStream after Close = %v, want 'session closed'", err)
+	}
+}
+
+// Stored web-only credentials come back without a browser and without
+// librespot, in both NewSessionSilent and NewSession.
+func TestWebOnlyRestoredSilently(t *testing.T) {
+	for _, build := range []struct {
+		name string
+		fn   func(context.Context, string) (*Session, error)
+	}{
+		{"NewSessionSilent", NewSessionSilent},
+		{"NewSession", NewSession},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			f := isolate(t)
+			f.refreshes(map[string][2]string{"rt-old": {"at-new", "rt-rotated"}})
+			writeCredsFile(t, `{"username":"","data":null,"device_id":"00112233445566778899aabbccddeeff00112233","refresh_token":"rt-old","web_only":true,"user_id":"u1"}`)
+
+			s, err := build.fn(context.Background(), "cid")
+			if err != nil {
+				t.Fatalf("%s: %v", build.name, err)
+			}
+			defer s.Close()
+			if !s.WebOnly() || s.UserID() != "u1" {
+				t.Fatalf("restored session: webOnly=%v userID=%q", s.WebOnly(), s.UserID())
+			}
+			tok, err := s.tokenSource.Token()
+			if err != nil || tok.AccessToken != "at-new" {
+				t.Fatalf("token = %v, %v", tok, err)
+			}
+			got := readCredsFile(t)
+			if got["web_only"] != true || got["refresh_token"] != "rt-rotated" || got["user_id"] != "u1" ||
+				got["device_id"] != "00112233445566778899aabbccddeeff00112233" {
+				t.Fatalf("stored credentials = %v", got)
+			}
+		})
+	}
+}
+
+// A refresh token Spotify rotates later in the session is written back, so
+// the next launch still restores silently.
+func TestWebOnlyPersistsRotatedRefreshToken(t *testing.T) {
+	f := isolate(t)
+	f.refreshes(map[string][2]string{"rt-1": {"at-1", "rt-2"}, "rt-2": {"at-2", "rt-3"}})
+	writeCredsFile(t, `{"refresh_token":"rt-1","web_only":true}`)
+
+	s, err := NewSessionSilent(context.Background(), "cid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if got := readCredsFile(t)["refresh_token"]; got != "rt-2" {
+		t.Fatalf("refresh token after restore = %v, want rt-2", got)
+	}
+	// Force the token source to refresh (as it does when the hour is up).
+	ts := s.tokenSource.(*savingTokenSource)
+	ts.src = spotifyOAuthConfig("cid").TokenSource(context.Background(), &oauth2.Token{RefreshToken: "rt-2"})
+	if tok, err := s.tokenSource.Token(); err != nil || tok.AccessToken != "at-2" {
+		t.Fatalf("token = %v, %v", tok, err)
+	}
+	if got := readCredsFile(t)["refresh_token"]; got != "rt-3" {
+		t.Fatalf("refresh token after rotation = %v, want rt-3", got)
+	}
+}
