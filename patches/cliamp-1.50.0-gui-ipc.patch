+// IPC で 1 帯域だけ変えたら、TUI の EQ キーと同じくプリセットは Custom になる。
+// 前のプリセット名のまま保存すると、次の起動でそのプリセットが当て直され、
+// 手で変えた帯域が消えるため。
+func TestGUIEQBandSwitchesPresetToCustom(t *testing.T) {
+	m, _ := newGUITestModel("a")
+	saver := recordingSaver{}
+	m.configSaver = saver
+	m.SetEQPreset("Rock", nil)
+	if got := m.EQPresetName(); got != "Rock" {
+		t.Fatalf("preset = %q, want Rock", got)
+	}
+	m, resp := sendGUI(t, m, func(reply chan ipc.Response) tea.Msg {
+		return ipc.EQMsg{Band: 3, Value: 2.5, Reply: reply}
+	})
+	if !resp.OK || resp.EQPreset != "Custom" {
+		t.Fatalf("reply = %+v, want ok with preset Custom", resp)
+	}
+	if got := m.EQPresetName(); got != "Custom" {
+		t.Fatalf("preset after band edit = %q, want Custom", got)
+	}
+	if got := saver["eq_preset"]; got != `"Custom"` {
+		t.Fatalf("saved eq_preset = %q, want \"Custom\"", got)
+	}
+}
