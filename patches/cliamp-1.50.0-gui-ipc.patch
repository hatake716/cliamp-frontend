diff --git a/daemon_gui.go b/daemon_gui.go
new file mode 100644
index 0000000..83b83ef
--- /dev/null
+++ b/daemon_gui.go
@@ -0,0 +1,316 @@
+package main
+
+// daemon_gui.go — GUI 向け拡張 IPC (ipc/gui.go) の状態系コマンドを daemon
+// (--daemon) で処理する。TUI 側 (ui/model/ipc_gui.go) と同じ意味にしてある。
+//
+// どれも daemon.Send から d.mu を持った状態で呼ばれる。playTrack は再生の
+// 準備の間だけ d.mu を手放すので、答えは再生を始める前に返す (IPC 側は
+// Send を別の goroutine で呼び、答えが入った時点で返す。ipc/gui.go の
+// sendAndWait)。daemon には gapless の先読みが無いので、先読みのやり直しは
+// 要らない。
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"cliamp/applog"
+	"cliamp/ipc"
+	"cliamp/player"
+	"cliamp/playlist"
+)
+
+// handleGUI は拡張 IPC のメッセージを処理する。知らないメッセージは捨てる
+// (既存の Send と同じ)。
+func (d *daemon) handleGUI(msg any) {
+	switch m := msg.(type) {
+	case ipc.PlaylistRequestMsg:
+		resp := ipc.PlaylistSnapshot(d.playlist, m.Limit)
+		resp.Source = d.listSource()
+		ipc.SendReply(m.Reply, resp)
+	case ipc.PlayIndexMsg:
+		d.guiPlayIndex(m)
+	case ipc.ReplaceMsg:
+		d.guiReplace(m)
+	case ipc.EnqueueMsg:
+		d.guiEnqueue(m)
+	case ipc.QueueEditMsg:
+		d.guiQueueEdit(m)
+	case ipc.RemoveMsg:
+		d.guiRemove(m)
+	}
+}
+
+// extendStatus は status の応答に拡張のフィールドを足す。
+func (d *daemon) extendStatus(resp *ipc.Response) {
+	resp.API = ipc.APIVersion
+	if cur, idx := d.playlist.Current(); idx >= 0 && cur.Path != "" {
+		ti := ipc.NewTrackInfo(cur)
+		resp.Track = &ti
+	}
+	bands := d.player.EQBands()
+	resp.EQ = bands[:]
+	resp.Gen = d.playlist.Gen()
+	resp.Source = d.listSource()
+	resp.StreamTitle = d.player.StreamTitle()
+	buffering := d.buffering
+	resp.Buffering = &buffering
+	// シークの間は、TUI と同じくシーク先を返す (生の位置は古い値のまま)。
+	if d.seeking && d.player.IsPlaying() {
+		resp.Position = d.seekTarget.Seconds()
+	}
+	if cur, idx := d.playlist.Current(); idx >= 0 {
+		resp.PlaybackError = d.playFail.Text(cur.Path)
+	}
+}
+
+func (d *daemon) setListSource(src ipc.SourceInfo) {
+	d.source = src
+	d.sourceEpoch = d.playlist.Epoch()
+}
+
+func (d *daemon) listSource() *ipc.SourceInfo {
+	if d.sourceEpoch != d.playlist.Epoch() || d.source == (ipc.SourceInfo{}) {
+		return nil
+	}
+	src := d.source
+	return &src
+}
+
+// beginPlay は playTrack の開始ごとに呼ぶ (d.mu を持った状態で)。
+// 読み込み待ちを立て、前の曲のシークと前の開始の失敗を取り消し、この開始の
+// 番号を返す。
+func (d *daemon) beginPlay(path string) uint64 {
+	d.playSeq++
+	d.playFail.Begin(path)
+	d.buffering = true
+	d.seeking = false
+	d.seekSeq++ // 待っている seek_to は前の曲のもの
+	return d.playSeq
+}
+
+// cancelStart は止めたとき (stop) に呼ぶ。準備中の開始を古いものにし
+// (終わっても buffering に触らない)、読み込み待ちと待っているシークを下ろす。
+func (d *daemon) cancelStart() {
+	d.playSeq++
+	d.buffering = false
+	d.seeking = false
+	d.seekSeq++
+}
+
+// finishPlay は playTrack の開始が終わったときに呼ぶ (d.mu を持った状態で)。
+// 後から別の開始があればそちらに任せる (読み込み待ちもそちらが下ろす)。
+// 開始の途中で Stop されたとき (player.ErrSuperseded) は失敗として記録しない。
+// ただしそのとき鳴っているなら、後から始まった古い開始が勝っているので、
+// もう一度始める (true を返す)。
+func (d *daemon) finishPlay(seq uint64, track playlist.Track, err error, retry int) bool {
+	if seq != d.playSeq {
+		return false
+	}
+	if errors.Is(err, player.ErrSuperseded) {
+		if d.player.IsPlaying() && retry < 2 {
+			return true
+		}
+		err = nil
+	}
+	d.buffering = false
+	if err != nil {
+		applog.Warn("daemon: play %q: %v", track.Path, err)
+		d.playFail.Fail(err)
+	}
+	return false
+}
+
+// seekState は daemon の seek_to の進行。
+type seekState struct {
+	seekMu     sync.Mutex    // シークを 1 本ずつにする (d.mu とは別。d.mu より先に取る)
+	seeking    bool          // シークを待っている間 (status はシーク先を返す)
+	seekTarget time.Duration // 最後に頼まれたシーク先
+	seekSeq    uint64        // seek_to と playTrack のたびに増える
+}
+
+// seekTo は絶対位置へシークする (seek_to)。yt-dlp の曲は組み直しに数秒
+// かかるので、別の goroutine で行い、すぐ戻る (IPC の答えと status を
+// 待たせない)。シークは 1 本ずつ行い、待っている間に新しい seek_to が
+// 来たら古いものは行わない (HTTP の流れでは先に終わった方が勝つため、
+// 並べて走らせると古いシーク先に戻りうる)。yt-dlp の組み立て中のシークは
+// CancelSeekYTDL で捨てる。
+func (d *daemon) seekTo(target time.Duration) {
+	if !d.player.IsPlaying() {
+		return
+	}
+	target = max(target, 0)
+	if dur := d.player.Duration(); dur > 0 && target >= dur {
+		target = max(dur-time.Second, 0)
+	}
+	d.seekSeq++
+	d.seeking = true
+	d.seekTarget = target
+	d.player.CancelSeekYTDL()
+	go d.runSeek(d.seekSeq, target)
+}
+
+func (d *daemon) runSeek(seq uint64, target time.Duration) {
+	d.seekMu.Lock()
+	defer d.seekMu.Unlock()
+	d.mu.Lock()
+	current := seq == d.seekSeq
+	d.mu.Unlock()
+	if !current {
+		return // 新しい seek_to か別の曲の開始があった
+	}
+	err := d.player.Seek(target - d.player.Position())
+	d.mu.Lock()
+	if seq == d.seekSeq {
+		d.seeking = false
+		// yt-dlp の曲のシークは yt-dlp を起こし直すので、失敗すると音が止まった
+		// ままになる (HTTP の流れは前の流れに戻る)。TUI と同じく再生の失敗とし、
+		// 後のシークが成功すれば消す。
+		if d.player.IsYTDLSeek() {
+			if err != nil {
+				d.playFail.FailSeek(err)
+			} else {
+				d.playFail.SeekOK()
+			}
+		}
+	}
+	d.mu.Unlock()
+	if err != nil {
+		applog.Warn("daemon: seek to %s: %v", target, err)
+	}
+}
+
+// playSelected は選ばれた行から、再生できる曲を探して鳴らす (TUI の
+// playCurrentTrack と同じく再生できない曲は飛ばす)。
+func (d *daemon) playSelected() {
+	act, ok := d.playlist.ActivateSelected()
+	if !ok {
+		d.player.Stop()
+		return
+	}
+	d.playTrack(act.Track)
+}
+
+func (d *daemon) idle() bool {
+	return !d.player.IsPlaying() && !d.buffering
+}
+
+// staleIndex は ui/model/ipc_gui.go の同名の関数と同じ。
+func (d *daemon) staleIndex(index int, path string) bool {
+	return ipc.PathMismatch(d.playlist.Tracks()[index].Path, path)
+}
+
+func (d *daemon) guiPlayIndex(m ipc.PlayIndexMsg) {
+	if m.Index < 0 || m.Index >= d.playlist.Len() {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return
+	}
+	if d.staleIndex(m.Index, m.Path) {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+		return
+	}
+	d.playlist.SetIndex(m.Index)
+	ipc.SendReply(m.Reply, ipc.Response{OK: true})
+	d.playSelected()
+}
+
+func (d *daemon) guiReplace(m ipc.ReplaceMsg) {
+	if len(m.Tracks) == 0 || m.Index < 0 || m.Index >= len(m.Tracks) {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return
+	}
+	d.player.Stop()
+	d.player.ClearPreload()
+	d.playlist.Replace(m.Tracks)
+	d.playlist.StartAt(m.Index)
+	d.setListSource(m.Source)
+	ipc.SendReply(m.Reply, ipc.Response{OK: true, Total: d.playlist.Len(), Gen: d.playlist.Gen()})
+	d.playSelected()
+}
+
+func (d *daemon) guiEnqueue(m ipc.EnqueueMsg) {
+	if len(m.Tracks) == 0 {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "enqueue requires tracks"})
+		return
+	}
+	idle := d.idle()
+	mode := m.Mode
+	if mode == "next" && d.playlist.Len() == 0 {
+		mode = "end" // 理由は ui/model/ipc_gui.go の guiEnqueue
+	}
+	play := false
+	switch mode {
+	case "now":
+		d.player.Stop()
+		d.playlist.AddNow(m.Tracks...)
+		play = true
+	case "end":
+		if idle {
+			d.playlist.AddAndSelect(m.Tracks...)
+			play = true
+		} else {
+			d.playlist.Add(m.Tracks...)
+		}
+	default: // "next"
+		d.playlist.PlayNext(m.Tracks...)
+	}
+	ipc.SendReply(m.Reply, ipc.Response{OK: true, Total: d.playlist.Len(), Gen: d.playlist.Gen()})
+	switch {
+	case play:
+		d.playSelected()
+	case mode == "next" && idle:
+		d.nextTrack()
+	}
+}
+
+func (d *daemon) guiQueueEdit(m ipc.QueueEditMsg) {
+	switch m.Mode {
+	case "add", "remove":
+		if m.Index < 0 || m.Index >= d.playlist.Len() {
+			ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "index out of range"})
+			return
+		}
+		if d.staleIndex(m.Index, m.Path) {
+			ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+			return
+		}
+		if m.Mode == "remove" {
+			d.playlist.Dequeue(m.Index)
+		} else if d.playlist.QueuePosition(m.Index) == 0 {
+			d.playlist.Queue(m.Index)
+		}
+	case "move":
+		if q := d.playlist.QueueIndices(); m.Index >= 0 && m.Index < len(q) && d.staleIndex(q[m.Index], m.Path) {
+			ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+			return
+		}
+		if !d.playlist.MoveQueueTo(m.Index, m.To) {
+			ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "queue position out of range"})
+			return
+		}
+	case "clear":
+		d.playlist.ClearQueue()
+	default:
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: fmt.Sprintf("queue_edit: unknown mode %q", m.Mode)})
+		return
+	}
+	ipc.SendReply(m.Reply, ipc.Response{OK: true, Queue: d.playlist.QueueIndices(), Gen: d.playlist.Gen()})
+}
+
+func (d *daemon) guiRemove(m ipc.RemoveMsg) {
+	if m.Index < 0 || m.Index >= d.playlist.Len() {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return
+	}
+	if d.staleIndex(m.Index, m.Path) {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+		return
+	}
+	if m.Index == d.playlist.Index() && !d.idle() {
+		ipc.SendReply(m.Reply, ipc.Response{OK: false, Error: "cannot remove the current track"})
+		return
+	}
+	d.playlist.Remove(m.Index)
+	ipc.SendReply(m.Reply, ipc.Response{OK: true, Total: d.playlist.Len(), Gen: d.playlist.Gen()})
+}
diff --git a/daemon_gui_test.go b/daemon_gui_test.go
new file mode 100644
index 0000000..9721e08
--- /dev/null
+++ b/daemon_gui_test.go
@@ -0,0 +1,385 @@
+package main
+
+// daemon (--daemon) の GUI 拡張 IPC の試験。プレイヤーは偽物 (音は出さない)。
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"cliamp/internal/playback"
+	"cliamp/ipc"
+	"cliamp/player"
+	"cliamp/playlist"
+)
+
+// daemonFakeEngine は player.Engine の偽物。IPC の goroutine とシークの
+// goroutine から呼ばれるので鍵で守る。block が nil でなければ、Play と
+// PlayYTDL はそれが閉じられるまで戻らない (yt-dlp の組み立てにあたる)。
+type daemonFakeEngine struct {
+	mu        sync.Mutex
+	playing   bool
+	plays     []string
+	playErrs  []error // Play/PlayYTDL が順に返す値 (尽きたら nil)
+	block     chan struct{}
+	stops     int
+	position  time.Duration
+	duration  time.Duration
+	seekDelay time.Duration
+	seekErr   error // Seek が返す値
+	seeks     int
+	cancels   int
+}
+
+func (f *daemonFakeEngine) start(path string) error {
+	f.mu.Lock()
+	block := f.block
+	f.plays = append(f.plays, path)
+	f.mu.Unlock()
+	if block != nil {
+		<-block
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	var err error
+	if len(f.playErrs) > 0 {
+		err, f.playErrs = f.playErrs[0], f.playErrs[1:]
+	}
+	if err == nil {
+		f.playing = true
+		f.position = 0
+	}
+	return err
+}
+
+func (f *daemonFakeEngine) Play(path string, _ time.Duration) error     { return f.start(path) }
+func (f *daemonFakeEngine) PlayYTDL(path string, _ time.Duration) error { return f.start(path) }
+func (f *daemonFakeEngine) Preload(string, time.Duration) error         { return nil }
+func (f *daemonFakeEngine) PreloadYTDL(string, time.Duration) error     { return nil }
+func (f *daemonFakeEngine) ClearPreload()                               {}
+func (f *daemonFakeEngine) Stop() {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.stops++
+	f.playing = false
+}
+func (f *daemonFakeEngine) Close()       {}
+func (f *daemonFakeEngine) TogglePause() {}
+func (f *daemonFakeEngine) Seek(d time.Duration) error {
+	f.mu.Lock()
+	delay := f.seekDelay
+	f.seeks++
+	f.mu.Unlock()
+	time.Sleep(delay)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.seekErr != nil {
+		return f.seekErr
+	}
+	f.position += d
+	return nil
+}
+func (f *daemonFakeEngine) SeekYTDL(d time.Duration) error { return f.Seek(d) }
+func (f *daemonFakeEngine) CancelSeekYTDL() {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.cancels++
+}
+func (f *daemonFakeEngine) IsPlaying() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.playing
+}
+func (f *daemonFakeEngine) IsPaused() bool        { return false }
+func (f *daemonFakeEngine) Drained() bool         { return false }
+func (f *daemonFakeEngine) HasPreload() bool      { return false }
+func (f *daemonFakeEngine) Seekable() bool        { return true }
+func (f *daemonFakeEngine) IsStreamSeek() bool    { return false }
+func (f *daemonFakeEngine) IsYTDLSeek() bool      { return true }
+func (f *daemonFakeEngine) GaplessAdvanced() bool { return false }
+func (f *daemonFakeEngine) Position() time.Duration {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.position
+}
+func (f *daemonFakeEngine) Duration() time.Duration {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.duration
+}
+func (f *daemonFakeEngine) PositionAndDuration() (time.Duration, time.Duration) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.position, f.duration
+}
+func (f *daemonFakeEngine) SetVolume(float64)                      {}
+func (f *daemonFakeEngine) Volume() float64                        { return 0 }
+func (f *daemonFakeEngine) SetSpeed(float64)                       {}
+func (f *daemonFakeEngine) Speed() float64                         { return 1 }
+func (f *daemonFakeEngine) ToggleMono()                            {}
+func (f *daemonFakeEngine) Mono() bool                             { return false }
+func (f *daemonFakeEngine) SetEQBand(int, float64)                 {}
+func (f *daemonFakeEngine) EQBands() [10]float64                   { return [10]float64{} }
+func (f *daemonFakeEngine) StreamErr() error                       { return nil }
+func (f *daemonFakeEngine) StreamTitle() string                    { return "" }
+func (f *daemonFakeEngine) StreamBytes() (downloaded, total int64) { return 0, 0 }
+func (f *daemonFakeEngine) SamplesInto([]float64) int              { return 0 }
+func (f *daemonFakeEngine) SampleRate() int                        { return 44100 }
+
+var _ player.Engine = (*daemonFakeEngine)(nil)
+
+func daemonTracks(names ...string) []playlist.Track {
+	out := make([]playlist.Track, len(names))
+	for i, n := range names {
+		out[i] = playlist.Track{Path: n + ".flac", Title: n}
+	}
+	return out
+}
+
+// newTestDaemon は names のリストで current の曲を鳴らしている daemon を作る
+// (current < 0 なら止まったまま)。
+func newTestDaemon(t *testing.T, current int, names ...string) (*daemon, *daemonFakeEngine) {
+	t.Helper()
+	eng := &daemonFakeEngine{duration: 10 * time.Minute}
+	d := &daemon{player: eng, playlist: playlist.New()}
+	d.playlist.Replace(daemonTracks(names...))
+	if current >= 0 {
+		d.playlist.SetIndex(current)
+		d.mu.Lock()
+		d.playCurrent()
+		d.mu.Unlock()
+	}
+	return d, eng
+}
+
+func daemonSend(d *daemon, build func(chan ipc.Response) any) ipc.Response {
+	reply := make(chan ipc.Response, 1)
+	d.Send(build(reply))
+	select {
+	case r := <-reply:
+		return r
+	default:
+		return ipc.Response{Error: "no reply"}
+	}
+}
+
+func daemonPlayed(pl *playlist.Playlist) []string {
+	var out []string
+	for range 100 {
+		t, ok := pl.Next()
+		if !ok {
+			break
+		}
+		out = append(out, t.Title)
+	}
+	return out
+}
+
+// daemon の「次に再生」も 1 度だけ鳴り、シャッフル中の now / 止まっているときの
+// end は、これから鳴る曲を飛ばさない (TUI と同じ playlist の関数を使う)。
+func TestDaemonEnqueueOrder(t *testing.T) {
+	d, _ := newTestDaemon(t, 0, "a", "b", "c")
+	resp := daemonSend(d, func(r chan ipc.Response) any {
+		return ipc.EnqueueMsg{Tracks: daemonTracks("X"), Mode: "next", Reply: r}
+	})
+	if !resp.OK || d.playlist.QueueLen() != 0 {
+		t.Fatalf("next = %+v queue=%v", resp, d.playlist.QueueIndices())
+	}
+	if got := daemonPlayed(d.playlist); !slices.Equal(got, []string{"X", "b", "c"}) {
+		t.Fatalf("played %v, want [X b c]", got)
+	}
+
+	names := []string{"t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7"}
+	for range 50 {
+		d, eng := newTestDaemon(t, -1, names...)
+		d.playlist.ToggleShuffle()
+		d.mu.Lock()
+		d.playCurrent()
+		d.mu.Unlock()
+		cur, _ := d.playlist.Current()
+		daemonSend(d, func(r chan ipc.Response) any {
+			return ipc.EnqueueMsg{Tracks: daemonTracks("X"), Mode: "now", Reply: r}
+		})
+		if last := eng.plays[len(eng.plays)-1]; last != "X.flac" {
+			t.Fatalf("now played %q", last)
+		}
+		got := daemonPlayed(d.playlist)
+		for _, n := range names {
+			if n != cur.Title && !slices.Contains(got, n) {
+				t.Fatalf("now skipped %s: %v", n, got)
+			}
+		}
+	}
+
+	for range 50 {
+		d, eng := newTestDaemon(t, 0, "a", "b", "c")
+		d.playlist.ToggleShuffle()
+		daemonPlayed(d.playlist)
+		eng.Stop()
+		added := []string{"x0", "x1", "x2", "x3", "x4"}
+		daemonSend(d, func(r chan ipc.Response) any {
+			return ipc.EnqueueMsg{Tracks: daemonTracks(added...), Mode: "end", Reply: r}
+		})
+		if last := eng.plays[len(eng.plays)-1]; last != "x0.flac" {
+			t.Fatalf("end when idle played %q", last)
+		}
+		got := daemonPlayed(d.playlist)
+		for _, n := range added[1:] {
+			if !slices.Contains(got, n) {
+				t.Fatalf("end when idle skipped %s: %v", n, got)
+			}
+		}
+	}
+}
+
+func TestDaemonIndexCommandsRejectStalePath(t *testing.T) {
+	d, eng := newTestDaemon(t, 0, "a", "b", "c")
+	daemonSend(d, func(r chan ipc.Response) any { return ipc.QueueEditMsg{Mode: "add", Index: 2, Reply: r} })
+	gen, plays := d.playlist.Gen(), len(eng.plays)
+	for _, build := range []func(chan ipc.Response) any{
+		func(r chan ipc.Response) any { return ipc.PlayIndexMsg{Index: 1, Path: "c.flac", Reply: r} },
+		func(r chan ipc.Response) any { return ipc.RemoveMsg{Index: 1, Path: "c.flac", Reply: r} },
+		func(r chan ipc.Response) any {
+			return ipc.QueueEditMsg{Mode: "remove", Index: 2, Path: "b.flac", Reply: r}
+		},
+		func(r chan ipc.Response) any {
+			return ipc.QueueEditMsg{Mode: "move", Index: 0, To: 0, Path: "b.flac", Reply: r}
+		},
+	} {
+		if resp := daemonSend(d, build); resp.OK || resp.Error != "stale" {
+			t.Fatalf("%T = %+v, want stale", build(nil), resp)
+		}
+	}
+	if d.playlist.Gen() != gen || len(eng.plays) != plays {
+		t.Fatal("a stale request changed the list")
+	}
+	if resp := daemonSend(d, func(r chan ipc.Response) any { return ipc.RemoveMsg{Index: 1, Path: "b.flac", Reply: r} }); !resp.OK {
+		t.Fatalf("remove with the right path = %+v", resp)
+	}
+}
+
+// seek_to はすぐ答え (yt-dlp の組み直しを待たない)、その間の status は
+// シーク先を返す。続けて来た seek_to は最後のシーク先に落ち着く。
+func TestDaemonSeekTo(t *testing.T) {
+	d, eng := newTestDaemon(t, 0, "a")
+	eng.mu.Lock()
+	eng.seekDelay = 300 * time.Millisecond
+	eng.mu.Unlock()
+
+	start := time.Now()
+	d.Send(playback.SetPositionMsg{Position: 100 * time.Second})
+	d.Send(playback.SetPositionMsg{Position: 200 * time.Second})
+	d.Send(playback.SetPositionMsg{Position: 300 * time.Second})
+	if took := time.Since(start); took > 250*time.Millisecond {
+		t.Fatalf("seek_to blocked Send for %v", took)
+	}
+	status := daemonSend(d, func(r chan ipc.Response) any { return ipc.StatusRequestMsg{Reply: r} })
+	if status.Position != 300 {
+		t.Fatalf("status position during the seek = %v, want 300", status.Position)
+	}
+	if eng.cancels < 3 {
+		t.Fatalf("CancelSeekYTDL called %d times, want once per seek_to", eng.cancels)
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		d.mu.Lock()
+		seeking := d.seeking
+		d.mu.Unlock()
+		if !seeking {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("seek never finished")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	d.seekMu.Lock() // 走っているシークが終わるまで待つ
+	d.seekMu.Unlock()
+	if got := eng.Position(); got != 300*time.Second {
+		t.Fatalf("final position = %v, want 300s (the last seek_to)", got)
+	}
+	eng.mu.Lock()
+	seeks := eng.seeks
+	eng.mu.Unlock()
+	if seeks > 2 {
+		t.Fatalf("%d seeks ran; queued seek_to requests should collapse into the latest", seeks)
+	}
+}
+
+// 読み込み中に止めたら (IPC の stop)、プレイヤーが返す ErrSuperseded で
+// 読み込み待ちを下ろす。鳴っていれば (後から始まった古い開始が勝った)
+// もう一度始める。
+func TestDaemonSupersededStart(t *testing.T) {
+	d, eng := newTestDaemon(t, -1, "a", "b")
+	eng.block = make(chan struct{})
+	eng.playErrs = []error{player.ErrSuperseded}
+	done := make(chan struct{})
+	go func() {
+		daemonSend(d, func(r chan ipc.Response) any { return ipc.PlayIndexMsg{Index: 0, Reply: r} })
+		close(done)
+	}()
+	waitFor(t, func() bool { d.mu.Lock(); defer d.mu.Unlock(); return d.buffering })
+	d.Send(playback.StopMsg{})
+	if status := daemonSend(d, func(r chan ipc.Response) any { return ipc.StatusRequestMsg{Reply: r} }); *status.Buffering {
+		t.Fatal("status still reports buffering right after stop")
+	}
+	close(eng.block)
+	<-done
+	d.mu.Lock()
+	buffering := d.buffering
+	d.mu.Unlock()
+	if buffering || len(eng.plays) != 1 {
+		t.Fatalf("after stop: buffering=%v plays=%v", buffering, eng.plays)
+	}
+
+	// 鳴っているのに最新の開始が ErrSuperseded: もう一度始める。
+	d, eng = newTestDaemon(t, 0, "a", "b")
+	eng.playErrs = []error{player.ErrSuperseded}
+	daemonSend(d, func(r chan ipc.Response) any { return ipc.PlayIndexMsg{Index: 1, Reply: r} })
+	if !slices.Equal(eng.plays, []string{"a.flac", "b.flac", "b.flac"}) || d.buffering {
+		t.Fatalf("plays = %v buffering=%v, want b restarted", eng.plays, d.buffering)
+	}
+}
+
+func waitFor(t *testing.T, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatal("condition not met")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// 本物の IPC サーバーを通した replace は、daemon が yt-dlp の準備をしている
+// 間も 3 秒以内に答え、その間の status は読み込み中を返す。
+func TestDaemonReplaceAnswersBeforePlaybackStarts(t *testing.T) {
+	home, err := os.MkdirTemp("", "dm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(home)
+	d, eng := newTestDaemon(t, -1, "a")
+	eng.block = make(chan struct{})
+	defer close(eng.block)
+	sock := filepath.Join(home, "c.sock")
+	srv, err := ipc.NewServerWith(sock, d, ipc.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer srv.Close()
+
+	start := time.Now()
+	resp, err := ipc.Send(sock, ipc.Request{Cmd: "replace", Tracks: []ipc.TrackInfo{{Path: "https://www.youtube.com/watch?v=x"}}})
+	if err != nil || !resp.OK || time.Since(start) > time.Second {
+		t.Fatalf("replace = %+v, %v after %v", resp, err, time.Since(start))
+	}
+	status, err := ipc.Send(sock, ipc.Request{Cmd: "status"})
+	if err != nil || status.Buffering == nil || !*status.Buffering {
+		t.Fatalf("status while starting = %+v, %v", status, err)
+	}
+}
