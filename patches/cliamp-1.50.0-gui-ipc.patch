+	}
+	p := New(nil, "cid", 320)
+	if err := p.ensureSession(); !errors.Is(err, playlist.ErrNeedsAuth) {
+		t.Fatalf("ensureSession = %v, want ErrNeedsAuth", err)
+	}
+	if got := readCredsFile(t); got["web_only"] != nil {
+		t.Fatalf("stored credentials became web-only: %v", got)
+	}
+}
