+// 待ち行列の曲が鳴っている間に、その前に鳴ったリストの曲を消しても、
+// 次の曲は飛ばされない。
+func TestRemovePastTrackWhileQueuedKeepsNext(t *testing.T) {
+	m, eng := newGUITestModel("a", "b", "c", "d")
+	startPlaying(&m, 0) // a
+	m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.QueueEditMsg{Mode: "add", Index: 3, Reply: r}
+	})
+	if !resp.OK {
+		t.Fatalf("queue add = %+v", resp)
+	}
+	m.nextTrack() // a が終わり、待ち行列の d
+	if cur, _ := m.playlist.Current(); cur.Title != "d" || !m.playlist.CurrentIsQueued() {
+		t.Fatalf("current = %q, want queued d", cur.Title)
+	}
+	m, resp = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.RemoveMsg{Index: 0, Path: "a.flac", Reply: r} })
+	if !resp.OK {
+		t.Fatalf("remove a = %+v", resp)
+	}
+	_, snap := sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.PlaylistRequestMsg{Reply: r} })
+	if !slices.Equal(snap.UpNext, []int{0, 1, 2}) { // b c d
+		t.Fatalf("up_next = %v, want [0 1 2] (b c d)", snap.UpNext)
+	}
+	m.nextTrack()
+	if last := eng.playCalls[len(eng.playCalls)-1]; last != "b.flac" {
+		t.Fatalf("after the queued d, played %q, want b.flac", last)
+	}
+}
