+func TestQuotaExceeded(t *testing.T) {
+	now := time.Date(2026, 9, 27, 12, 0, 0, 0, time.UTC)
+	h := func(ra string) http.Header {
+		hd := http.Header{}
+		if ra != "" {
+			hd.Set("Retry-After", ra)
+		}
+		return hd
+	}
+	tests := []struct {
+		reason, retryAfter string
+		want               string // "" → not a quota error
+	}{
+		{"QUOTA_EXCEEDED", "3600", "spotify: Spotify quota exceeded for this developer account; retry after 1h0m0s"},
+		{"quota_exceeded", "5", "spotify: Spotify quota exceeded for this developer account; retry after 5s"},
+		{"QUOTA_EXCEEDED", "", "spotify: Spotify quota exceeded for this developer account"},
+		{"QUOTA_EXCEEDED", "0", "spotify: Spotify quota exceeded for this developer account"},
+		{"QUOTA_EXCEEDED", "soon", "spotify: Spotify quota exceeded for this developer account"},
+		{"QUOTA_EXCEEDED", now.Add(90 * time.Minute).Format(http.TimeFormat), "spotify: Spotify quota exceeded for this developer account; retry after 1h30m0s"},
+		{"QUOTA_EXCEEDED", "99999999999999999999", "spotify: Spotify quota exceeded for this developer account; retry after 2562047h47m16.854775807s"},
+		{"", "3600", ""},
+		{"RATE_LIMITED", "3600", ""},
+	}
+	for _, tt := range tests {
+		err := quotaExceeded(tt.reason, h(tt.retryAfter), now)
+		got := ""
+		if err != nil {
+			got = err.Error()
+		}
+		if got != tt.want {
+			t.Errorf("quotaExceeded(%q, %q) = %q, want %q", tt.reason, tt.retryAfter, got, tt.want)
+		}
+	}
