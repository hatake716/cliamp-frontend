diff --git a/ui/model/ipc_gui.go b/ui/model/ipc_gui.go
new file mode 100644
index 0000000..4fc1cf9
--- /dev/null
+++ b/ui/model/ipc_gui.go
@@ -0,0 +1,355 @@
+package model
+
+// ipc_gui.go — GUI 向け拡張 IPC (ipc/gui.go) の状態系コマンドを TUI で処理する。
+//
+// どの処理も Update の goroutine で走るので、I/O はしない (再生の開始は既存の
+// playTrack と同じく tea.Cmd に回る)。答えは ipc.SendReply で必ず 1 回返す。
+// TUI の画面 (オーバーレイやフォーカス) は動かさない。Open-Voice が tmux で
+// キーを打ち込んでいるため、見えない所で画面が変わるとキーが別の所へ落ちる。
+
+import (
+	"fmt"
+
+	tea "charm.land/bubbletea/v2"
+
+	"cliamp/ipc"
+	"cliamp/playlist"
+)
+
+// EQPresetNames は組み込み EQ プリセットの名前を表示順に返す
+// (IPC の capabilities 用)。
+func EQPresetNames() []string {
+	names := make([]string, len(eqPresets))
+	for i, p := range eqPresets {
+		names[i] = p.Name
+	}
+	return names
+}
+
+// ResolveWrapperURLs はラジオの .m3u / .pls の中継 URL を実体の URL へ展開する。
+// TUI がプロバイダーのリストを読むときと同じ処理を IPC のカタログからも使う。
+// ネットワークを待つので Update の中では呼ばないこと。
+func ResolveWrapperURLs(tracks []playlist.Track) []playlist.Track {
+	return resolveWrapperURLs(tracks)
+}
+
+// handleGUIIPC は拡張 IPC のメッセージを処理する。知らないメッセージなら ok=false。
+func (m *Model) handleGUIIPC(msg tea.Msg) (tea.Cmd, bool) {
+	switch msg := msg.(type) {
+	case ipc.PlaylistRequestMsg:
+		resp := ipc.PlaylistSnapshot(m.playlist, msg.Limit)
+		resp.Source = m.listSource()
+		ipc.SendReply(msg.Reply, resp)
+		return nil, true
+	case ipc.PlayIndexMsg:
+		return m.guiPlayIndex(msg), true
+	case ipc.ReplaceMsg:
+		return m.guiReplace(msg), true
+	case ipc.EnqueueMsg:
+		return m.guiEnqueue(msg), true
+	case ipc.QueueEditMsg:
+		return m.guiQueueEdit(msg), true
+	case ipc.RemoveMsg:
+		return m.guiRemove(msg), true
+	}
+	return nil, false
+}
+
+// extendStatus は status の応答に拡張のフィールドを足す (既存のフィールドは
+// 平文の `cliamp status` がそのまま使うので、意味を変えない)。
+func (m *Model) extendStatus(resp *ipc.Response) {
+	resp.API = ipc.APIVersion
+	if cur, idx := m.playlist.Current(); idx >= 0 && cur.Path != "" {
+		ti := ipc.NewTrackInfo(cur)
+		resp.Track = &ti
+	}
+	// yt-dlp のシーク待ちの間は、TUI のつまみと同じくシーク先を返す
+	// (待ちの間の生の位置は古い値のままで、GUI のつまみが跳ね戻るため)。
+	if m.seek.active {
+		resp.Position = m.seek.targetPos.Seconds()
+	}
+	bands := m.player.EQBands()
+	resp.EQ = bands[:]
+	resp.Gen = m.playlist.Gen()
+	resp.Source = m.listSource()
+	resp.StreamTitle = m.streamTitle
+	buffering := m.buffering || m.feedLoading
+	resp.Buffering = &buffering
+}
+
+// setListSource はいまのリストの出どころを覚える。リストが別の経路で
+// 差し替わったら (playlist の Epoch が変わったら) 自然に無効になる。
+func (m *Model) setListSource(src ipc.SourceInfo) {
+	m.guiSource = src
+	m.guiSourceEpoch = m.playlist.Epoch()
+}
+
+// setLocalListSource はローカルのプレイリスト name を出どころとして覚える。
+func (m *Model) setLocalListSource(name string) {
+	m.setListSource(ipc.SourceInfo{Provider: "local", ID: name, Name: name})
+}
+
+// setProviderListSource は TUI のプロバイダー欄から読み込んだリストの出どころを覚える。
+func (m *Model) setProviderListSource() {
+	key := m.providerKey(m.provider)
+	id := m.activeProviderPlaylistID
+	if key == "" || id == "" {
+		m.setListSource(ipc.SourceInfo{})
+		return
+	}
+	src := ipc.SourceInfo{Provider: key, ID: id}
+	for _, pl := range m.providerLists {
+		if pl.ID == id {
+			src.Name = pl.Name
+			break
+		}
+	}
+	m.setListSource(src)
+}
+
+func (m *Model) listSource() *ipc.SourceInfo {
+	if m.guiSourceEpoch != m.playlist.Epoch() || m.guiSource == (ipc.SourceInfo{}) {
+		return nil
+	}
+	src := m.guiSource
+	return &src
+}
+
+// providerKey は登録されたプロバイダーの設定キー ("spotify" など) を返す。
+func (m *Model) providerKey(p playlist.Provider) string {
+	if p == nil {
+		return ""
+	}
+	for _, e := range m.providers {
+		if e.Provider == p {
+			return e.Key
+		}
+	}
+	return ""
+}
+
+// peekNextPath は次に鳴る曲の path を返す。先読みのやり直しが要るかの判定用。
+func (m *Model) peekNextPath() (string, bool) {
+	t, ok := m.playlist.PeekNext()
+	return t.Path, ok
+}
+
+// repreloadIfNextChanged は、リストや待ち行列の変更で次に鳴る曲が変わったとき
+// だけ gapless の先読みを捨てて取り直す。捨てないと、先読みした古い曲が鳴るのに
+// 表示は新しい曲へ進んでしまう。
+func (m *Model) repreloadIfNextChanged(beforePath string, beforeOK bool) tea.Cmd {
+	after, ok := m.peekNextPath()
+	if after == beforePath && ok == beforeOK {
+		return nil
+	}
+	m.player.ClearPreload()
+	if !m.player.IsPlaying() || m.buffering {
+		return nil
+	}
+	return m.preloadNext()
+}
+
+// refreshPlaylistViews は曲の添字が変わったあと、TUI 側で添字を握っている
+// 表示を合わせる。開いている検索欄の結果は添字の一覧なので、作り直さないと
+// 描画で範囲外を引いて落ちる。画面やフォーカスは変えない。
+func (m *Model) refreshPlaylistViews() {
+	if n := m.playlist.Len(); m.plCursor >= n {
+		m.plCursor = max(n-1, 0)
+	}
+	if m.search.active {
+		m.updateSearch()
+	}
+	if q := m.playlist.QueueLen(); m.queue.cursor >= q {
+		m.queue.cursor = max(q-1, 0)
+	}
+	m.adjustScroll()
+}
+
+// guiPlayIndex は TUI の「行で Enter」と同じ (keys.go の enter)。
+func (m *Model) guiPlayIndex(msg ipc.PlayIndexMsg) tea.Cmd {
+	if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return nil
+	}
+	if m.buffering && msg.Index == m.playlist.Index() {
+		// その曲をいま読み込んでいる。Enter と同じく何もしない。
+		ipc.SendReply(msg.Reply, ipc.Response{OK: true})
+		return nil
+	}
+	m.scrobbleCurrent()
+	m.playlist.SetIndex(msg.Index)
+	cmd := m.playCurrentTrack()
+	m.notifyPlayback()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true})
+	return cmd
+}
+
+// guiReplace はリストを差し替えて Index の曲から再生する。プレイリスト管理の
+// plMgrLoadAndPlay と同じ順 (Stop・ClearPreload を先に。残った先読みが新しい
+// リストで GaplessAdvanced を起こさないように)。画面は切り替えない。
+func (m *Model) guiReplace(msg ipc.ReplaceMsg) tea.Cmd {
+	if len(msg.Tracks) == 0 || msg.Index < 0 || msg.Index >= len(msg.Tracks) {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return nil
+	}
+	m.scrobbleCurrent()
+	m.player.Stop()
+	m.player.ClearPreload()
+	m.resetYTDLBatch()
+	m.playlist.Replace(msg.Tracks)
+	m.playlist.StartAt(msg.Index)
+	m.setInitialHeaderState(msg.Tracks)
+	m.setListSource(msg.Source)
+
+	// ブックマークの書き込み先と、プロバイダー欄の強調を合わせる。
+	m.loadedPlaylist = ""
+	if msg.Source.Provider == "local" {
+		m.loadedPlaylist = msg.Source.ID
+	}
+	m.activeProviderPlaylistID = ""
+	if msg.Source.Provider != "" && msg.Source.Provider == m.providerKey(m.provider) {
+		m.activeProviderPlaylistID = msg.Source.ID
+	}
+
+	m.plCursor = msg.Index
+	m.refreshPlaylistViews()
+	m.status.Showf(statusTTLDefault, "Loaded %d track(s)", len(msg.Tracks))
+	cmd := m.playCurrentTrack()
+	// YouTube のミックス (list=RD…) は最初の 20 曲だけなので、TUI で URL を
+	// 開いたときと同じく残りを裏で読み足す。
+	if msg.Source.Provider == "url" && msg.Source.ID != "" {
+		if batch := m.initYTDLBatch([]string{msg.Source.ID}); batch != nil {
+			cmd = tea.Batch(cmd, batch)
+		}
+	}
+	m.notifyAll()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Total: m.playlist.Len(), Gen: m.playlist.Gen()})
+	return cmd
+}
+
+// guiEnqueue は曲を足す。next は TUI の検索結果での q (queueTrackNext)、end は
+// a (appendTrack)、now は Enter (playTrackImmediate) にあたる。複数曲をまとめて
+// 扱うため、既存の 1 曲用の関数を繰り返し呼ばずに同じ手順を書いている
+// (繰り返すと、読み込み中に 2 曲目がまた再生を始めてしまう)。
+func (m *Model) guiEnqueue(msg ipc.EnqueueMsg) tea.Cmd {
+	if len(msg.Tracks) == 0 {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "enqueue requires tracks"})
+		return nil
+	}
+	idle := !m.player.IsPlaying() && !m.buffering
+	beforePath, beforeOK := m.peekNextPath()
+	start := m.playlist.Len()
+	m.playlist.Add(msg.Tracks...)
+	first := msg.Tracks[0]
+	mode := msg.Mode
+	if mode == "next" && start == 0 {
+		// 空のリストに「次に再生」: 待ち行列に入れると、待ち行列で 1 度、
+		// リストの順でもう 1 度鳴る。末尾に足して先頭から鳴らすのと同じにする。
+		mode = "end"
+	}
+
+	var cmd tea.Cmd
+	switch mode {
+	case "now":
+		m.scrobbleCurrent()
+		m.player.Stop()
+		m.player.ClearPreload()
+		// 2 曲目以降は、シャッフルでなければ再生順でそのまま 1 曲目に続く。
+		// 待ち行列にも入れると 2 度鳴るので、混ざるシャッフルのときだけ入れる。
+		if m.playlist.Shuffled() {
+			for i := 1; i < len(msg.Tracks); i++ {
+				m.playlist.Queue(start + i)
+			}
+		}
+		m.playlist.SetIndex(start)
+		m.plCursor = start
+		m.status.Showf(statusTTLMedium, "Playing: %s", first.DisplayName())
+		cmd = m.playCurrentTrack()
+		m.notifyPlayback()
+	case "end":
+		m.status.Showf(statusTTLMedium, "Added: %s", first.DisplayName())
+		if idle {
+			m.playlist.SetIndex(start)
+			m.plCursor = start
+			cmd = m.playCurrentTrack()
+			m.notifyPlayback()
+		} else {
+			cmd = m.repreloadIfNextChanged(beforePath, beforeOK)
+		}
+	default: // "next"
+		for i := range msg.Tracks {
+			m.playlist.Queue(start + i)
+		}
+		m.status.Showf(statusTTLMedium, "Queued: %s", first.DisplayName())
+		if idle {
+			cmd = m.nextTrack()
+			m.notifyPlayback()
+		} else {
+			cmd = m.repreloadIfNextChanged(beforePath, beforeOK)
+		}
+	}
+	m.refreshPlaylistViews()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Total: m.playlist.Len(), Gen: m.playlist.Gen()})
+	return cmd
+}
+
+// guiQueueEdit は「次に再生」の待ち行列を編集する (TUI の a と A の画面にあたる)。
+func (m *Model) guiQueueEdit(msg ipc.QueueEditMsg) tea.Cmd {
+	beforePath, beforeOK := m.peekNextPath()
+	switch msg.Mode {
+	case "add":
+		if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+			return nil
+		}
+		if m.playlist.QueuePosition(msg.Index) == 0 {
+			m.playlist.Queue(msg.Index)
+		}
+	case "remove":
+		if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+			return nil
+		}
+		m.playlist.Dequeue(msg.Index)
+	case "move":
+		if !m.playlist.MoveQueueTo(msg.Index, msg.To) {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "queue position out of range"})
+			return nil
+		}
+	case "clear":
+		m.playlist.ClearQueue()
+	default:
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: fmt.Sprintf("queue_edit: unknown mode %q", msg.Mode)})
+		return nil
+	}
+	m.refreshPlaylistViews()
+	cmd := m.repreloadIfNextChanged(beforePath, beforeOK)
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Queue: m.playlist.QueueIndices(), Gen: m.playlist.Gen()})
+	return cmd
+}
+
+// guiRemove はリストから 1 曲消す。再生中 (一時停止・読み込み中を含む) の曲は
+// 消さない。TUI の removeSelectedFromPlaylist は再生を止めてしまうが、GUI から
+// 誤って今の曲を消して音が途切れるのを避けるため。
+func (m *Model) guiRemove(msg ipc.RemoveMsg) tea.Cmd {
+	if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return nil
+	}
+	if msg.Index == m.playlist.Index() && (m.player.IsPlaying() || m.buffering) {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "cannot remove the current track"})
+		return nil
+	}
+	beforePath, beforeOK := m.peekNextPath()
+	track := m.playlist.Tracks()[msg.Index]
+	m.playlist.Remove(msg.Index)
+	if m.plCursor > msg.Index {
+		m.plCursor--
+	}
+	m.refreshPlaylistViews()
+	m.status.Showf(statusTTLDefault, "Removed: %s", track.DisplayName())
+	cmd := m.repreloadIfNextChanged(beforePath, beforeOK)
+	m.notifyPlayback()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Total: m.playlist.Len(), Gen: m.playlist.Gen()})
+	return cmd
+}
