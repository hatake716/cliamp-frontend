+func TestGUIQueueEdit(t *testing.T) {
+	m, eng := newGUITestModel("a", "b", "c", "d")
+	startPlaying(&m, 0)
+
+	edit := func(mode string, index, to int) ipc.Response {
+		var resp ipc.Response
+		m, resp = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+			return ipc.QueueEditMsg{Mode: mode, Index: index, To: to, Reply: r}
+		})
+		return resp
+	}
+	if resp := edit("add", 3, -1); !resp.OK || !slices.Equal(resp.Queue, []int{3}) {
+		t.Fatalf("add 3 = %+v", resp)
+	}
+	edit("add", 2, -1)
+	if resp := edit("add", 3, -1); !slices.Equal(resp.Queue, []int{3, 2}) {
+		t.Fatalf("adding twice = %v, want [3 2]", resp.Queue)
+	}
+	if resp := edit("move", 1, 0); !resp.OK || !slices.Equal(resp.Queue, []int{2, 3}) {
+		t.Fatalf("move = %+v", resp)
+	}
+	if next, _ := m.playlist.PeekNext(); next.Title != "c" {
+		t.Fatalf("next = %q, want c", next.Title)
+	}
+	if resp := edit("remove", 2, -1); !slices.Equal(resp.Queue, []int{3}) {
+		t.Fatalf("remove = %+v", resp)
+	}
+	clears := eng.clearPreloads
+	if resp := edit("clear", -1, -1); !resp.OK || len(resp.Queue) != 0 {
+		t.Fatalf("clear = %+v", resp)
+	}
+	if eng.clearPreloads <= clears {
+		t.Fatal("clearing the queue changed the next track but kept the preload")
+	}
+	for _, bad := range []struct {
+		mode      string
+		index, to int
+	}{{"add", 9, -1}, {"remove", -1, -1}, {"move", 0, 1}, {"shuffle", 0, 0}} {
+		if resp := edit(bad.mode, bad.index, bad.to); resp.OK {
+			t.Errorf("%+v = ok, want error", bad)
+		}
+	}
+}
