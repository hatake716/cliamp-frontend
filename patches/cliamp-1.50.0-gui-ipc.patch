+// The owner-Premium 403 keeps Spotify's text in every catalog call; tracks
+// still rewrites other 403s (a playlist the user cannot read).
+func TestOwnerPremiumRequiredPassesThrough(t *testing.T) {
+	const ownerPremium = `{"error":{"status":403,"message":"Active premium subscription required for the owner of the app"}}`
+	forbidden := func(body string) http.HandlerFunc {
+		return func(w http.ResponseWriter, _ *http.Request) {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusForbidden)
+			_, _ = io.WriteString(w, body)
+		}
+	}
+	f := isolate(t)
+	for _, key := range []string{"GET /v1/me", "GET /v1/me/tracks", "GET /v1/me/playlists", "GET /v1/playlists/pl1/items", "GET /v1/search", "POST /v1/me/playlists", "POST /v1/playlists/pl1/items"} {
+		f.handle(key, forbidden(ownerPremium))
+	}
+	f.handle("GET /v1/playlists/other/items", forbidden(`{"error":{"status":403,"message":"Forbidden"}}`))
+	p := testProvider(t, true)
+	ctx := context.Background()
+
+	_, errPlaylists := p.Playlists()
+	_, errTracks := p.Tracks("pl1")
+	_, errSearch := p.SearchTracks(ctx, "q", 20)
+	_, errCreate := p.CreatePlaylist(ctx, "x")
+	errAdd := p.AddTrackToPlaylist(ctx, "pl1", playlist.Track{Path: "spotify:track:abc"})
+	for name, err := range map[string]error{"playlists": errPlaylists, "tracks": errTracks, "search": errSearch, "create": errCreate, "add": errAdd} {
+		if err == nil || !strings.HasPrefix(err.Error(), "spotify: ") || !strings.HasSuffix(err.Error(), "http status 403 Forbidden: "+ownerPremium) {
+			t.Errorf("%s err = %v, want Spotify's owner-Premium reply", name, err)
+		}
+		if err != nil && !ownerPremiumRequired(err) {
+			t.Errorf("%s: ownerPremiumRequired(%v) = false", name, err)
+		}
+	}
+	_, err := p.Tracks("other")
+	if err == nil || err.Error() != "spotify: playlist not accessible: only playlists you own or collaborate on can be loaded" {
+		t.Fatalf("Tracks(other) err = %v", err)
+	}
+	if ownerPremiumRequired(err) {
+		t.Fatal("ownerPremiumRequired matched an ordinary 403")
+	}
+}
