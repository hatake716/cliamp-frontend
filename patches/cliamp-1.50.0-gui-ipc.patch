+func TestDispatchReplaceErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		req  Request
+		want string
+	}{
+		{"no tracks", Request{Cmd: "replace"}, "requires tracks"},
+		{"empty path", Request{Cmd: "replace", Tracks: []TrackInfo{{Path: "/a"}, {Title: "x"}}}, "track 1 has no path"},
+		{"index too large", Request{Cmd: "replace", Tracks: []TrackInfo{{Path: "/a"}}, Index: intPtr(1)}, "index out of range"},
+		{"negative index", Request{Cmd: "replace", Tracks: []TrackInfo{{Path: "/a"}}, Index: intPtr(-1)}, "index out of range"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			disp := &captureDispatcher{}
+			resp := newGUITestServer(disp, nil).dispatch(tt.req)
+			if resp.OK || !strings.Contains(resp.Error, tt.want) {
+				t.Fatalf("resp = %+v, want error containing %q", resp, tt.want)
+			}
+			if disp.last != nil {
+				t.Fatalf("sent %T despite the error", disp.last)
+			}
+		})
+	}
+}
