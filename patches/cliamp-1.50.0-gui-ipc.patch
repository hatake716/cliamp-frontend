+// The user id of a web-only session is learnt once and kept in the file.
+func TestWebOnlyRemembersUserID(t *testing.T) {
+	f := isolate(t)
+	f.json("GET /v1/me", 200, map[string]string{"id": "u42"})
+	p := New(webOnlyTestSession(t, ""), "cid", 320)
+	defer p.Close()
+	if id := p.currentUserID(context.Background()); id != "u42" {
+		t.Fatalf("currentUserID = %q", id)
+	}
+	if got := readCredsFile(t)["user_id"]; got != "u42" {
+		t.Fatalf("stored user_id = %v", got)
+	}
+
+	// A new provider on a restored session does not ask /v1/me again.
+	f.refreshes(map[string][2]string{"rt-signin": {"at-2", "rt-signin"}})
+	s, err := NewSessionSilent(context.Background(), "cid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p2 := New(s, "cid", 320)
+	defer p2.Close()
+	if id := p2.currentUserID(context.Background()); id != "u42" || f.count("GET /v1/me") != 1 {
+		t.Fatalf("currentUserID = %q, /v1/me calls = %d", id, f.count("GET /v1/me"))
+	}
+
+	// Premium sessions never write web-only fields.
+	if err := os.Remove(mustCredsPath(t)); err != nil {
+		t.Fatal(err)
+	}
+	writeCredsFile(t, `{"username":"u","data":"YmxvYg=="}`)
+	premium := premiumTestSession(t, &fakeBackend{})
+	premium.rememberUserID("u42")
+	if got := readCredsFile(t); got["user_id"] != nil || premium.UserID() != "" {
+		t.Fatalf("premium session remembered a user id: %v", got)
+	}
+}
+
+func mustCredsPath(t *testing.T) string {
+	t.Helper()
+	p, err := CredsPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
