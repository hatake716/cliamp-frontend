+// guiFakeEngine は playbackFakeEngine に、止めた回数・先読みを捨てた回数・
+// EQ・位置を足したもの。
+type guiFakeEngine struct {
+	playbackFakeEngine
+	stops         int
+	clearPreloads int
+	eq            [10]float64
+	position      time.Duration
+}
+
+func (f *guiFakeEngine) Stop()                   { f.stops++; f.playing = false }
+func (f *guiFakeEngine) ClearPreload()           { f.clearPreloads++ }
+func (f *guiFakeEngine) EQBands() [10]float64    { return f.eq }
+func (f *guiFakeEngine) Position() time.Duration { return f.position }
+
+// guiFakeProvider は大きさのある構造体にしておく (大きさ 0 の値へのポインタは
+// 互いに等しくなりうるため、providerKey の比較の試験にならない)。
+type guiFakeProvider struct{ name string }
+
+func (p *guiFakeProvider) Name() string                                { return p.name }
+func (p *guiFakeProvider) Playlists() ([]playlist.PlaylistInfo, error) { return nil, nil }
+func (p *guiFakeProvider) Tracks(string) ([]playlist.Track, error)     { return nil, nil }
+
+func newGUITestTracks(names ...string) []playlist.Track {
+	out := make([]playlist.Track, len(names))
+	for i, n := range names {
+		out[i] = playlist.Track{Path: n + ".flac", Title: n}
+	}
+	return out
+}
+
+func newGUITestModel(tracks ...string) (Model, *guiFakeEngine) {
+	eng := &guiFakeEngine{}
+	pl := playlist.New()
+	if len(tracks) > 0 {
+		pl.Replace(newGUITestTracks(tracks...))
+	}
+	m := Model{
+		player:   eng,
+		playlist: pl,
+		vis:      ui.NewVisualizer(float64(eng.SampleRate())),
+		themeIdx: -1,
+	}
+	return m, eng
+}
+
+// sendGUI は msg を Update に通し、返った答えと新しいモデルを返す。
+func sendGUI(t *testing.T, m Model, build func(reply chan ipc.Response) tea.Msg) (Model, ipc.Response) {
+	t.Helper()
+	reply := make(chan ipc.Response, 1)
+	next, _ := m.Update(build(reply))
+	select {
+	case resp := <-reply:
+		return next.(Model), resp
+	default:
+		t.Fatal("no reply")
+	}
+	return Model{}, ipc.Response{}
+}
+
+func startPlaying(m *Model, idx int) {
+	m.playlist.SetIndex(idx)
+	m.playCurrentTrack()
+}
