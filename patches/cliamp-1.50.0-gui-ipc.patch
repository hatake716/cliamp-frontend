+func TestGUISourceFollowsTUILoads(t *testing.T) {
+	prov := &guiFakeProvider{name: "Radio"}
+	m, _ := newGUITestModel("a")
+	m.providers = []ProviderEntry{{Key: "radio", Name: "Radio", Provider: prov}}
+	m.provider = prov
+	m.providerLists = []playlist.PlaylistInfo{{ID: "l:0", Name: "cliamp radio"}}
+	m.activeProviderPlaylistID = "l:0"
+
+	next, _ := m.Update(tracksLoadedMsg(newGUITestTracks("r")))
+	m = next.(Model)
+	want := ipc.SourceInfo{Provider: "radio", ID: "l:0", Name: "cliamp radio"}
+	if got := m.listSource(); got == nil || *got != want {
+		t.Fatalf("source after TUI load = %v, want %v", got, want)
+	}
+
+	// 出どころの分からない差し替え (ファイルを開くなど) では消える。
+	next, _ = m.Update(fbTracksResolvedMsg{tracks: newGUITestTracks("f"), replace: true})
+	m = next.(Model)
+	if got := m.listSource(); got != nil {
+		t.Fatalf("source after file load = %v, want nil", got)
+	}
+}
