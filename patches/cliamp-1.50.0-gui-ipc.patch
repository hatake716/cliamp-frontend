+// A spotify:track: path on a web-only session fails with the documented text,
+// not with a sign-in prompt, and without trying to reconnect.
+func TestNewStreamerWebOnly(t *testing.T) {
+	isolate(t)
+	calls := setBackend(t, func(any) (streamBackend, error) { return nil, errTestGuard })
+	p := New(webOnlyTestSession(t, ""), "cid", 320)
+	defer p.Close()
+
+	_, _, _, err := p.NewStreamer("spotify:track:4uLU6hMCjMI75M1A2tKUQC")
+	if err == nil || !strings.Contains(err.Error(), "spotify: streaming unavailable") {
+		t.Fatalf("NewStreamer err = %v", err)
+	}
+	if errors.Is(err, playlist.ErrNeedsAuth) {
