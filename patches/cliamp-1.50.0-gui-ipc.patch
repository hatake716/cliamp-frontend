+// 止まっているとき (リストを最後まで鳴らし終えたあとなど) のシャッフル中の
+// enqueue end も、足した曲のうち先頭しか鳴らさずに終わることはない。
+func TestEnqueueEndWhenIdleWithShuffleKeepsAddedTracks(t *testing.T) {
