new file mode 100644
index 0000000..8ab8419
--- /dev/null
+++ b/ipc/playerr.go
@@ -0,0 +1,77 @@
+package ipc
+
+// playerr.go — status の playback_error (いまの曲が鳴らせなかった理由)。
+//
+// TUI の m.err (画面の "ERR: …") は、設定の保存やプロバイダーの読み込みなど
+// 再生と関係の無い誤りにも使われ、再生が始まっても消えないことがある。GUI には
+// 「いまの曲の最後の開始が失敗した」ことだけを伝えたいので、別に持つ。
+// TUI (ui/model) と daemon が同じ型を使う。
+
+import "unicode/utf8"
+
+// playbackErrorMax は playback_error の上限 (バイト)。yt-dlp は WARNING を
+// 何行も出すことがあり、status は 1 秒に何度も問い合わせられるため。
+const playbackErrorMax = 2048
+
+// PlaybackFailure は、最後に始めた曲と、その開始が失敗した理由を持つ。
+// ゼロ値は「失敗していない」。
+type PlaybackFailure struct {
+	started string // 最後に始めた曲の path
+	path    string // 失敗した曲の path
+	text    string // 失敗の理由 (空なら失敗していない)
+	seek    bool   // 失敗したのが yt-dlp のシーク (後のシークが成功すれば消える)
+}
+
+// Begin は再生を始めるたびに (同じ曲のやり直しも、gapless で次の曲へ進んだ
+// ときも) 呼ぶ。前の失敗を消し、始めた曲を覚える。
+func (f *PlaybackFailure) Begin(path string) {
+	*f = PlaybackFailure{started: path}
+}
+
+// Fail は最後の開始が err で失敗したときに呼ぶ。err が nil なら何もしない。
+// 追い越された開始 (player.ErrSuperseded) は呼ぶ側で除くこと。
+func (f *PlaybackFailure) Fail(err error) { f.fail(err, false) }
+
+// FailSeek は yt-dlp の曲のシーク (yt-dlp を起こし直す) が err で失敗したときに
+// 呼ぶ。音は止まったままになるので再生の失敗とするが、後のシークが成功すれば
+// 音が戻るので SeekOK で消える。
+func (f *PlaybackFailure) FailSeek(err error) { f.fail(err, true) }
+
+// SeekOK は yt-dlp の曲のシークが成功したときに呼ぶ。シークの失敗だけを消す
+// (開始の失敗は、シークでは直らない)。
+func (f *PlaybackFailure) SeekOK() {
+	if f.seek {
+		*f = PlaybackFailure{started: f.started}
+	}
+}
+
+func (f *PlaybackFailure) fail(err error, seek bool) {
+	if err == nil {
+		return
+	}
+	f.path = f.started
+	f.text = truncateUTF8(err.Error(), playbackErrorMax)
+	f.seek = seek
+}
+
+// Text はいまの曲 (path が current) の失敗の理由を返す。失敗していないか、
+// いまの曲が失敗した曲でなければ (止まっている間にリストが変わったなど) 空。
+func (f PlaybackFailure) Text(current string) string {
+	if f.text == "" || current != f.path {
+		return ""
+	}
+	return f.text
+}
+
+// truncateUTF8 は s を limit バイト以内に、文字の途中で切らずに縮める
+// (縮めたときは末尾に "…" を付ける)。
+func truncateUTF8(s string, limit int) string {
+	if len(s) <= limit {
+		return s
+	}
+	cut := limit - len("…")
+	for cut > 0 && !utf8.RuneStart(s[cut]) {
+		cut--
+	}
+	return s[:cut] + "…"
+}
