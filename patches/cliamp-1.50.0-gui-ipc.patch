+// How a refused first page reads.
+func TestSearchTracksErrors(t *testing.T) {
+	const ownerPremium = `{"error":{"status":403,"message":"Active premium subscription required for the owner of the app"}}`
+	const notRegistered = `{"error":{"status":403,"message":"Check settings on developer.spotify.com/dashboard, the user may not be registered."}}`
+	tests := []struct {
+		name    string
+		status  int
+		body    string
+		want    string // exact error text
+		notWant []string
+	}{
+		// Passed on unchanged: the GUI recognises Spotify's own words.
+		{"owner without Premium", 403, ownerPremium,
+			"spotify: search: http status 403 Forbidden: " + ownerPremium, nil},
+		{"account not a user of the app", 403, notRegistered,
+			"spotify: search: this Spotify account is not a user of the Developer app (add it under User Management at developer.spotify.com/dashboard): http status 403 Forbidden: " + notRegistered, nil},
+		// No longer blamed on the client_id's age.
+		{"invalid limit", 400, `{"error":{"status":400,"message":"Invalid limit"}}`,
+			`spotify: search: Spotify refused a page of 10 results (cliamp asks for at most 10 per request, the limit for Development Mode apps since February 2026; Spotify may have lowered it again): http status 400 Bad Request: {"error":{"status":400,"message":"Invalid limit"}}`,
+			[]string{"too new", "search blocked", "Nov 27"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			var calls atomic.Int32
+			f.handle("GET /v1/search", func(w http.ResponseWriter, _ *http.Request) {
+				calls.Add(1)
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(tt.status)
+				_, _ = io.WriteString(w, tt.body)
+			})
+			p := testProvider(t, true)
+			_, err := p.SearchTracks(context.Background(), "q", 20)
+			if err == nil || err.Error() != tt.want {
