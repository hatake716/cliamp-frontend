diff --git a/external/spotify/devmode.go b/external/spotify/devmode.go
new file mode 100644
index 0000000..3551352
--- /dev/null
+++ b/external/spotify/devmode.go
@@ -0,0 +1,200 @@
+//go:build !windows
+
+package spotify
+
+// devmode.go — the Web API as Spotify serves it to Development Mode apps
+// since February 2026 (apps created from Feb 11, existing ones from Mar 9).
+//
+// A client_id registered on developer.spotify.com is a Development Mode app.
+// The changes that concern cliamp:
+//
+//   - /v1/search accepts at most limit=10 (default 5); more is a 400
+//     "Invalid limit". SearchTracks pages through with offset.
+//   - POST /v1/playlists/{id}/tracks became POST /v1/playlists/{id}/items and
+//     POST /v1/users/{id}/playlists became POST /v1/me/playlists
+//     (AddTrackToPlaylist, CreatePlaylist in provider.go).
+//   - The app's owner must have Premium, or every call is a 403 "Active
+//     premium subscription required for the owner of the app". That reply is
+//     passed on with Spotify's text (ownerPremiumRequired).
+//   - A 429 with the reason QUOTA_EXCEEDED (July 2026) is the developer's
+//     shared quota, not a rate limit (ratelimit.go).
+//
+// The other calls cliamp makes — GET /v1/me (only its id is read),
+// GET /v1/me/tracks, GET /v1/me/playlists and GET /v1/playlists/{id}/items
+// (already the new name, reading items.total and each entry's item) — are
+// unchanged for it.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"cliamp/applog"
+	"cliamp/playlist"
+)
+
+// spotifySearchPageSize is the largest limit /v1/search accepts from a
+// Development Mode app.
+const spotifySearchPageSize = 10
+
+// maxSearchResults caps SearchTracks' limit (the Web API's former page size).
+const maxSearchResults = 50
+
+// SearchTracks searches for tracks on Spotify and returns up to limit results
+// (limit is clamped to 1..50) in Spotify's order, each track once.
+//
+// It asks for pages of at most spotifySearchPageSize at increasing offsets
+// and stops early at a short page or at the reported total. When the first
+// page fails, its error is returned. When a later page fails, the results so
+// far are returned and the failure is logged, unless it is a refusal that
+// every call gets for a while (refusesEveryCall): then that error is returned,
+// so the caller sees it rather than a short list that looks complete.
+func (p *SpotifyProvider) SearchTracks(ctx context.Context, query string, limit int) ([]playlist.Track, error) {
+	if err := p.ensureSession(); err != nil {
+		return nil, err
+	}
+	limit = min(max(limit, 1), maxSearchResults)
+
+	var tracks []spotifyTrack
+	seen := make(map[string]struct{})
+	for offset := 0; offset < limit && len(tracks) < limit; {
+		size := min(spotifySearchPageSize, limit-offset)
+		page, err := p.searchPage(ctx, query, offset, size)
+		if err != nil {
+			if offset == 0 || refusesEveryCall(err) {
+				return nil, err
+			}
+			applog.UserWarn("spotify: search: returning the first %d results; the page at offset %d failed: %v", len(tracks), offset, err)
+			break
+		}
+		for _, t := range page.tracks {
+			if _, dup := seen[t.id]; dup || len(tracks) == limit {
+				continue
+			}
+			seen[t.id] = struct{}{}
+			tracks = append(tracks, t)
+		}
+		offset += size
+		if page.returned < size || (page.total > 0 && offset >= page.total) {
+			break
+		}
+	}
+	return p.presentTracks(tracks), nil
+}
+
+// refusesEveryCall reports whether err is a refusal that the next calls get
+// too until something changes: the developer quota is used up, Spotify asked
+// to wait longer than cliamp waits, the sign-in is gone, or the app's owner
+// has no Premium. SearchTracks does not hide these behind the pages it
+// already has: the GUI keeps a successful search for minutes and remembers
+// the quota and owner refusals so that it stops asking Spotify.
+func refusesEveryCall(err error) bool {
+	var quota *QuotaExceededError
+	var limited *RateLimitError
+	return errors.As(err, &quota) || errors.As(err, &limited) ||
+		errors.Is(err, playlist.ErrNeedsAuth) || ownerPremiumRequired(err)
+}
+
+// searchResultPage is one /v1/search reply.
+type searchResultPage struct {
+	tracks   []spotifyTrack // the items with an id
+	returned int            // items in the reply, null ones included
+	total    int            // tracks.total (0 when absent)
+}
+
+// searchPage asks /v1/search for size tracks from offset.
+func (p *SpotifyProvider) searchPage(ctx context.Context, query string, offset, size int) (searchResultPage, error) {
+	// No market parameter: when the request carries a user OAuth token, Spotify
+	// implicitly scopes results to the account's country.
+	q := url.Values{
+		"q":      {query},
+		"type":   {"track"},
+		"limit":  {strconv.Itoa(size)},
+		"offset": {strconv.Itoa(offset)},
+	}
+	resp, err := p.webAPI(ctx, "GET", "/v1/search", q)
+	if err != nil {
+		return searchResultPage{}, friendlySearchError(err, size)
+	}
+
+	var result struct {
+		Tracks struct {
+			Items []*struct {
+				ID      string `json:"id"`
+				Name    string `json:"name"`
+				Artists []struct {
+					Name string `json:"name"`
+				} `json:"artists"`
+				Album struct {
+					Name        string `json:"name"`
+					ReleaseDate string `json:"release_date"`
+				} `json:"album"`
+				DurationMs  int `json:"duration_ms"`
+				TrackNumber int `json:"track_number"`
+			} `json:"items"`
+			Total int `json:"total"`
+		} `json:"tracks"`
+	}
+	if err := decodeBody(resp, &result); err != nil {
+		return searchResultPage{}, fmt.Errorf("spotify: parse search: %w", err)
+	}
+
+	page := searchResultPage{returned: len(result.Tracks.Items), total: result.Tracks.Total}
+	for _, t := range result.Tracks.Items {
+		if t == nil || t.ID == "" {
+			continue
+		}
+		artists := make([]string, len(t.Artists))
+		for i, a := range t.Artists {
+			artists[i] = a.Name
+		}
+		var year int
+		if len(t.Album.ReleaseDate) >= 4 {
+			if y, err := strconv.Atoi(t.Album.ReleaseDate[:4]); err == nil {
+				year = y
+			}
+		}
+		page.tracks = append(page.tracks, spotifyTrack{
+			id:           t.ID,
+			title:        t.Name,
+			artists:      artists,
+			album:        t.Album.Name,
+			year:         year,
+			durationSecs: t.DurationMs / 1000,
+			trackNumber:  t.TrackNumber,
+			fromSearch:   true,
+		})
+	}
+	return page, nil
+}
+
+// friendlySearchError describes a failed /v1/search call of size results.
+//
+// Spotify's 400 "Invalid limit" used to be read as "your client_id is too
+// new, Development Mode apps cannot search". It meant the page size: since
+// February 2026 Development Mode allows at most spotifySearchPageSize, which
+// SearchTracks no longer exceeds, so the message names the size Spotify
+// refused. A 403 because the signed-in account is not a user of the app gets
+// a hint. Everything else — including the 403 for an app owner without
+// Premium, whose text is already clear — is wrapped unchanged.
+func friendlySearchError(err error, size int) error {
+	msg := err.Error()
+	switch {
+	case strings.Contains(msg, "http status 400") && strings.Contains(msg, "Invalid limit"):
+		return fmt.Errorf("spotify: search: Spotify refused a page of %d results (cliamp asks for at most %d per request, the limit for Development Mode apps since February 2026; Spotify may have lowered it again): %w", size, spotifySearchPageSize, err)
+	case strings.Contains(msg, "http status 403") && strings.Contains(msg, "may not be registered"):
+		return fmt.Errorf("spotify: search: this Spotify account is not a user of the Developer app (add it under User Management at developer.spotify.com/dashboard): %w", err)
+	}
+	return fmt.Errorf("spotify: search: %w", err)
+}
+
+// ownerPremiumRequired reports whether err is the Web API's 403 for an app
+// whose owner has no Premium subscription. Spotify answers every call so
+// until it sees the owner's Premium, which can take hours after subscribing.
+func ownerPremiumRequired(err error) bool {
+	msg := strings.ToLower(err.Error())
+	return strings.Contains(msg, "http status 403") && strings.Contains(msg, "premium subscription required for the owner")
+}
diff --git a/external/spotify/devmode_test.go b/external/spotify/devmode_test.go
new file mode 100644
index 0000000..b5e0012
--- /dev/null
+++ b/external/spotify/devmode_test.go
@@ -0,0 +1,623 @@
+//go:build !windows
+
+package spotify
+
+// Tests for the Development Mode rules of February / July 2026 (devmode.go,
+// ratelimit.go). The fake answers as Spotify does for such apps: /v1/search
+// refuses limit > 10 with 400 "Invalid limit", and the removed endpoints are
+// not served at all.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"reflect"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"cliamp/applog"
+	"cliamp/playlist"
+)
+
+// searchCall is one /v1/search request the fake received.
+type searchCall struct{ offset, limit int }
+
+// searchFake serves /v1/search from ids ("" is a null item) with the given
+// total. fail answers the page at an offset instead.
+type searchFake struct {
+	ids   []string
+	total int
+	fail  map[int]http.HandlerFunc
+
+	mu    sync.Mutex
+	calls []searchCall
+}
+
+func (s *searchFake) serve(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	limit := 5 // Spotify's default since February 2026
+	if v := q.Get("limit"); v != "" {
+		limit, _ = strconv.Atoi(v)
+	}
+	offset, _ := strconv.Atoi(q.Get("offset"))
+	s.mu.Lock()
+	s.calls = append(s.calls, searchCall{offset, limit})
+	s.mu.Unlock()
+	w.Header().Set("Content-Type", "application/json")
+	if limit < 1 || limit > 10 {
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = io.WriteString(w, `{"error":{"status":400,"message":"Invalid limit"}}`)
+		return
+	}
+	if h := s.fail[offset]; h != nil {
+		h(w, r)
+		return
+	}
+	items := []any{}
+	for i := offset; i < len(s.ids) && i < offset+limit; i++ {
+		if s.ids[i] == "" {
+			items = append(items, nil)
+			continue
+		}
+		id := s.ids[i]
+		items = append(items, map[string]any{
+			"id": id, "name": "Song " + id, "artists": []map[string]string{{"name": "Artist " + id}},
+			"album":       map[string]string{"name": "Album " + id, "release_date": "2021-05-01"},
+			"duration_ms": 180500, "track_number": 3,
+		})
+	}
+	_ = json.NewEncoder(w).Encode(map[string]any{
+		"tracks": map[string]any{"items": items, "total": s.total, "limit": limit, "offset": offset},
+	})
+}
+
+func (s *searchFake) seen() []searchCall {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]searchCall(nil), s.calls...)
+}
+
+func seq(prefix string, n int) []string {
+	out := make([]string, n)
+	for i := range out {
+		out[i] = fmt.Sprintf("%s%d", prefix, i)
+	}
+	return out
+}
+
+// trackIDs returns the Spotify id of each track (either playback mode).
+func trackIDs(ts []playlist.Track) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = strings.TrimPrefix(spotifyTrackURI(t), spotifyTrackPrefix)
+	}
+	return out
+}
+
+// testProvider returns a provider on a web-only or a Premium session.
+func testProvider(t *testing.T, webOnly bool) *SpotifyProvider {
+	t.Helper()
+	var sess *Session
+	if webOnly {
+		sess = webOnlyTestSession(t, "")
+	} else {
+		sess = premiumTestSession(t, &fakeBackend{})
+	}
+	p := New(sess, "cid", 320)
+	t.Cleanup(p.Close)
+	return p
+}
+
+var playbackModes = []struct {
+	name    string
+	webOnly bool
+}{{"web-only", true}, {"premium", false}}
+
+func TestSearchTracksPagination(t *testing.T) {
+	dups := append(seq("a", 10), "a5", "b0", "a3", "b1", "", "b2", "b2", "b3", "b4", "b5")
+	dups = append(dups, seq("c", 10)...)
+	tests := []struct {
+		name      string
+		ids       []string
+		total     int
+		limit     int
+		wantCalls []searchCall
+		wantIDs   []string
+	}{
+		{"limit 20 is two pages of 10", seq("t", 60), 60, 20,
+			[]searchCall{{0, 10}, {10, 10}}, seq("t", 20)},
+		{"limit 25 is pages of 10, 10 and 5", seq("t", 60), 60, 25,
+			[]searchCall{{0, 10}, {10, 10}, {20, 5}}, seq("t", 25)},
+		{"limit 5 is one page", seq("t", 60), 60, 5,
+			[]searchCall{{0, 5}}, seq("t", 5)},
+		{"limit 10 is one page", seq("t", 60), 60, 10,
+			[]searchCall{{0, 10}}, seq("t", 10)},
+		{"limit 0 is clamped to 1", seq("t", 60), 60, 0,
+			[]searchCall{{0, 1}}, seq("t", 1)},
+		{"limit 100 is clamped to 50", seq("t", 60), 60, 100,
+			[]searchCall{{0, 10}, {10, 10}, {20, 10}, {30, 10}, {40, 10}}, seq("t", 50)},
+		// Spotify's total is often larger than what it returns: the short
+		// page ends the search.
+		{"a short page stops", seq("t", 13), 1000, 25,
+			[]searchCall{{0, 10}, {10, 10}}, seq("t", 13)},
+		{"reaching the total stops", seq("t", 10), 10, 25,
+			[]searchCall{{0, 10}}, seq("t", 10)},
+		{"no results", nil, 0, 25,
+			[]searchCall{{0, 10}}, nil},
+		// Repeats (across and within pages) and null items are dropped; the
+		// first occurrence keeps its place. Pages are not re-requested to
+		// make up for them.
+		{"duplicate ids are dropped in order", dups, 1000, 25,
+			[]searchCall{{0, 10}, {10, 10}, {20, 5}},
+			append(append(seq("a", 10), "b0", "b1", "b2", "b3", "b4", "b5"), seq("c", 5)...)},
+	}
+	for _, mode := range playbackModes {
+		for _, tt := range tests {
+			t.Run(mode.name+"/"+tt.name, func(t *testing.T) {
+				f := isolate(t)
+				sf := &searchFake{ids: tt.ids, total: tt.total}
+				f.handle("GET /v1/search", sf.serve)
+				p := testProvider(t, mode.webOnly)
+
+				got, err := p.SearchTracks(context.Background(), "q", tt.limit)
+				if err != nil {
+					t.Fatalf("SearchTracks: %v", err)
+				}
+				if calls := sf.seen(); !slices.Equal(calls, tt.wantCalls) {
+					t.Fatalf("requests (offset, limit) = %v, want %v", calls, tt.wantCalls)
+				}
+				if ids := trackIDs(got); !slices.Equal(ids, tt.wantIDs) {
+					t.Fatalf("ids = %v, want %v", ids, tt.wantIDs)
+				}
+				// Each result keeps the mode's shape (bridged or spotify:track:).
+				for _, tr := range got {
+					if mode.webOnly != (tr.Meta(metaBridge) == PlaybackYouTube) || mode.webOnly == strings.HasPrefix(tr.Path, spotifyTrackPrefix) {
+						t.Fatalf("track %#v is not in the %s shape", tr, mode.name)
+					}
+				}
+			})
+		}
+	}
+}
+
+// The search query and type go on every page.
+func TestSearchTracksPageQuery(t *testing.T) {
+	f := isolate(t)
+	var queries []string
+	var mu sync.Mutex
+	sf := &searchFake{ids: seq("t", 30), total: 30}
+	f.handle("GET /v1/search", func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		queries = append(queries, r.URL.Query().Get("q")+"|"+r.URL.Query().Get("type")+"|"+r.URL.Query().Get("market"))
+		mu.Unlock()
+		sf.serve(w, r)
+	})
+	p := testProvider(t, true)
+	if _, err := p.SearchTracks(context.Background(), "米津玄師 Lemon", 20); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"米津玄師 Lemon|track|", "米津玄師 Lemon|track|"}
+	if !slices.Equal(queries, want) {
+		t.Fatalf("queries = %q, want %q", queries, want)
+	}
+}
