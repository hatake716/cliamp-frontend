+// A later page that fails leaves the pages before it, unless the failure is
+// a refusal every call gets for a while (quota, long rate limit, owner
+// without Premium): that is the search's error, as is any failure of the
+// first page.
+func TestSearchTracksPageFailure(t *testing.T) {
+	tests := []struct {
+		name      string
+		fail      map[int]http.HandlerFunc
+		wantCalls []searchCall
+		wantIDs   []string
+		wantErr   string
+		wantWarn  string
+	}{
+		{"second page fails", map[int]http.HandlerFunc{10: serverError},
+			[]searchCall{{0, 10}, {10, 10}}, seq("t", 10), "",
+			"spotify: search: returning the first 10 results; the page at offset 10 failed: spotify: search: http status 500"},
+		{"third page runs out of quota", map[int]http.HandlerFunc{20: quotaExceededHandler("3600")},
+			[]searchCall{{0, 10}, {10, 10}, {20, 5}}, nil,
+			"spotify: search: spotify: Spotify quota exceeded for this developer account; retry after 1h0m0s", ""},
+		{"second page is rate limited for a day", map[int]http.HandlerFunc{10: rateLimitedHandler("86400")},
+			[]searchCall{{0, 10}, {10, 10}}, nil,
+			"spotify: search: spotify: rate limited by Spotify; retry after 24h0m0s", ""},
+		{"second page: owner without Premium", map[int]http.HandlerFunc{10: ownerPremiumHandler},
+			[]searchCall{{0, 10}, {10, 10}}, nil,
+			"spotify: search: http status 403 Forbidden: {\"error\":{\"status\":403,\"message\":\"Active premium subscription required for the owner of the app\"}}", ""},
+		{"first page fails", map[int]http.HandlerFunc{0: serverError},
+			[]searchCall{{0, 10}}, nil, "spotify: search: http status 500 Internal Server Error: ", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			sf := &searchFake{ids: seq("t", 60), total: 60, fail: tt.fail}
+			f.handle("GET /v1/search", sf.serve)
+			p := testProvider(t, true)
+			applog.Drain()
+
+			got, err := p.SearchTracks(context.Background(), "q", 25)
+			if tt.wantErr != "" {
+				if err == nil || !strings.HasPrefix(err.Error(), tt.wantErr) || got != nil {
+					t.Fatalf("SearchTracks = %d tracks, %v; want error %q", len(got), err, tt.wantErr)
+				}
+			} else if err != nil {
+				t.Fatalf("SearchTracks: %v", err)
+			}
+			if calls := sf.seen(); !slices.Equal(calls, tt.wantCalls) {
+				t.Fatalf("requests = %v, want %v", calls, tt.wantCalls)
+			}
+			if ids := trackIDs(got); !slices.Equal(ids, tt.wantIDs) {
+				t.Fatalf("ids = %v, want %v", ids, tt.wantIDs)
+			}
+			if tt.wantWarn != "" {
+				var texts []string
+				for _, e := range applog.Drain() {
+					texts = append(texts, e.Text)
+				}
+				if !slices.ContainsFunc(texts, func(s string) bool { return strings.Contains(s, tt.wantWarn) }) {
+					t.Fatalf("warnings = %q, want one containing %q", texts, tt.wantWarn)
+				}
+			}
+		})
+	}
+}
