+// fakeSpotify is an httptest server playing both accounts.spotify.com
+// (/api/token) and api.spotify.com (/v1/...).
+type fakeSpotify struct {
+	t   *testing.T
+	srv *httptest.Server
+
+	mu       sync.Mutex
+	requests []string // "METHOD /path"
+	bodies   map[string][]string
+	routes   map[string]http.HandlerFunc // "METHOD /path" → handler
+	token    http.HandlerFunc
+}
+
+func newFakeSpotify(t *testing.T) *fakeSpotify {
+	t.Helper()
+	f := &fakeSpotify{t: t, routes: map[string]http.HandlerFunc{}, bodies: map[string][]string{}}
+	f.srv = httptest.NewServer(http.HandlerFunc(f.serve))
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *fakeSpotify) serve(w http.ResponseWriter, r *http.Request) {
+	key := r.Method + " " + r.URL.Path
+	body, _ := io.ReadAll(r.Body)
+	f.mu.Lock()
+	f.requests = append(f.requests, key)
+	f.bodies[key] = append(f.bodies[key], string(body))
+	h := f.routes[key]
+	tok := f.token
+	f.mu.Unlock()
+	r.Body = io.NopCloser(strings.NewReader(string(body)))
+	if r.URL.Path == "/api/token" {
+		if tok == nil {
+			http.Error(w, `{"error":"server_error"}`, http.StatusInternalServerError)
+			return
+		}
+		tok(w, r)
+		return
+	}
+	if h == nil {
+		http.Error(w, `{"error":{"status":404,"message":"no fake route"}}`, http.StatusNotFound)
+		return
+	}
+	h(w, r)
+}
+
+// handle registers a handler for "METHOD /path".
+func (f *fakeSpotify) handle(key string, h http.HandlerFunc) {
+	f.mu.Lock()
+	f.routes[key] = h
+	f.mu.Unlock()
+}
+
+// json registers a handler answering status with v as JSON.
+func (f *fakeSpotify) json(key string, status int, v any) {
+	f.handle(key, func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(status)
+		_ = json.NewEncoder(w).Encode(v)
+	})
+}
+
+// refreshes answers refresh_token grants: known refresh token → access token
+// and (possibly rotated) refresh token; anything else → invalid_grant.
+func (f *fakeSpotify) refreshes(grants map[string][2]string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.token = func(w http.ResponseWriter, r *http.Request) {
+		_ = r.ParseForm()
+		w.Header().Set("Content-Type", "application/json")
+		g, ok := grants[r.PostForm.Get("refresh_token")]
+		if r.PostForm.Get("grant_type") != "refresh_token" || !ok {
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = io.WriteString(w, `{"error":"invalid_grant","error_description":"Refresh token revoked"}`)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": g[0], "token_type": "Bearer", "expires_in": 3600, "refresh_token": g[1],
+		})
+	}
+}
+
+func (f *fakeSpotify) count(key string) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	n := 0
+	for _, k := range f.requests {
+		if k == key {
+			n++
+		}
+	}
+	return n
+}
+
+func (f *fakeSpotify) body(key string) []string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]string(nil), f.bodies[key]...)
+}
+
+// isolate gives the test its own HOME (so the credentials file is a temp
+// file), points the accounts service and the Web API at a fake, and restores
+// the guards afterwards. The librespot and browser seams stay guarded unless
+// the test replaces them with setBackend / setAuthorize.
+func isolate(t *testing.T) *fakeSpotify {
+	t.Helper()
+	t.Setenv("HOME", t.TempDir())
+	f := newFakeSpotify(t)
+	oldEndpoint, oldBase := oauthEndpoint, webAPIBase
+	oauthEndpoint = oauth2.Endpoint{
+		AuthURL:   f.srv.URL + "/authorize",
+		TokenURL:  f.srv.URL + "/api/token",
+		AuthStyle: oauth2.AuthStyleInParams,
+	}
+	webAPIBase = f.srv.URL
+	t.Cleanup(func() { oauthEndpoint, webAPIBase = oldEndpoint, oldBase })
+	return f
+}
+
+// setBackend replaces openStreamBackend for the test and records its calls.
+func setBackend(t *testing.T, fn func(creds any) (streamBackend, error)) *[]backendCall {
+	t.Helper()
+	var calls []backendCall
+	var mu sync.Mutex
+	old := openStreamBackend
+	openStreamBackend = func(_ context.Context, devID string, creds any) (streamBackend, error) {
+		mu.Lock()
+		calls = append(calls, backendCall{devID: devID, creds: creds})
+		mu.Unlock()
+		return fn(creds)
+	}
+	t.Cleanup(func() { openStreamBackend = old })
+	return &calls
+}
+
+// setAuthorize replaces the browser sign-in with one returning tok.
+func setAuthorize(t *testing.T, tok *oauth2.Token) *int {
+	t.Helper()
+	n := 0
+	old := authorizeInteractive
+	authorizeInteractive = func(context.Context, string) (*oauth2.Token, error) {
+		n++
+		return tok, nil
+	}
+	t.Cleanup(func() { authorizeInteractive = old })
+	return &n
+}
+
+// signInToken is what the fake browser sign-in returns.
+func signInToken() *oauth2.Token {
+	return &oauth2.Token{
+		AccessToken:  "at-signin",
+		TokenType:    "Bearer",
+		RefreshToken: "rt-signin",
+		Expiry:       time.Now().Add(time.Hour),
+	}
+}
+
+// readCredsFile returns the credentials file as raw JSON fields (nil if absent).
+func readCredsFile(t *testing.T) map[string]any {
+	t.Helper()
+	path, err := CredsPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m map[string]any
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.Fatalf("credentials file is not JSON: %v\n%s", err, data)
+	}
+	return m
+}
+
+// writeCredsFile writes raw JSON as the credentials file.
+func writeCredsFile(t *testing.T, raw string) {
+	t.Helper()
+	path, err := CredsPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// webOnlyTestSession builds a web-only session on the fake (token valid for
+// an hour, so no refresh unless the test asks for one).
+func webOnlyTestSession(t *testing.T, userID string) *Session {
+	t.Helper()
+	return newWebOnlySession("cid", generateDeviceID(), signInToken(), userID, "test")
+}
+
+// premiumTestSession builds a librespot-backed session on the fake.
+func premiumTestSession(t *testing.T, b streamBackend) *Session {
+	t.Helper()
+	conf := spotifyOAuthConfig("cid")
+	return &Session{stream: b, devID: generateDeviceID(), clientID: "cid", tokenSource: conf.TokenSource(context.Background(), signInToken())}
+}
