diff --git a/external/spotify/backend.go b/external/spotify/backend.go
new file mode 100644
index 0000000..afd6016
--- /dev/null
+++ b/external/spotify/backend.go
@@ -0,0 +1,88 @@
+//go:build !windows
+
+package spotify
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"os"
+
+	librespot "github.com/devgianlu/go-librespot"
+	librespotPlayer "github.com/devgianlu/go-librespot/player"
+	devicespb "github.com/devgianlu/go-librespot/proto/spotify/connectstate/devices"
+	"github.com/devgianlu/go-librespot/session"
+)
+
+// streamBackend is the librespot half of a Session: the access point/login5
+// session and the player built on it. A web-only Session has none.
+type streamBackend interface {
+	Username() string
+	StoredCredentials() []byte
+	NewStream(ctx context.Context, spotID librespot.SpotifyId, bitrate int) (*librespotPlayer.Stream, error)
+	Close()
+}
+
+// openStreamBackend connects to Spotify with go-librespot. creds is one of
+// the session.*Credentials types. Tests replace it so that no test reaches
+// Spotify.
+var openStreamBackend = openLibrespot
+
+// librespotBackend is the real streamBackend.
+type librespotBackend struct {
+	sess   *session.Session
+	player *librespotPlayer.Player
+}
+
+func openLibrespot(ctx context.Context, devID string, creds any) (streamBackend, error) {
+	sess, err := session.NewSessionFromOptions(ctx, &session.Options{
+		Log:         &librespot.NullLogger{},
+		DeviceType:  devicespb.DeviceType_COMPUTER,
+		DeviceId:    devID,
+		Credentials: creds,
+	})
+	if err != nil {
+		return nil, err
+	}
+	player, err := newLibrespotPlayer(sess)
+	if err != nil {
+		sess.Close()
+		return nil, err
+	}
+	return &librespotBackend{sess: sess, player: player}, nil
+}
+
+// newLibrespotPlayer creates the go-librespot player. We only use NewStream()
+// for decoded AudioSources — audio output is routed through cliamp's Beep
+// pipeline, not go-librespot's output backend.
+func newLibrespotPlayer(sess *session.Session) (*librespotPlayer.Player, error) {
+	// go-librespot uses this for media restriction checks but Premium
+	// accounts can play all tracks regardless.
+	countryCode := "US"
+	p, err := librespotPlayer.NewPlayer(&librespotPlayer.Options{
+		Spclient:             sess.Spclient(),
+		AudioKey:             sess.AudioKey(),
+		Events:               sess.Events(),
+		Log:                  &librespot.NullLogger{},
+		CountryCode:          &countryCode,
+		NormalisationEnabled: true,
+		AudioBackend:         "pipe",
+		AudioOutputPipe:      os.DevNull,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("spotify: player init: %w", err)
+	}
+	return p, nil
+}
+
+func (b *librespotBackend) Username() string          { return b.sess.Username() }
+func (b *librespotBackend) StoredCredentials() []byte { return b.sess.StoredCredentials() }
+
+func (b *librespotBackend) NewStream(ctx context.Context, spotID librespot.SpotifyId, bitrate int) (*librespotPlayer.Stream, error) {
+	return b.player.NewStream(ctx, http.DefaultClient, spotID, bitrate, 0)
+}
+
+func (b *librespotBackend) Close() {
+	b.player.Close()
+	b.sess.Close()
+}
diff --git a/external/spotify/bridge.go b/external/spotify/bridge.go
new file mode 100644
index 0000000..36b100c
--- /dev/null
+++ b/external/spotify/bridge.go
@@ -0,0 +1,114 @@
+//go:build !windows
+
+package spotify
+
+// bridge.go — how a Spotify track becomes a playlist.Track, and the YouTube
+// bridge used by web-only sessions (webonly.go).
+
+import (
+	"fmt"
+	"strings"
+
+	"cliamp/playlist"
+)
+
+const (
+	spotifyTrackPrefix = "spotify:track:"
+
+	// metaID and metaBridge are the ProviderMeta keys of a bridged track.
+	metaID     = "spotify.id"
+	metaBridge = "spotify.bridge"
+)
+
+// spotifyTrack is a track as the Web API describes it, before it is turned
+// into a playlist.Track for the session's playback mode. The provider caches
+// these, so a cached playlist follows a change of mode.
+type spotifyTrack struct {
+	id           string
+	title        string
+	artists      []string
+	album        string
+	year         int
+	durationSecs int
+	trackNumber  int
+	unplayable   bool
+
+	// fromSearch marks a /v1/search hit. Its track number is kept only when
+	// bridged: Premium search results stay as upstream builds them (without).
+	fromSearch bool
+}
+
+// track returns t as cliamp plays it: a spotify:track: URI streamed by
+// librespot, or, when webOnly, a YouTube-bridged track.
+func (t spotifyTrack) track(webOnly bool) playlist.Track {
+	if webOnly {
+		return t.bridged()
+	}
+	trackNumber := t.trackNumber
+	if t.fromSearch {
+		trackNumber = 0
+	}
+	return playlist.Track{
+		Path:         spotifyTrackPrefix + t.id,
+		Title:        t.title,
+		Artist:       strings.Join(t.artists, ", "),
+		Album:        t.album,
+		Year:         t.year,
+		Stream:       false, // must be false: true causes togglePlayPause to stop+restart instead of pause/resume
+		DurationSecs: t.durationSecs,
+		TrackNumber:  trackNumber,
+		Unplayable:   t.unplayable,
+	}
+}
+
+// bridged returns t as a yt-dlp search for "<artists> <title>" (the first
+// YouTube hit is played), keeping Spotify's metadata. Spotify's playability
+// does not apply to YouTube, so the track is never marked unplayable.
+func (t spotifyTrack) bridged() playlist.Track {
+	return playlist.Track{
+		Path:         bridgeQuery(t.artists, t.title),
+		Title:        t.title,
+		Artist:       strings.Join(t.artists, ", "),
+		Album:        t.album,
+		Year:         t.year,
+		DurationSecs: t.durationSecs,
+		TrackNumber:  t.trackNumber,
+		ProviderMeta: map[string]string{metaID: t.id, metaBridge: PlaybackYouTube},
+	}
+}
+
+// bridgeQuery builds "ytsearch1:<artists joined by space> <title>". Runs of
+// whitespace (including newlines and tabs) collapse to one space so the path
+// stays a single line; empty artist names are skipped.
+func bridgeQuery(artists []string, title string) string {
+	words := make([]string, 0, len(artists)+1)
+	for _, s := range append(artists[:len(artists):len(artists)], title) {
+		words = append(words, strings.Fields(s)...)
+	}
+	return "ytsearch1:" + strings.Join(words, " ")
+}
+
+// spotifyTrackURI returns the spotify:track: URI of t: its path, or for a
+// bridged track the id kept in ProviderMeta. Other paths are returned as is.
+func spotifyTrackURI(t playlist.Track) string {
+	if strings.HasPrefix(t.Path, spotifyTrackPrefix) {
+		return t.Path
+	}
+	if id := t.Meta(metaID); id != "" {
+		return fmt.Sprintf("%s%s", spotifyTrackPrefix, id)
+	}
+	return t.Path
+}
+
+// presentTracks converts cached Spotify tracks for the current session mode.
+func (p *SpotifyProvider) presentTracks(ts []spotifyTrack) []playlist.Track {
+	if len(ts) == 0 {
+		return nil
+	}
+	webOnly := p.webOnly()
+	out := make([]playlist.Track, len(ts))
+	for i, t := range ts {
+		out[i] = t.track(webOnly)
+	}
+	return out
+}
