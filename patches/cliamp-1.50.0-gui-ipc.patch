+	librespot "github.com/devgianlu/go-librespot"
+	librespotPlayer "github.com/devgianlu/go-librespot/player"
+	"golang.org/x/oauth2"
+)
+
+var errTestGuard = errors.New("test reached a real Spotify endpoint")
+
+// TestMain runs the package's tests with HOME in a temporary directory, so no
+// test (even one that forgets isolate) can read or write the user's
+// ~/.config/cliamp/spotify_credentials.json.
+func TestMain(m *testing.M) {
+	home, err := os.MkdirTemp("", "cliamp-spotify-test-")
+	if err != nil {
+		panic(err)
+	}
+	os.Setenv("HOME", home)
+	code := m.Run()
+	os.RemoveAll(home)
+	os.Exit(code)
+}
+
+func init() {
+	openStreamBackend = func(context.Context, string, any) (streamBackend, error) {
+		return nil, errTestGuard
+	}
+	authorizeInteractive = func(context.Context, string) (*oauth2.Token, error) {
+		return nil, errTestGuard
+	}
+	// Port 1 on loopback refuses at once.
+	oauthEndpoint = oauth2.Endpoint{
+		AuthURL:   "http://127.0.0.1:1/authorize",
+		TokenURL:  "http://127.0.0.1:1/api/token",
+		AuthStyle: oauth2.AuthStyleInParams,
+	}
+	webAPIBase = "http://127.0.0.1:1"
+}
+
+// fakeBackend is a streamBackend that stands in for a working librespot
+// session (a Premium account).
+type fakeBackend struct {
