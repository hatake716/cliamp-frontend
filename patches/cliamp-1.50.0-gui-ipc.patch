@@ -0,0 +1,234 @@
+package playlist
+
+import (
+	"slices"
+	"testing"
+)
+
+func guiTestTracks(n int) []Track {
+	out := make([]Track, n)
+	for i := range out {
+		out[i] = Track{Path: string(rune('a'+i)) + ".mp3", Title: string(rune('A' + i))}
+	}
+	return out
+}
+
+func TestGenIncrementsOnListChanges(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(p *Playlist)
+	}{
+		{"Replace", func(p *Playlist) { p.Replace(guiTestTracks(2)) }},
+		{"Add", func(p *Playlist) { p.Add(Track{Path: "x.mp3"}) }},
+		{"Remove", func(p *Playlist) { p.Remove(1) }},
+		{"Move", func(p *Playlist) { p.Move(0, 2) }},
+		{"SetTrack", func(p *Playlist) { p.SetTrack(0, Track{Path: "y.mp3"}) }},
+		{"ToggleBookmark", func(p *Playlist) { p.ToggleBookmark(0) }},
+		{"Queue", func(p *Playlist) { p.Queue(2) }},
+		{"ToggleShuffle", func(p *Playlist) { p.ToggleShuffle() }},
+		{"SetRepeat", func(p *Playlist) { p.SetRepeat(RepeatAll) }},
+		{"CycleRepeat", func(p *Playlist) { p.CycleRepeat() }},
+		{"StartAtShuffled", func(p *Playlist) { p.shuffle = true; p.StartAt(2) }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p := New()
+			p.Replace(guiTestTracks(4))
+			before := p.Gen()
+			tt.mutate(p)
+			if p.Gen() <= before {
+				t.Fatalf("Gen() = %d after %s, want > %d", p.Gen(), tt.name, before)
+			}
+		})
+	}
+}
+
+func TestGenIncrementsOnQueueChanges(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(4))
+	p.Queue(1)
+	p.Queue(2)
+	p.Queue(3)
+
+	steps := []struct {
+		name   string
+		mutate func()
+	}{
+		{"MoveQueue", func() { p.MoveQueue(0, 1) }},
+		{"MoveQueueTo", func() { p.MoveQueueTo(0, 2) }},
+		{"Dequeue", func() { p.Dequeue(3) }},
+		{"RemoveQueueAt", func() { p.RemoveQueueAt(0) }},
+		{"Next consumes queue", func() { p.Next() }},
+		{"ClearQueue", func() { p.Queue(0); p.ClearQueue() }},
+	}
+	for _, s := range steps {
+		before := p.Gen()
+		s.mutate()
+		if p.Gen() <= before {
+			t.Fatalf("Gen() did not increase after %s", s.name)
+		}
+	}
+}
+
+func TestGenUnchangedByNavigation(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(4))
+	before := p.Gen()
+
+	p.Next()
+	p.Next()
+	p.Prev()
+	p.SetIndex(3)
+	p.ActivateSelected()
+	p.PeekNext()
+	p.SetRepeat(RepeatOff) // 同じ値への設定は変化ではない
+	p.ClearQueue()         // 空の待ち行列を空にしても変化ではない
+	p.Dequeue(1)           // 入っていない曲
+	p.Remove(9)            // 範囲外
+	_ = p.QueueIndices()
+	_ = p.Upcoming(10)
+
+	if p.Gen() != before {
+		t.Fatalf("Gen() = %d, want unchanged %d", p.Gen(), before)
+	}
+}
+
+func TestEpochOnlyChangesOnReplace(t *testing.T) {
+	p := New()
+	if p.Epoch() != 0 {
+		t.Fatalf("Epoch() = %d on a new playlist, want 0", p.Epoch())
+	}
+	p.Add(guiTestTracks(3)...)
+	p.Queue(1)
+	p.ToggleShuffle()
+	if p.Epoch() != 0 {
+		t.Fatalf("Epoch() = %d after Add/Queue/Shuffle, want 0", p.Epoch())
+	}
+	p.Replace(guiTestTracks(2))
+	if p.Epoch() != 1 {
+		t.Fatalf("Epoch() = %d after Replace, want 1", p.Epoch())
+	}
+}
+
+func TestQueueIndicesIsACopy(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(3))
+	p.Queue(2)
+	p.Queue(0)
+	got := p.QueueIndices()
+	if !slices.Equal(got, []int{2, 0}) {
+		t.Fatalf("QueueIndices() = %v, want [2 0]", got)
+	}
+	got[0] = 99
+	if p.QueuePosition(2) != 1 {
+		t.Fatal("modifying QueueIndices() result changed the playlist")
+	}
+}
+
+func TestUpcomingSequential(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(5))
+	p.SetIndex(1)
+	if got := p.Upcoming(10); !slices.Equal(got, []int{2, 3, 4}) {
+		t.Fatalf("Upcoming = %v, want [2 3 4]", got)
+	}
+	if got := p.Upcoming(2); !slices.Equal(got, []int{2, 3}) {
+		t.Fatalf("Upcoming(2) = %v, want [2 3]", got)
+	}
+	if got := p.Upcoming(0); got != nil {
+		t.Fatalf("Upcoming(0) = %v, want nil", got)
+	}
+}
+
+func TestUpcomingExcludesQueuedAndUnplayable(t *testing.T) {
+	tracks := guiTestTracks(5)
+	tracks[3].Unplayable = true
+	p := New()
+	p.Replace(tracks)
+	p.Queue(2)
+	if got := p.Upcoming(10); !slices.Equal(got, []int{1, 4}) {
+		t.Fatalf("Upcoming = %v, want [1 4]", got)
+	}
+}
+
+func TestUpcomingWrapsWithRepeatAll(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(4))
+	p.SetIndex(2)
+	p.SetRepeat(RepeatAll)
+	if got := p.Upcoming(10); !slices.Equal(got, []int{3, 0, 1}) {
+		t.Fatalf("Upcoming = %v, want [3 0 1]", got)
+	}
+	// シャッフル中は回り込み先が決まっていないので出さない。
+	p.ToggleShuffle()
+	if got := p.Upcoming(10); len(got) != 3 || got[0] == 2 {
+		t.Fatalf("Upcoming (shuffle) = %v, want the 3 other tracks", got)
+	}
+}
+
+func TestUpcomingEmpty(t *testing.T) {
+	if got := New().Upcoming(5); got != nil {
+		t.Fatalf("Upcoming on empty playlist = %v, want nil", got)
+	}
+}
+
+func TestStartAtWithShuffleKeepsChosenTrackFirst(t *testing.T) {
+	for range 20 {
+		p := New()
+		p.ToggleShuffle()
+		p.Replace(guiTestTracks(8))
+		p.StartAt(5)
+		if cur, idx := p.Current(); idx != 5 || cur.Title != "F" {
+			t.Fatalf("Current() = (%q,%d), want (F,5)", cur.Title, idx)
+		}
+		rest := p.Upcoming(100)
+		if len(rest) != 7 || slices.Contains(rest, 5) {
+			t.Fatalf("Upcoming = %v, want the 7 other tracks", rest)
+		}
+		sorted := slices.Sorted(slices.Values(rest))
+		if !slices.Equal(sorted, []int{0, 1, 2, 3, 4, 6, 7}) {
+			t.Fatalf("Upcoming = %v, want each other track exactly once", rest)
+		}
+	}
+}
+
+func TestStartAtWithoutShuffle(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(4))
+	p.StartAt(2)
+	if _, idx := p.Current(); idx != 2 {
+		t.Fatalf("Current index = %d, want 2", idx)
+	}
+	if got := p.Upcoming(10); !slices.Equal(got, []int{3}) {
+		t.Fatalf("Upcoming = %v, want [3]", got)
+	}
+}
+
+func TestMoveQueueTo(t *testing.T) {
+	p := New()
+	p.Replace(guiTestTracks(5))
+	for _, i := range []int{0, 1, 2, 3} {
+		p.Queue(i)
+	}
+	if !p.MoveQueueTo(0, 3) {
+		t.Fatal("MoveQueueTo(0,3) = false")
+	}
+	if got := p.QueueIndices(); !slices.Equal(got, []int{1, 2, 3, 0}) {
+		t.Fatalf("queue = %v, want [1 2 3 0]", got)
+	}
+	if !p.MoveQueueTo(3, 1) {
+		t.Fatal("MoveQueueTo(3,1) = false")
+	}
+	if got := p.QueueIndices(); !slices.Equal(got, []int{1, 0, 2, 3}) {
+		t.Fatalf("queue = %v, want [1 0 2 3]", got)
+	}
+	before := p.Gen()
+	if !p.MoveQueueTo(2, 2) || p.Gen() != before {
+		t.Fatal("MoveQueueTo(2,2) should succeed without a change")
+	}
+	for _, c := range [][2]int{{-1, 0}, {0, 4}, {4, 0}} {
+		if p.MoveQueueTo(c[0], c[1]) {
+			t.Fatalf("MoveQueueTo(%d,%d) = true, want false", c[0], c[1])
+		}
+	}
+}
