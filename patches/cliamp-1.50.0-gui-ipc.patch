new file mode 100644
index 0000000..b20f22a
--- /dev/null
+++ b/ipc/shutdown_test.go
@@ -0,0 +1,187 @@
+package ipc
+
+import (
+	"bufio"
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+)
+
+// statusDispatcher は status にすぐ答える (daemon の Send は runDaemon が
+// 戻ったあとも答え続ける。TUI も Update が生きている間は同じ)。
+type statusDispatcher struct{}
+
+func (statusDispatcher) Send(msg any) {
+	if m, ok := msg.(StatusRequestMsg); ok {
+		m.Reply <- Response{OK: true, State: "playing"}
+	}
+}
+
+// exitedDispatcher は Bubbletea のプログラムが終わったあとの TUI: prog.Send は
+// すぐ戻り、誰も答えない。
+type exitedDispatcher struct{}
+
+func (exitedDispatcher) Send(any) {}
+
+// pollStatus は GUI (cliamp_music/client.py の _poll_loop) と同じく、1 本の
+// 接続で status を送り続ける。ok:false ("server shutting down") が返っても
+// 接続を保つ。接続が切られたら戻る。
+func pollStatus(sock string, interval time.Duration, first chan<- struct{}, done chan<- struct{}) {
+	defer close(done)
+	var once sync.Once
+	signal := func() { once.Do(func() { close(first) }) }
+	defer signal()
+	conn, err := net.Dial("unix", sock)
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+	r := bufio.NewReader(conn)
+	for {
+		if _, err := conn.Write([]byte(`{"cmd":"status"}` + "\n")); err != nil {
+			return
+		}
+		if _, err := r.ReadString('\n'); err != nil {
+			return
+		}
+		signal()
+		time.Sleep(interval)
+	}
+}
+
+// GUI が status を送り続けていても Close はすぐ戻り (TUI を q で終えたとき、
+// daemon に SIGTERM を送ったとき)、ソケットと PID ファイルを消し、GUI の
+// 接続は切れる。戻らないと cliamp が終わらず、次に起動した cliamp が
+// 「already running」で IPC 無しになる。
+func TestCloseWhileGUIPollsStatus(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		disp Dispatcher
+	}{
+		{"daemon", statusDispatcher{}},
+		{"tui exited", exitedDispatcher{}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			sock := filepath.Join(t.TempDir(), "c.sock")
+			srv, err := NewServer(sock, tt.disp)
+			if err != nil {
+				t.Fatalf("NewServer: %v", err)
+			}
+			first, pollerDone := make(chan struct{}), make(chan struct{})
+			go pollStatus(sock, 20*time.Millisecond, first, pollerDone)
+			<-first
+
+			closed := make(chan struct{})
+			go func() { _ = srv.Close(); close(closed) }()
+			select {
+			case <-closed:
+			case <-time.After(time.Second):
+				t.Fatal("Server.Close() did not return within 1s while a client kept polling status")
+			}
+			select {
+			case <-pollerDone:
+			case <-time.After(time.Second):
+				t.Fatal("the polling client's connection was not closed")
+			}
+			for _, p := range []string{sock, sock + ".pid"} {
+				if _, err := os.Stat(p); !os.IsNotExist(err) {
+					t.Errorf("%s still exists after Close (err=%v)", p, err)
+				}
+			}
+			// 次の cliamp はそのまま起動できる。
+			srv2, err := NewServer(sock, tt.disp)
+			if err != nil {
+				t.Fatalf("restart: %v", err)
+			}
+			_ = srv2.Close()
+		})
+	}
+}
+
+func TestCloseTwice(t *testing.T) {
+	srv, err := NewServer(filepath.Join(t.TempDir(), "c.sock"), statusDispatcher{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := srv.Close(); err != nil {
+		t.Fatalf("first Close: %v", err)
+	}
+	_ = srv.Close() // 2 度目も止まらず、panic しない
+}
+
+// NewServerWith で渡した設定は、受け付けを始めた直後に繋いだ接続にも
+// 見える (後から差し込むと、その間の接続は capabilities にカタログ系が
+// 載らず、GUI は繋ぎ直すまで出さない。-race でも競合しない)。
+func TestNewServerWithOptionsVisibleToFirstClient(t *testing.T) {
+	for i := range 20 {
+		sock := filepath.Join(t.TempDir(), "c.sock")
+		srv, err := NewServerWith(sock, statusDispatcher{}, Options{
+			Catalog:   &fakeCatalog{},
+			Plugins:   fakePlugins{},
+			EQPresets: []string{"Flat"},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		conn, err := net.Dial("unix", sock)
+		if err != nil {
+			t.Fatal(err)
+		}
+		conn.Write([]byte(`{"cmd":"capabilities"}` + "\n"))
+		line, err := bufio.NewReader(conn).ReadBytes('\n')
+		conn.Close()
+		srv.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		var resp Response
+		if err := json.Unmarshal(line, &resp); err != nil {
+			t.Fatal(err)
+		}
+		if !slices.Contains(resp.Commands, "providers") || !slices.Contains(resp.Commands, "plugin.call") || !slices.Equal(resp.EQPresets, []string{"Flat"}) {
+			t.Fatalf("run %d: capabilities = %+v", i, resp)
+		}
+	}
+}
+
+// blockingAfterReplyDispatcher は daemon.Send の replace / play_index / enqueue:
+// 答えを入れてから、再生の準備 (yt-dlp なら数秒) が終わるまで Send から戻らない。
+type blockingAfterReplyDispatcher struct{ hold time.Duration }
+
+func (d blockingAfterReplyDispatcher) Send(msg any) {
+	var reply chan Response
+	switch m := msg.(type) {
+	case ReplaceMsg:
+		reply = m.Reply
+	case PlayIndexMsg:
+		reply = m.Reply
+	case EnqueueMsg:
+		reply = m.Reply
+	default:
+		return
+	}
+	SendReply(reply, Response{OK: true})
+	time.Sleep(d.hold)
+}
+
+// 答えが入った時点で返す (Send が戻るのを待たない)。待つと daemon では
+// 再生の準備の間ずっと答えが返らず、GUI は成功した操作を失敗と表示する。
+func TestPlaybackCommandsAnswerBeforeSendReturns(t *testing.T) {
+	srv := newTestServer(blockingAfterReplyDispatcher{hold: 3 * time.Second})
+	for _, req := range []Request{
+		{Cmd: "replace", Tracks: []TrackInfo{{Path: "https://www.youtube.com/watch?v=x"}}},
+		{Cmd: "play_index", Index: intPtr(0)},
+		{Cmd: "enqueue", Mode: "now", Tracks: []TrackInfo{{Path: "/a.flac"}}},
+	} {
+		start := time.Now()
+		resp := srv.dispatch(req)
+		if took := time.Since(start); !resp.OK || took > time.Second {
+			t.Fatalf("%s answered %+v after %v although the dispatcher replied at once", req.Cmd, resp, took)
+		}
+	}
+}
