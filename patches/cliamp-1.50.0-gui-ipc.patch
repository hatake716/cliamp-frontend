+// 添字と一緒に送った path がいまのリストのその曲と違えば (GUI の写しが古い)、
+// 何も変えずに stale を返す。
+func TestGUIIndexCommandsRejectStalePath(t *testing.T) {
+	m, eng := newGUITestModel("a", "b", "c", "d")
+	startPlaying(&m, 0)
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.QueueEditMsg{Mode: "add", Index: 2, Reply: r} })
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.QueueEditMsg{Mode: "add", Index: 3, Reply: r} })
+	gen, calls := m.playlist.Gen(), len(eng.playCalls)
+
+	for _, build := range []func(r chan ipc.Response) tea.Msg{
+		func(r chan ipc.Response) tea.Msg { return ipc.PlayIndexMsg{Index: 1, Path: "c.flac", Reply: r} },
+		func(r chan ipc.Response) tea.Msg { return ipc.RemoveMsg{Index: 1, Path: "c.flac", Reply: r} },
+		func(r chan ipc.Response) tea.Msg {
+			return ipc.QueueEditMsg{Mode: "add", Index: 1, Path: "c.flac", Reply: r}
+		},
+		func(r chan ipc.Response) tea.Msg {
+			return ipc.QueueEditMsg{Mode: "remove", Index: 2, Path: "d.flac", Reply: r}
+		},
+		// 待ち行列 [c d] の位置 0 は c。d のつもりの move は古い。
+		func(r chan ipc.Response) tea.Msg {
+			return ipc.QueueEditMsg{Mode: "move", Index: 0, To: 1, Path: "d.flac", Reply: r}
+		},
+	} {
+		var resp ipc.Response
+		m, resp = sendGUI(t, m, build)
+		if resp.OK || resp.Error != "stale" {
+			t.Fatalf("%T = %+v, want error stale", build(nil), resp)
+		}
+	}
+	if m.playlist.Gen() != gen || len(eng.playCalls) != calls || !slices.Equal(m.playlist.QueueIndices(), []int{2, 3}) {
+		t.Fatal("a stale request changed the list")
+	}
+
+	// 合っていれば (または path を送らなければ) これまでどおり。
+	m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.QueueEditMsg{Mode: "move", Index: 1, To: 0, Path: "d.flac", Reply: r}
+	})
+	if !resp.OK || !slices.Equal(resp.Queue, []int{3, 2}) {
+		t.Fatalf("move with the right path = %+v", resp)
+	}
+	m, resp = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.PlayIndexMsg{Index: 1, Path: "b.flac", Reply: r} })
+	if cur, _ := m.playlist.Current(); !resp.OK || cur.Title != "b" {
+		t.Fatalf("play_index with the right path = %+v current=%q", resp, cur.Title)
+	}
+}
