+func TestPlaylistSnapshot(t *testing.T) {
+	pl := playlist.New()
+	pl.Replace([]playlist.Track{{Path: "/a"}, {Path: "/b"}, {Path: "/c"}, {Path: "/d"}})
+	pl.SetIndex(1)
+	pl.Queue(3)
+	pl.Queue(0)
+
+	resp := PlaylistSnapshot(pl, 0)
+	if !resp.OK || resp.Total != 4 || resp.Index != 1 || len(resp.Tracks) != 4 {
+		t.Fatalf("snapshot = %+v", resp)
+	}
+	if !slices.Equal(resp.Queue, []int{3, 0}) || !slices.Equal(resp.UpNext, []int{2}) {
+		t.Fatalf("queue=%v up_next=%v, want [3 0] and [2]", resp.Queue, resp.UpNext)
+	}
+	if resp.Tracks[3].Queued != 1 || resp.Tracks[0].Queued != 2 || resp.Tracks[2].Queued != 0 {
+		t.Fatalf("queued = %d,%d,%d", resp.Tracks[3].Queued, resp.Tracks[0].Queued, resp.Tracks[2].Queued)
+	}
+	if resp.Gen != pl.Gen() || resp.Gen == 0 {
+		t.Fatalf("gen = %d, want %d", resp.Gen, pl.Gen())
+	}
+
+	if resp := PlaylistSnapshot(pl, 2); len(resp.Tracks) != 2 || resp.Total != 4 {
+		t.Fatalf("limit 2: %d tracks, total %d", len(resp.Tracks), resp.Total)
+	}
+	if resp := PlaylistSnapshot(playlist.New(), 0); !resp.OK || resp.Total != 0 || resp.Index != -1 || resp.Tracks != nil {
+		t.Fatalf("empty snapshot = %+v", resp)
+	}
+}
