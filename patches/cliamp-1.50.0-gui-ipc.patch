+func TestDispatchReplace(t *testing.T) {
+	disp := &captureDispatcher{autoReply: Response{OK: true, Total: 2, Gen: 3}}
+	s := newGUITestServer(disp, nil)
+
+	resp := s.dispatch(Request{
+		Cmd: "replace",
+		Tracks: []TrackInfo{
+			{Path: "https://www.youtube.com/watch?v=abc", Title: "YT"},
+			{Path: "https://radio.example/stream", Title: "Radio", Live: true},
+		},
+		Index:  intPtr(1),
+		Source: &SourceInfo{Provider: "radio", ID: "l:0", Name: "cliamp radio"},
+	})
+	if !resp.OK || resp.Total != 2 || resp.Gen != 3 {
+		t.Fatalf("replace = %+v", resp)
+	}
+	got, ok := disp.last.(ReplaceMsg)
+	if !ok {
+		t.Fatalf("sent %T, want ReplaceMsg", disp.last)
+	}
+	if got.Index != 1 || got.Source.Name != "cliamp radio" || len(got.Tracks) != 2 {
+		t.Fatalf("ReplaceMsg = %+v", got)
+	}
+	// yt-dlp で鳴らす曲はそのまま、ただの http の流れは stream を立てる。
+	if got.Tracks[0].Stream {
+		t.Error("YouTube track got Stream=true, want untouched")
+	}
+	if !got.Tracks[1].Stream || !got.Tracks[1].Realtime {
+		t.Errorf("radio track = %+v, want Stream and Realtime", got.Tracks[1])
+	}
+
+	// index の既定は 0。
+	s.dispatch(Request{Cmd: "replace", Tracks: []TrackInfo{{Path: "/a.flac"}}})
+	if got := disp.last.(ReplaceMsg); got.Index != 0 || got.Source != (SourceInfo{}) {
+		t.Fatalf("default ReplaceMsg = %+v", got)
+	}
+}
