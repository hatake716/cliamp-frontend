diff --git a/ipc/gui.go b/ipc/gui.go
new file mode 100644
index 0000000..b8eea85
--- /dev/null
+++ b/ipc/gui.go
@@ -0,0 +1,683 @@
+package ipc
+
+// gui.go — GUI フロントエンド向けの拡張コマンド (api 1)。
+//
+// 既存のコマンドと応答の形は変えず、足すだけにしてある。コマンドは 2 系統:
+//
+//   - 状態系 (seek_to, playlist, play_index, replace, enqueue, queue_edit,
+//     remove): Dispatcher (TUI の Update、または daemon の Send) へ送り、
+//     容量 1 の Reply で 1 回だけ答えを受ける。I/O はしない。
+//   - カタログ系 (providers, playlists, tracks, search, load_provider, lyrics,
+//     history, playlist_*): 接続ごとの goroutine で Catalog を呼ぶ。ネットワークや
+//     yt-dlp を待つので Update を通さない (通すと TUI が固まる)。
+//
+// capabilities はサーバーだけで答える。
+
+import (
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"cliamp/internal/playback"
+	"cliamp/playlist"
+)
+
+// APIVersion は拡張 IPC の版。capabilities と status の api で返す。
+const APIVersion = 1
+
+// MaxRequestBytes は要求 1 行の上限。replace で曲の一覧を送るため、
+// bufio.Scanner の既定 (64 KiB) から広げてある。
+const MaxRequestBytes = 8 << 20
+
+// catalogTimeout はカタログ系 1 要求の待ち時間の上限。ytmusic の Tracks は
+// 内部で 5 分待つことがあるが、GUI を待たせすぎないようここで切る。
+// 試験で短くするため変数にしてある。
+var catalogTimeout = 120 * time.Second
+
+// upNextLimit は playlist の up_next に載せる曲の上限。
+const upNextLimit = 200
+
+// ErrNotFound は Catalog.Lyrics が歌詞を見つけられなかったときに返す。
+// 応答の error は "not found" になる。
+var ErrNotFound = errors.New("not found")
+
+// ErrStale は、添字で指した曲が要求の path と違う (GUI の写しが古い) ときに
+// 返す。応答の error は "stale" になる。何も変えずに断るので、GUI はリストを
+// 取り直してから選び直す。
+var ErrStale = errors.New("stale")
+
+// PathMismatch は、要求の path (want) が空でなく、添字の曲の path と違うかを
+// 返す。JSON は UTF-8 でないバイトを U+FFFD に置き換えて運ぶので、同じ置き換えを
+// してから比べる。
+func PathMismatch(trackPath, want string) bool {
+	return want != "" && strings.ToValidUTF8(trackPath, "\uFFFD") != want
+}
+
+// SourceInfo はいま読み込まれているリストの出どころ。
+type SourceInfo struct {
+	Provider string `json:"provider,omitempty"`
+	ID       string `json:"id,omitempty"`
+	Name     string `json:"name,omitempty"`
+}
+
+// ProviderInfo は providers の応答の 1 件。真偽は false でも省かない。
+// Playback は、曲を別の所から鳴らしているときだけその名前 (Spotify の
+// Web API だけの接続なら "youtube")。ふつうは省く。
+type ProviderInfo struct {
+	Key       string `json:"key"`
+	Name      string `json:"name"`
+	Search    bool   `json:"search"`
+	Playlists bool   `json:"playlists"`
+	Virtual   bool   `json:"virtual"`
+	Playback  string `json:"playback,omitempty"`
+}
+
+// PlaylistInfo は playlist.PlaylistInfo の JSON 形。
+type PlaylistInfo struct {
+	ID         string `json:"id"`
+	Name       string `json:"name"`
+	TrackCount int    `json:"track_count,omitempty"`
+	Duration   int    `json:"duration,omitempty"`
+	Section    string `json:"section,omitempty"`
+}
+
+// LyricLine は歌詞の 1 行。T は秒 (同期していない歌詞は全行 0)。
+// 0 でも省かない。
+type LyricLine struct {
+	T    float64 `json:"t"`
+	Text string  `json:"text"`
+}
+
+// Catalog はカタログ系コマンドの実装 (main パッケージの catalog.go)。
+// どのメソッドも IPC の接続の goroutine から呼ばれ、Update は通らない。
+// 並行して呼ばれうるので、共有する状態は実装側で守ること。
+type Catalog interface {
+	Providers() []ProviderInfo
+	Playlists(provider string) ([]playlist.PlaylistInfo, error)
+	Tracks(provider, id string) ([]playlist.Track, error)
+	Search(provider, query string, limit int) ([]playlist.Track, error)
+	Lyrics(artist, title string) (lines []LyricLine, synced bool, err error)
+	History(limit int) ([]TrackInfo, error)
+	PlaylistAdd(name string, tracks []playlist.Track) error
+	PlaylistDelete(name string) error
+	// PlaylistRemoveTrack は index の曲を消す。path が空でなく、その曲の path と
+	// 違えば何もせずに ErrStale を返す。
+	PlaylistRemoveTrack(name string, index int, path string) error
+}
+
+// Options は NewServerWith に渡す、受け付けを始める前に決めておく設定。
+// 受け付けを始めてから差し込むと、その間に繋いだ接続が差し込む前の値を
+// 読む (capabilities にカタログ系が載らず、GUI は繋ぎ直すまで出さない)。
+type Options struct {
+	// Plugins は Lua プラグインのコマンド (無ければ nil。型付きの nil を
+	// 入れないこと)。
+	Plugins PluginDispatcher
+	// Catalog はカタログ系コマンドの実装。無ければカタログ系は
+	// "catalog not enabled" を返す。
+	Catalog Catalog
+	// EQPresets は capabilities で返す組み込み EQ プリセットの名前 (表示順)。
+	// ui/model を import すると循環するため、外から渡す。
+	EQPresets []string
+}
+
+func (s *Server) applyOptions(o Options) {
+	s.plugins = o.Plugins
+	s.catalog = o.Catalog
+	s.eqPresets = slices.Clone(o.EQPresets)
+}
+
+// 状態系の要求。どれも Reply は容量 1 で、処理側は必ず 1 回だけ答える
+// (SendReply を使う)。
+
+// PlaylistRequestMsg はいまのリストの写しを求める。Limit 0 は全件。
+type PlaylistRequestMsg struct {
+	Limit int
+	Reply chan Response
+}
+
+// PlayIndexMsg はリスト上の添字 Index の曲を再生する (TUI の行で Enter)。
+// Path が空でなければ、Index の曲がその path でないとき ErrStale で断る。
+type PlayIndexMsg struct {
+	Index int
+	Path  string
+	Reply chan Response
+}
+
+// ReplaceMsg はリストを Tracks に差し替えて Index の曲から再生する。
+type ReplaceMsg struct {
+	Tracks []playlist.Track
+	Index  int
+	Source SourceInfo
+	Reply  chan Response
+}
+
+// EnqueueMsg は曲を足す。Mode は "next" / "end" / "now"。
+type EnqueueMsg struct {
+	Tracks []playlist.Track
+	Mode   string
+	Reply  chan Response
+}
+
+// QueueEditMsg は「次に再生」の待ち行列を編集する。Mode は
+// "add" / "remove" (Index はリスト上の添字)、"move" (Index と To は
+// 待ち行列の位置)、"clear"。Path が空でなければ、add/remove では Index の曲、
+// move では待ち行列の位置 Index の曲がその path でないとき ErrStale で断る。
+type QueueEditMsg struct {
+	Mode  string
+	Index int
+	To    int
+	Path  string
+	Reply chan Response
+}
+
+// RemoveMsg はリストから添字 Index の曲を消す。Path は PlayIndexMsg と同じ。
+type RemoveMsg struct {
+	Index int
+	Path  string
+	Reply chan Response
+}
+
+// SendReply は ch へ resp を 1 回送る。ch が nil か、すでに答えが入って
+// いれば捨てる (2 回目で Update を止めないため)。
+func SendReply(ch chan Response, resp Response) {
+	if ch == nil {
+		return
+	}
+	select {
+	case ch <- resp:
+	default:
+	}
+}
+
+// NewTrackInfo は playlist.Track を IPC の形にする。path が UTF-8 でなければ
+// (Windows の zip から出した Shift_JIS の名前など)、JSON で壊れないよう元の
+// バイト列を path_raw に base64 で入れ、path は表示用に置き換えた文字列にする。
+func NewTrackInfo(t playlist.Track) TrackInfo {
+	ti := TrackInfo{
+		Title:       t.Title,
+		Artist:      t.Artist,
+		Path:        t.Path,
+		Album:       t.Album,
+		Genre:       t.Genre,
+		Year:        t.Year,
+		TrackNumber: t.TrackNumber,
+		Duration:    t.DurationSecs,
+		Stream:      t.Stream,
+		Live:        t.Realtime,
+		Feed:        t.Feed,
+		Unplayable:  t.Unplayable,
+		Bookmark:    t.Bookmark,
+	}
+	if len(t.ProviderMeta) > 0 {
+		ti.Meta = maps.Clone(t.ProviderMeta)
+	}
+	if !utf8.ValidString(t.Path) {
+		ti.PathRaw = base64.StdEncoding.EncodeToString([]byte(t.Path))
+		ti.Path = strings.ToValidUTF8(t.Path, "\uFFFD")
+	}
+	return ti
+}
+
+// trackPath は path_raw があればそれを戻したもの、無ければ path を返す。
+func (ti TrackInfo) trackPath() (string, error) {
+	if ti.PathRaw == "" {
+		return ti.Path, nil
+	}
+	raw, err := base64.StdEncoding.DecodeString(ti.PathRaw)
+	if err != nil {
+		return "", err
+	}
+	return string(raw), nil
+}
+
+// ToTrack は NewTrackInfo の逆。Queued と PlayedAt は捨てる。path_raw が
+// 壊れていれば path をそのまま使う (受け付けるかどうかは tracksFromRequest が
+// 先に見る)。
+func (ti TrackInfo) ToTrack() playlist.Track {
+	path, err := ti.trackPath()
+	if err != nil {
+		path = ti.Path
+	}
+	t := playlist.Track{
+		Path:         path,
+		Title:        ti.Title,
+		Artist:       ti.Artist,
+		Album:        ti.Album,
+		Genre:        ti.Genre,
+		Year:         ti.Year,
+		TrackNumber:  ti.TrackNumber,
+		DurationSecs: ti.Duration,
+		Stream:       ti.Stream,
+		Realtime:     ti.Live,
+		Feed:         ti.Feed,
+		Unplayable:   ti.Unplayable,
+		Bookmark:     ti.Bookmark,
+	}
+	if len(ti.Meta) > 0 {
+		t.ProviderMeta = maps.Clone(ti.Meta)
+	}
+	return t
+}
+
+// NewTrackInfos は曲の並びをまとめて IPC の形にする。
+func NewTrackInfos(tracks []playlist.Track) []TrackInfo {
+	if len(tracks) == 0 {
+		return nil
+	}
+	out := make([]TrackInfo, len(tracks))
+	for i, t := range tracks {
+		out[i] = NewTrackInfo(t)
+	}
+	return out
+}
+
+// newPlaylistInfos は playlist.PlaylistInfo を IPC の形にする。
+func newPlaylistInfos(lists []playlist.PlaylistInfo) []PlaylistInfo {
+	if len(lists) == 0 {
+		return nil
+	}
+	out := make([]PlaylistInfo, len(lists))
+	for i, p := range lists {
+		out[i] = PlaylistInfo{
+			ID:         p.ID,
+			Name:       p.Name,
+			TrackCount: p.TrackCount,
+			Duration:   p.DurationSecs,
+			Section:    p.Section,
+		}
+	}
+	return out
+}
+
+// tracksFromRequest は GUI から来た曲を playlist.Track にする。path の無い曲と
+// path_raw の壊れた曲は受け付けない。http(s) の URL で yt-dlp で再生しないものは
+// stream を立てる (立っていないと TUI が Update の中で同期的に HTTP を開き、
+// 固まるため)。
+func tracksFromRequest(in []TrackInfo) ([]playlist.Track, error) {
+	out := make([]playlist.Track, 0, len(in))
+	for i, ti := range in {
+		path, err := ti.trackPath()
+		if err != nil {
+			return nil, fmt.Errorf("track %d has a bad path_raw", i)
+		}
+		if strings.TrimSpace(path) == "" {
+			return nil, fmt.Errorf("track %d has no path", i)
+		}
+		t := ti.ToTrack()
+		if !t.Stream && playlist.IsURL(t.Path) && !playlist.IsYTDL(t.Path) {
+			t.Stream = true
+		}
+		out = append(out, t)
+	}
+	return out, nil
+}
+
+// PlaylistSnapshot は playlist 要求の応答を組み立てる (TUI と daemon で共用)。
+// source は呼ぶ側が足す。
+func PlaylistSnapshot(pl *playlist.Playlist, limit int) Response {
+	tracks := pl.Tracks()
+	if limit > 0 && limit < len(tracks) {
+		tracks = tracks[:limit]
+	}
+	queue := pl.QueueIndices()
+	queuedAt := make(map[int]int, len(queue))
+	for i, idx := range queue {
+		queuedAt[idx] = i + 1
+	}
+	infos := NewTrackInfos(tracks)
+	for i := range infos {
+		infos[i].Queued = queuedAt[i]
+	}
+	return Response{
+		OK:     true,
+		Tracks: infos,
+		Index:  pl.Index(),
+		Total:  pl.Len(),
+		Queue:  queue,
+		UpNext: pl.Upcoming(upNextLimit),
+		Gen:    pl.Gen(),
+	}
+}
+
+// 既存のコマンド (server.go の dispatch)。capabilities の commands に載せる。
+var baseCommands = []string{
+	"play", "pause", "toggle", "stop", "next", "prev", "volume", "seek",
+	"load", "queue", "theme", "vis", "shuffle", "repeat", "mono", "speed",
+	"eq", "device", "status", "bands",
+}
+
+var pluginCommands = []string{"plugin.call", "plugin.commands"}
+
+var guiStateCommands = []string{
+	"capabilities", "seek_to", "playlist", "play_index", "replace",
+	"enqueue", "queue_edit", "remove",
+}
+
+var guiCatalogCommands = []string{
+	"providers", "playlists", "tracks", "search", "load_provider", "lyrics",
+	"history", "playlist_add", "playlist_delete", "playlist_remove_track",
+}
+
+// commandNames はこのサーバーが受け付けるコマンドの一覧。差し込まれて
+// いない機能 (プラグイン、カタログ) のコマンドは載せない。
+func (s *Server) commandNames() []string {
+	out := append([]string(nil), baseCommands...)
+	if s.plugins != nil {
+		out = append(out, pluginCommands...)
+	}
+	out = append(out, guiStateCommands...)
+	if s.catalog != nil {
+		out = append(out, guiCatalogCommands...)
+	}
+	return out
+}
+
+// dispatchGUI は拡張コマンドを処理する。知らないコマンドなら ok=false。
+func (s *Server) dispatchGUI(req Request) (Response, bool) {
+	switch strings.ToLower(req.Cmd) {
+	case "capabilities":
+		return Response{
+			OK:        true,
+			API:       APIVersion,
+			Commands:  s.commandNames(),
+			EQPresets: append([]string(nil), s.eqPresets...),
+		}, true
+
+	case "seek_to":
+		if req.Value < 0 {
+			return Response{OK: false, Error: "seek_to requires a non-negative position"}, true
+		}
+		// TUI では非同期の seekAbsolute に回り、yt-dlp の曲でも Update を止めない。
+		s.disp.Send(playback.SetPositionMsg{Position: time.Duration(req.Value * float64(time.Second))})
+		return Response{OK: true}, true
+
+	case "playlist":
+		reply := make(chan Response, 1)
+		s.disp.Send(PlaylistRequestMsg{Limit: max(req.Limit, 0), Reply: reply})
+		return waitReply(reply, s.done), true
+
+	case "play_index":
+		if req.Index == nil {
+			return Response{OK: false, Error: "play_index requires an index"}, true
+		}
+		reply := make(chan Response, 1)
+		return s.sendAndWait(PlayIndexMsg{Index: *req.Index, Path: req.Path, Reply: reply}, reply), true
+
+	case "replace":
+		tracks, err := tracksFromRequest(req.Tracks)
+		if err != nil {
+			return Response{OK: false, Error: "replace: " + err.Error()}, true
+		}
+		if len(tracks) == 0 {
+			return Response{OK: false, Error: "replace requires tracks"}, true
+		}
+		start := 0
+		if req.Index != nil {
+			start = *req.Index
+		}
+		if start < 0 || start >= len(tracks) {
+			return Response{OK: false, Error: "index out of range"}, true
+		}
+		var src SourceInfo
+		if req.Source != nil {
+			src = *req.Source
+		}
+		return s.replace(tracks, start, src), true
+
+	case "enqueue":
+		tracks, err := tracksFromRequest(req.Tracks)
+		if err != nil {
+			return Response{OK: false, Error: "enqueue: " + err.Error()}, true
+		}
+		if len(tracks) == 0 {
+			return Response{OK: false, Error: "enqueue requires tracks"}, true
+		}
+		mode := strings.ToLower(req.Mode)
+		switch mode {
+		case "":
+			mode = "next"
+		case "next", "end", "now":
+		default:
+			return Response{OK: false, Error: fmt.Sprintf("enqueue: unknown mode %q", req.Mode)}, true
+		}
+		reply := make(chan Response, 1)
+		return s.sendAndWait(EnqueueMsg{Tracks: tracks, Mode: mode, Reply: reply}, reply), true
+
+	case "queue_edit":
+		msg := QueueEditMsg{Mode: strings.ToLower(req.Mode), Index: -1, To: -1, Path: req.Path}
+		switch msg.Mode {
+		case "add", "remove":
+			if req.Index == nil {
+				return Response{OK: false, Error: "queue_edit " + msg.Mode + " requires an index"}, true
+			}
+			msg.Index = *req.Index
+		case "move":
+			if req.Index == nil || req.To == nil {
+				return Response{OK: false, Error: "queue_edit move requires index and to"}, true
+			}
+			msg.Index, msg.To = *req.Index, *req.To
+		case "clear":
+		default:
+			return Response{OK: false, Error: fmt.Sprintf("queue_edit: unknown mode %q", req.Mode)}, true
+		}
+		msg.Reply = make(chan Response, 1)
+		s.disp.Send(msg)
+		return waitReply(msg.Reply, s.done), true
+
+	case "remove":
+		if req.Index == nil {
+			return Response{OK: false, Error: "remove requires an index"}, true
+		}
+		reply := make(chan Response, 1)
+		s.disp.Send(RemoveMsg{Index: *req.Index, Path: req.Path, Reply: reply})
+		return waitReply(reply, s.done), true
+
+	case "providers":
+		return s.runCatalog(func(c Catalog) Response {
+			return Response{OK: true, Providers: c.Providers()}
+		}), true
+
+	case "playlists":
+		if req.Provider == "" {
+			return Response{OK: false, Error: "playlists requires a provider"}, true
+		}
+		return s.runCatalog(func(c Catalog) Response {
+			lists, err := c.Playlists(req.Provider)
+			if err != nil {
+				return catalogError(err)
+			}
+			return Response{OK: true, Playlists: newPlaylistInfos(lists)}
+		}), true
+
+	case "tracks":
+		if req.Provider == "" || req.ID == "" {
+			return Response{OK: false, Error: "tracks requires a provider and an id"}, true
+		}
+		return s.runCatalog(func(c Catalog) Response {
+			tracks, err := c.Tracks(req.Provider, req.ID)
+			if err != nil {
+				return catalogError(err)
+			}
+			return Response{OK: true, Tracks: NewTrackInfos(tracks)}
+		}), true
+
+	case "search":
+		query := strings.TrimSpace(req.Query)
+		if query == "" {
+			return Response{OK: false, Error: "search requires a query"}, true
+		}
+		limit := req.Limit
+		if limit <= 0 {
+			limit = 25
+		}
+		limit = min(limit, 50)
+		return s.runCatalog(func(c Catalog) Response {
+			tracks, err := c.Search(req.Provider, query, limit)
+			if err != nil {
+				return catalogError(err)
+			}
+			if len(tracks) > limit {
+				tracks = tracks[:limit]
+			}
+			return Response{OK: true, Tracks: NewTrackInfos(tracks)}
+		}), true
+
+	case "load_provider":
+		if req.Provider == "" || req.ID == "" {
+			return Response{OK: false, Error: "load_provider requires a provider and an id"}, true
+		}
+		start := 0
+		if req.Index != nil {
+			start = *req.Index
+		}
+		resp := s.runCatalog(func(c Catalog) Response {
+			tracks, err := c.Tracks(req.Provider, req.ID)
+			if err != nil {
+				return catalogError(err)
+			}
+			if len(tracks) == 0 {
+				return Response{OK: false, Error: "no tracks"}
+			}
+			if start < 0 || start >= len(tracks) {
+				return Response{OK: false, Error: "index out of range"}
+			}
+			return Response{OK: true, Tracks: NewTrackInfos(tracks)}
+		})
+		if !resp.OK {
+			return resp, true
+		}
+		tracks := make([]playlist.Track, len(resp.Tracks))
+		for i, ti := range resp.Tracks {
+			tracks[i] = ti.ToTrack()
+		}
+		return s.replace(tracks, start, SourceInfo{Provider: req.Provider, ID: req.ID, Name: req.Name}), true
+
+	case "lyrics":
+		if strings.TrimSpace(req.Artist) == "" && strings.TrimSpace(req.Title) == "" {
+			return Response{OK: false, Error: "lyrics requires an artist or a title"}, true
+		}
+		return s.runCatalog(func(c Catalog) Response {
+			lines, synced, err := c.Lyrics(req.Artist, req.Title)
+			if err != nil {
+				return catalogError(err)
+			}
+			if len(lines) == 0 {
+				return Response{OK: false, Error: ErrNotFound.Error()}
+			}
+			return Response{OK: true, Lyrics: lines, Synced: &synced}
+		}), true
+
+	case "history":
+		limit := req.Limit
+		if limit <= 0 {
+			limit = 50
+		}
+		return s.runCatalog(func(c Catalog) Response {
+			tracks, err := c.History(limit)
+			if err != nil {
+				return catalogError(err)
+			}
+			return Response{OK: true, Tracks: tracks}
+		}), true
+
+	case "playlist_add":
+		if req.Name == "" {
+			return Response{OK: false, Error: "playlist_add requires a name"}, true
+		}
+		tracks, err := tracksFromRequest(req.Tracks)
+		if err != nil {
+			return Response{OK: false, Error: "playlist_add: " + err.Error()}, true
+		}
+		if len(tracks) == 0 {
+			return Response{OK: false, Error: "playlist_add requires tracks"}, true
+		}
+		return s.runCatalog(func(c Catalog) Response {
+			if err := c.PlaylistAdd(req.Name, tracks); err != nil {
+				return catalogError(err)
+			}
+			return Response{OK: true}
+		}), true
+
+	case "playlist_delete":
+		if req.Name == "" {
+			return Response{OK: false, Error: "playlist_delete requires a name"}, true
+		}
+		return s.runCatalog(func(c Catalog) Response {
+			if err := c.PlaylistDelete(req.Name); err != nil {
+				return catalogError(err)
+			}
+			return Response{OK: true}
+		}), true
+
+	case "playlist_remove_track":
+		if req.Name == "" || req.Index == nil {
+			return Response{OK: false, Error: "playlist_remove_track requires a name and an index"}, true
+		}
+		index := *req.Index
+		return s.runCatalog(func(c Catalog) Response {
+			if err := c.PlaylistRemoveTrack(req.Name, index, req.Path); err != nil {
+				return catalogError(err)
+			}
+			return Response{OK: true}
+		}), true
+	}
+	return Response{}, false
+}
+
+// replace は ReplaceMsg を送り、答えを待つ (replace と load_provider で共用)。
+func (s *Server) replace(tracks []playlist.Track, start int, src SourceInfo) Response {
+	reply := make(chan Response, 1)
+	return s.sendAndWait(ReplaceMsg{Tracks: tracks, Index: start, Source: src, Reply: reply}, reply)
+}
+
+// sendAndWait は再生を始めうる要求 (play_index, replace, enqueue) を送り、
+// 答えを待つ。daemon の Send は答えを入れたあとも再生の準備 (yt-dlp なら
+// 数秒) が終わるまで戻らないので、Send を別の goroutine で呼び、答えが
+// 入った時点で返す (Send が戻るのを待つと 3 秒の上限が効かず、GUI は
+// 成功した操作を失敗と表示する)。答えは状態を変えたあとに入るので、同じ
+// 接続の次の要求はその変更を見る。
+func (s *Server) sendAndWait(msg any, reply chan Response) Response {
+	go s.disp.Send(msg)
+	return waitReply(reply, s.done)
+}
+
+// runCatalog は fn を別の goroutine で走らせ、catalogTimeout まで待つ。
+// プロバイダーの不具合で panic しても、プレイヤーごと落とさずに error で返す。
+func (s *Server) runCatalog(fn func(Catalog) Response) Response {
+	c := s.catalog
+	if c == nil {
+		return Response{OK: false, Error: "catalog not enabled"}
+	}
+	ch := make(chan Response, 1)
+	go func() {
+		defer func() {
+			if r := recover(); r != nil {
+				ch <- Response{OK: false, Error: fmt.Sprintf("internal error: %v", r)}
+			}
+		}()
+		ch <- fn(c)
+	}()
+	select {
+	case resp := <-ch:
+		return resp
+	case <-time.After(catalogTimeout):
+		return Response{OK: false, Error: "timeout"}
+	case <-s.done:
+		return Response{OK: false, Error: "server shutting down"}
+	}
+}
+
+// catalogError はカタログの失敗を応答にする。サインインが要るときは
+// needs_auth を立てる (ブラウザでのサインインは IPC からは始めない)。
+func catalogError(err error) Response {
+	return Response{
+		OK:        false,
+		Error:     err.Error(),
+		NeedsAuth: errors.Is(err, playlist.ErrNeedsAuth),
+	}
+}
diff --git a/ipc/gui_client_test.go b/ipc/gui_client_test.go
new file mode 100644
index 0000000..49de082
--- /dev/null
+++ b/ipc/gui_client_test.go
@@ -0,0 +1,127 @@
+package ipc
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"net"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestSendLargeReplaceRoundTrip は 64 KiB (bufio.Scanner の既定の上限) を
+// 超える replace が本物のソケットを通って届くことを確かめる。
+func TestSendLargeReplaceRoundTrip(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "cliamp.sock")
+	disp := &captureDispatcher{autoReply: Response{OK: true, Total: 2000, Gen: 1}}
+	srv, err := NewServer(sock, disp)
+	if err != nil {
+		t.Fatalf("NewServer: %v", err)
+	}
+	t.Cleanup(func() { _ = srv.Close() })
+
+	tracks := make([]TrackInfo, 2000)
+	for i := range tracks {
+		tracks[i] = TrackInfo{
+			Path:   fmt.Sprintf("https://www.youtube.com/watch?v=%011d", i),
+			Title:  strings.Repeat("長い曲名", 8),
+			Artist: "Artist",
+			Meta:   map[string]string{"k": "v"},
+		}
+	}
+	req := Request{Cmd: "replace", Tracks: tracks, Index: intPtr(1999)}
+	if data, _ := json.Marshal(req); len(data) < 256*1024 {
+		t.Fatalf("request is only %d bytes, want > 256 KiB", len(data))
+	}
+
+	resp, err := Send(sock, req)
+	if err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+	if !resp.OK || resp.Total != 2000 {
+		t.Fatalf("resp = %+v", resp)
+	}
+	got, ok := disp.last.(ReplaceMsg)
+	if !ok || len(got.Tracks) != 2000 || got.Index != 1999 {
+		t.Fatalf("server received %T with %d tracks", disp.last, len(got.Tracks))
+	}
+}
+
+// TestSendLargeResponse は playlist のような 64 KiB を超える応答を Go の
+// クライアント (cliamp の CLI) が読めることを確かめる。
+func TestSendLargeResponse(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "cliamp.sock")
+	big := make([]TrackInfo, 3000)
+	for i := range big {
+		big[i] = TrackInfo{Path: fmt.Sprintf("/music/%05d-%s.flac", i, strings.Repeat("x", 40))}
+	}
+	disp := &captureDispatcher{autoReply: Response{OK: true, Tracks: big, Total: len(big)}}
+	srv, err := NewServer(sock, disp)
+	if err != nil {
+		t.Fatalf("NewServer: %v", err)
+	}
+	t.Cleanup(func() { _ = srv.Close() })
+
+	resp, err := Send(sock, Request{Cmd: "playlist"})
+	if err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+	if len(resp.Tracks) != 3000 {
+		t.Fatalf("got %d tracks, want 3000", len(resp.Tracks))
+	}
+}
+
+// TestRequestTooLarge は上限 (8 MiB) を超えた要求に理由を返して閉じることを確かめる。
+func TestRequestTooLarge(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "cliamp.sock")
+	srv, err := NewServer(sock, &captureDispatcher{})
+	if err != nil {
+		t.Fatalf("NewServer: %v", err)
+	}
+	t.Cleanup(func() { _ = srv.Close() })
+
+	conn, err := net.Dial("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(10 * time.Second))
+
+	go func() {
+		payload := `{"cmd":"replace","tracks":[{"path":"` + strings.Repeat("a", MaxRequestBytes+1024) + `"}]}` + "\n"
+		_, _ = conn.Write([]byte(payload)) // サーバーが閉じると途中で失敗する
+	}()
+
+	line, err := bufio.NewReader(conn).ReadString('\n')
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	var resp Response
+	if err := json.Unmarshal([]byte(line), &resp); err != nil {
+		t.Fatalf("unmarshal %q: %v", line, err)
+	}
+	if resp.OK || resp.Error != "request too large" {
+		t.Fatalf("resp = %+v", resp)
+	}
+}
+
+// TestCapabilitiesOverSocket は拡張の有無の判定に使う capabilities が
+// 本物のソケットで答えることを確かめる。
+func TestCapabilitiesOverSocket(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "cliamp.sock")
+	srv, err := NewServerWith(sock, &captureDispatcher{}, Options{EQPresets: []string{"Flat"}})
+	if err != nil {
+		t.Fatalf("NewServerWith: %v", err)
+	}
+	t.Cleanup(func() { _ = srv.Close() })
+
+	resp, err := Send(sock, Request{Cmd: "capabilities"})
+	if err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+	if !resp.OK || resp.API != APIVersion || len(resp.Commands) == 0 || resp.EQPresets[0] != "Flat" {
+		t.Fatalf("resp = %+v", resp)
+	}
+}
diff --git a/ipc/gui_test.go b/ipc/gui_test.go
new file mode 100644
index 0000000..24007c9
--- /dev/null
+++ b/ipc/gui_test.go
@@ -0,0 +1,796 @@
+package ipc
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"cliamp/internal/playback"
+	"cliamp/playlist"
+)
+
+func intPtr(i int) *int { return &i }
+
+// fakeCatalog は Catalog の試験用の実装。呼ばれた引数を覚えておく。
+type fakeCatalog struct {
+	providers []ProviderInfo
+	lists     []playlist.PlaylistInfo
+	tracks    []playlist.Track
+	lyrics    []LyricLine
+	synced    bool
+	history   []TrackInfo
+	err       error
+	block     chan struct{} // 閉じられるまで Tracks を待たせる
+	panicMsg  string
+
+	gotProvider, gotID, gotQuery, gotName, gotPath string
+	gotLimit, gotIndex                             int
+	gotTracks                                      []playlist.Track
+	calls                                          []string
+}
+
+func (f *fakeCatalog) Providers() []ProviderInfo {
+	f.calls = append(f.calls, "providers")
+	return f.providers
+}
+
+func (f *fakeCatalog) Playlists(provider string) ([]playlist.PlaylistInfo, error) {
+	f.calls = append(f.calls, "playlists")
+	f.gotProvider = provider
+	return f.lists, f.err
+}
+
+func (f *fakeCatalog) Tracks(provider, id string) ([]playlist.Track, error) {
+	f.calls = append(f.calls, "tracks")
+	f.gotProvider, f.gotID = provider, id
+	if f.panicMsg != "" {
+		panic(f.panicMsg)
+	}
+	if f.block != nil {
+		<-f.block
+	}
+	return f.tracks, f.err
+}
+
+func (f *fakeCatalog) Search(provider, query string, limit int) ([]playlist.Track, error) {
