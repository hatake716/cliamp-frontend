+package radio
+
+import "cliamp/playlist"
+
+// gui.go — GUI 向け拡張 IPC (cliamp の catalog.go) が使う一覧。
+
+// BrowsePlaylists は Playlists と同じ一覧 (l: 登録局、f: お気に入り、c: 読み込んだ
+// Radio Browser の局) を、TUI の局検索の状態に関わらず返す。Playlists は検索中に
+// 検索結果 (s:) だけを返すので、TUI と同じインスタンスを使う IPC から呼ぶと、
+// TUI で一度検索しただけで GUI から登録局とお気に入りが消える。
+func (p *Provider) BrowsePlaylists() ([]playlist.PlaylistInfo, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.basePlaylistsLocked(), nil
+}
