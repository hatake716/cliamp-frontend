+	// カタログが無ければカタログ系は載せない。
+	resp = newGUITestServer(&captureDispatcher{}, nil).dispatch(Request{Cmd: "capabilities"})
+	if slices.Contains(resp.Commands, "providers") || !slices.Contains(resp.Commands, "playlist") {
