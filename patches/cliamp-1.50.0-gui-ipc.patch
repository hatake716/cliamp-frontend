+// フィードの展開待ちの間の enqueue end は、止まっているときと同じく足した曲を
+// 鳴らし、展開は取り消す (展開したエピソードが足した曲ごとリストを置き換えない)。
+func TestEnqueueDuringFeedLoading(t *testing.T) {
+	feed := playlist.Track{Path: "https://example.com/podcast.rss", Title: "Pod", Feed: true, Stream: true}
+	m, eng := newRaceModel(nil)
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.ReplaceMsg{Tracks: []playlist.Track{feed}, Reply: r}
+	})
+	seq, epoch := m.playSeq, m.playlist.Epoch()
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.EnqueueMsg{Tracks: newGUITestTracks("x"), Mode: "end", Reply: r}
+	})
+	m, _ = update(m, feedTrackResolvedMsg{tracks: newGUITestTracks("ep1"), seq: seq, epoch: epoch})
+	if cur, _ := m.playlist.Current(); cur.Title != "x" || eng.playCalls[len(eng.playCalls)-1] != "x.flac" || m.playlist.Len() != 2 {
+		t.Fatalf("current=%q len=%d plays=%v", cur.Title, m.playlist.Len(), eng.playCalls)
+	}
+	// 展開待ちの行は消せない。
+	m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.ReplaceMsg{Tracks: []playlist.Track{feed, {Path: "y.flac", Title: "y"}}, Reply: r}
+	})
+	if !resp.OK || !m.feedTrackPending {
+		t.Fatalf("replace = %+v pending=%v", resp, m.feedTrackPending)
+	}
+	if _, resp = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.RemoveMsg{Index: 0, Reply: r} }); resp.OK {
+		t.Fatal("removed the feed row that is being resolved")
+	}
+	// 同じ行をもう一度押しても 2 度目の展開は始めない。
+	seq = m.playSeq
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.PlayIndexMsg{Index: 0, Reply: r} })
+	if m.playSeq != seq {
+		t.Fatal("play_index on the loading feed row started a second resolution")
+	}
+}
