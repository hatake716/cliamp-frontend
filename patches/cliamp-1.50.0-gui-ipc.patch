+// Stored librespot credentials that Spotify now refuses keep today's
+// behaviour: silent → sign-in needed (no silent downgrade to YouTube).
+func TestStoredPremiumRejectionDoesNotSilentlyGoWebOnly(t *testing.T) {
+	f := isolate(t)
+	f.refreshes(map[string][2]string{"rt-1": {"at-1", "rt-1"}})
+	setBackend(t, func(any) (streamBackend, error) { return nil, apErr(pb.ErrorCode_BadCredentials) })
+	writeCredsFile(t, `{"username":"u","data":"YmxvYg==","refresh_token":"rt-1"}`)
+	if s, err := NewSessionSilent(context.Background(), "cid"); err == nil {
