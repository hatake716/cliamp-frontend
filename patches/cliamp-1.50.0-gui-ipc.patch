new file mode 100644
index 0000000..bd44672
--- /dev/null
+++ b/player/supersede_test.go
@@ -0,0 +1,214 @@
+package player
+
+import (
+	"encoding/binary"
+	"errors"
+	"math"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gopxl/beep/v2"
+)
+
+// newSilentPlayer は New と同じ Player を speaker.Init なしで作る
+// (音の出る機器を開かない)。
+func newSilentPlayer() *Player {
+	p := &Player{sr: beep.SampleRate(44100), resampleQuality: 1, bitDepth: 16}
+	p.speed.Store(math.Float64bits(1.0))
+	p.gapless = &gaplessStreamer{}
+	p.gapless.onSwap = func() {
+		p.mu.Lock()
+		old := p.current
+		p.current = p.nextPipeline
+		p.nextPipeline = nil
+		p.mu.Unlock()
+		if old != nil {
+			old.close()
+		}
+		p.gaplessAdvance.Store(true)
+	}
+	return p
+}
+
+func (p *Player) currentPath() string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.current == nil {
+		return ""
+	}
+	return p.current.path
+}
+
+// writeSilentWAV は 1 秒の無音の WAV を書く。
+func writeSilentWAV(t *testing.T, name string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), name)
+	const sr, ch, bits = 44100, 2, 16
+	data := make([]byte, sr*ch*bits/8)
+	hdr := make([]byte, 44)
+	copy(hdr[0:], "RIFF")
+	binary.LittleEndian.PutUint32(hdr[4:], uint32(36+len(data)))
+	copy(hdr[8:], "WAVEfmt ")
+	binary.LittleEndian.PutUint32(hdr[16:], 16)
+	binary.LittleEndian.PutUint16(hdr[20:], 1)
+	binary.LittleEndian.PutUint16(hdr[22:], ch)
+	binary.LittleEndian.PutUint32(hdr[24:], sr)
+	binary.LittleEndian.PutUint32(hdr[28:], sr*ch*bits/8)
+	binary.LittleEndian.PutUint16(hdr[32:], ch*bits/8)
+	binary.LittleEndian.PutUint16(hdr[34:], bits)
+	copy(hdr[36:], "data")
+	binary.LittleEndian.PutUint32(hdr[40:], uint32(len(data)))
+	if err := os.WriteFile(path, append(hdr, data...), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// 組み立て中の開始 (yt-dlp なら数秒) のあとに Stop と別の曲の Play が
+// あったら、遅れて組み上がった古い開始は差し替えずに ErrSuperseded を返す。
+func TestStaleStartIsSuperseded(t *testing.T) {
+	oldPath := writeSilentWAV(t, "old.wav")
+	newPath := writeSilentWAV(t, "new.wav")
+
+	for _, tt := range []struct {
+		name  string
+		after func(p *Player)
+		want  string
+	}{
+		// GUI の replace と同じ: Stop・ClearPreload のあと手元の曲を同期で鳴らす。
+		{"stop then play", func(p *Player) {
+			p.Stop()
+			p.ClearPreload()
+			if err := p.Play(newPath, 0); err != nil {
+				t.Fatalf("Play: %v", err)
+			}
+		}, newPath},
+		// 読み込み中の曲を止めただけでも、後から鳴り出さない。
+		{"stop only", func(p *Player) { p.Stop() }, ""},
+		// 止めずに別の曲を始めた (play_index) ときも新しい方が勝つ。
+		{"play only", func(p *Player) {
+			if err := p.Play(newPath, 0); err != nil {
+				t.Fatalf("Play: %v", err)
+			}
+		}, newPath},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			p := newSilentPlayer()
+			gen := p.beginStart() // PlayYTDL(old) の始まり
+			tp, err := p.buildPipeline(oldPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			tt.after(p)
+			if err := p.playPipeline(tp, gen); !errors.Is(err, ErrSuperseded) {
+				t.Fatalf("stale start returned %v, want ErrSuperseded", err)
+			}
+			if got := p.currentPath(); got != tt.want {
+				t.Fatalf("current = %q, want %q", got, tt.want)
+			}
+			if tt.want == "" && p.IsPlaying() {
+				t.Fatal("the stale start made the player play after Stop")
+			}
+			p.Stop()
+		})
+	}
+}
+
+// 最新の開始は ErrSuperseded にならない。
+func TestLatestStartPlays(t *testing.T) {
+	p := newSilentPlayer()
+	path := writeSilentWAV(t, "a.wav")
+	if err := p.Play(path, 0); err != nil {
+		t.Fatal(err)
+	}
+	if got := p.currentPath(); got != path || !p.IsPlaying() {
+		t.Fatalf("current = %q playing=%v", got, p.IsPlaying())
+	}
+	p.Stop()
+}
+
+// fakeYTDL は、呼ばれると FAKE_YTDLP_DELAY 秒待ってから無音 (0 のバイト列) を
+// 出す yt-dlp と、そのまま通す ffmpeg を PATH の先頭に置く。sh などが
+// 見つからなければ飛ばす。
+func fakeYTDL(t *testing.T) {
+	t.Helper()
+	tools := map[string]string{}
+	for _, name := range []string{"sh", "sleep", "head", "cat"} {
+		p, err := exec.LookPath(name)
+		if err != nil {
+			t.Skipf("%s not found: %v", name, err)
+		}
+		tools[name] = p
+	}
+	dir := t.TempDir()
+	write := func(name, body string) {
+		script := "#!" + tools["sh"] + "\n" + body + "\n"
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(script), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("yt-dlp", tools["sleep"]+` "${FAKE_YTDLP_DELAY:-0}"`+"\nexec "+tools["head"]+" -c 4000000 /dev/zero")
+	write("ffmpeg", "exec "+tools["cat"])
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+}
+
+// yt-dlp の曲のシーク (組み直しに数秒) の間に別の曲へ移ったら、遅れて
+// 組み上がったシークは古い曲を差し戻さない (GUI の seek_to のあと replace)。
+func TestStaleSeekYTDLDoesNotReplaceNewTrack(t *testing.T) {
+	fakeYTDL(t)
+	const yt = "https://www.youtube.com/watch?v=AAAAAAAAAAA"
+	local := writeSilentWAV(t, "local.wav")
+	p := newSilentPlayer()
+	t.Setenv("FAKE_YTDLP_DELAY", "0")
+	if err := p.PlayYTDL(yt, time.Minute); err != nil {
+		t.Fatalf("PlayYTDL: %v", err)
+	}
+	if got := p.currentPath(); got != yt {
+		t.Fatalf("current = %q", got)
+	}
+
+	t.Setenv("FAKE_YTDLP_DELAY", "1")
+	errCh := make(chan error, 1)
+	go func() { errCh <- p.SeekYTDL(30 * time.Second) }()
+	time.Sleep(300 * time.Millisecond)
+	// CancelSeekYTDL を呼ばない (upstream の TUI の next や daemon と同じ)。
+	p.Stop()
+	if err := p.Play(local, 0); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-errCh; err != nil {
+		t.Fatalf("SeekYTDL: %v", err)
+	}
+	if got := p.currentPath(); got != local {
+		t.Fatalf("after the stale seek finished, current = %q, want %q", got, local)
+	}
+	p.Stop()
+}
+
+// 組み立て中の PlayYTDL のあとに手元の曲を鳴らしたら、PlayYTDL は
+// ErrSuperseded を返して手元の曲が残る (本物の yt-dlp の経路)。
+func TestStalePlayYTDLIsSuperseded(t *testing.T) {
+	fakeYTDL(t)
+	const yt = "https://www.youtube.com/watch?v=BBBBBBBBBBB"
+	local := writeSilentWAV(t, "local.wav")
+	p := newSilentPlayer()
+	t.Setenv("FAKE_YTDLP_DELAY", "1")
+	errCh := make(chan error, 1)
+	go func() { errCh <- p.PlayYTDL(yt, time.Minute) }()
+	time.Sleep(300 * time.Millisecond)
+	p.Stop()
+	if err := p.Play(local, 0); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-errCh; !errors.Is(err, ErrSuperseded) {
+		t.Fatalf("stale PlayYTDL returned %v, want ErrSuperseded", err)
+	}
+	if got := p.currentPath(); got != local || strings.Contains(got, "youtube") {
+		t.Fatalf("current = %q, want %q", got, local)
+	}
+	p.Stop()
+}
diff --git a/playlist/gui.go b/playlist/gui.go
new file mode 100644
index 0000000..0238d18
--- /dev/null
+++ b/playlist/gui.go
@@ -0,0 +1,203 @@
+package playlist
+
+import "slices"
+
+// gui.go — GUI 向け拡張 IPC (ipc/gui.go) が使う読み取りと操作。
+//
+// Playlist には鍵が無いので、ここの関数も TUI では Update の goroutine、
+// daemon では d.mu を持った状態でだけ呼ぶこと。
+
+// Gen はリストの世代番号を返す。曲の追加・削除・並べ替え、待ち行列、
+// シャッフル、リピートが変わるたびに増える。再生位置が進んだだけでは
+// 増えない (位置は Index で分かるため)。
+func (p *Playlist) Gen() uint64 { return p.gen }
+
+// Epoch は Replace のたびに増える番号を返す。リストが丸ごと差し替わった
+// ことを、途中の追加や待ち行列の変化と区別して知るために使う。
+func (p *Playlist) Epoch() uint64 { return p.epoch }
+
+// QueueIndices は「次に再生」の待ち行列に入っている曲の添字を順に返す (写し)。
+func (p *Playlist) QueueIndices() []int { return slices.Clone(p.queue) }
+
+// Upcoming は、再生順でいまの曲の後に来る曲の添字を最大 n 個返す。
+// 待ち行列に入っている曲と再生できない曲は除く (待ち行列は QueueIndices で
+// 別に示すため)。リピートがすべてでシャッフルでないときは先頭へ回り込み、
+// いまの曲の手前で止める。シャッフル中の回り込みは次の混ぜ方がまだ
+// 決まっていないので含めない。1 曲リピートは見ない (「次へ」で進む先の
+// 並びを示すため)。
+func (p *Playlist) Upcoming(n int) []int {
+	if n <= 0 || len(p.order) == 0 {
+		return nil
+	}
+	queued := make(map[int]bool, len(p.queue))
+	for _, idx := range p.queue {
+		queued[idx] = true
+	}
+	var out []int
+	add := func(slot int) bool {
+		idx := p.order[slot]
+		if queued[idx] || !p.isPlayable(idx) {
+			return true
+		}
+		out = append(out, idx)
+		return len(out) < n
+	}
+	for slot := p.orderResumeSlot(); slot < len(p.order); slot++ {
+		if !add(slot) {
+			return out
+		}
+	}
+	if p.repeat == RepeatAll && !p.shuffle {
+		for slot := 0; slot < p.pos && slot < len(p.order); slot++ {
+			if !add(slot) {
+				return out
+			}
+		}
+	}
+	return out
+}
+
+// StartAt は添字 i の曲を選び、シャッフル中なら i を先頭にして残りを混ぜ直す。
+// Replace の直後に呼ぶと「この曲から再生し、残りはシャッフル」になる
+// (SetIndex だけでは i より前に混ざった曲が再生済み扱いになり、一周するまで
+// 出てこない)。
+func (p *Playlist) StartAt(i int) {
+	p.SetIndex(i)
+	if p.shuffle && len(p.order) > 0 {
+		p.doShuffle()
+		p.gen++
+	}
+}
+
+// MoveQueueTo は待ち行列の位置 from の曲を位置 to へ動かす (間の曲は詰める)。
+// MoveQueue は 2 つの位置の入れ替えなので、ドラッグでの移動にはこちらを使う。
+func (p *Playlist) MoveQueueTo(from, to int) bool {
+	if from < 0 || from >= len(p.queue) || to < 0 || to >= len(p.queue) {
+		return false
+	}
+	if from == to {
+		return true
+	}
+	idx := p.queue[from]
+	p.queue = slices.Delete(p.queue, from, from+1)
+	p.queue = slices.Insert(p.queue, to, idx)
+	p.gen++
+	return true
+}
+
+// orderResumeSlot は、次に順送りで鳴らす order の位置の候補の先頭を返す。
+// ふつうは pos の次。待ち行列の曲が鳴っている間に order[pos] が消されて
+// 後ろの曲が詰まってきたときは、その曲はまだ鳴っていないので pos から。
+func (p *Playlist) orderResumeSlot() int {
+	if p.resumeAtPos && p.queuedIdx >= 0 {
+		return p.pos
+	}
+	return p.pos + 1
+}
+
+// AddNext は曲を末尾に足し (添字は Add と同じく len から続く)、再生順では
+// いまの曲のすぐ後ろに並べる (GUI の「次に再生」)。待ち行列は使わない。
+// 待ち行列に入れると待ち行列で 1 度、リストの順でもう 1 度鳴るため。
+// 待ち行列に入っている曲はこれより先に鳴る。足した最初の曲の添字を返す。
+// シャッフルでなくても順は添字どおりでなくなるが、Move やシャッフルを
+// 切ったときは従来どおり添字の順に戻る (足した曲は末尾へ回る)。
+func (p *Playlist) AddNext(tracks ...Track) int {
+	start := len(p.tracks)
+	if len(tracks) == 0 {
+		return start
+	}
+	p.tracks = append(p.tracks, tracks...)
+	ins := make([]int, len(tracks))
+	for i := range ins {
+		ins[i] = start + i
+	}
+	at := 0
+	if len(p.order) > 0 {
+		at = p.orderResumeSlot()
+	}
+	p.order = slices.Insert(p.order, at, ins...)
+	p.gen++
+	return start
+}
+
+// PlaceNext はシャッフル中に、添字 idxs の曲を再生順でいまの曲のすぐ後ろへ
+// (与えた順に) 動かす。Add はシャッフル中に足した曲をこれからの順に混ぜるので、
+// そのあと SetIndex で足した曲へ飛ぶと、手前に混ざったまだ鳴っていない曲が
+// 鳴ったことになり飛ばされる。先にこれで並べておけば飛ばない。
+// シャッフルでなければ何もしない (添字の順が再生順のまま)。すでに鳴った
+// 位置 (pos 以前) にある曲は動かさない。
+func (p *Playlist) PlaceNext(idxs ...int) {
+	if !p.shuffle || len(p.order) == 0 || len(idxs) == 0 {
+		return
+	}
+	from := p.orderResumeSlot()
+	slotOf := make(map[int]int, len(p.order))
+	for slot, idx := range p.order {
+		slotOf[idx] = slot
+	}
+	var move []int
+	moving := make(map[int]bool, len(idxs))
+	for _, idx := range idxs {
+		if slot, ok := slotOf[idx]; ok && slot >= from && !moving[idx] {
+			move = append(move, idx)
+			moving[idx] = true
+		}
+	}
+	if len(move) == 0 {
+		return
+	}
+	order := slices.Clone(p.order[:from])
+	order = append(order, move...)
+	for _, idx := range p.order[from:] {
+		if !moving[idx] {
+			order = append(order, idx)
+		}
+	}
+	p.order = order
+	p.gen++
+}
+
+// GUI の enqueue の並べ方 (TUI の ui/model/ipc_gui.go と daemon_gui.go で共用)。
+// どれも足した最初の曲の添字を返す。
+
+// PlayNext は「次に再生」: AddNext と同じく、いまの曲のすぐ後ろに並べる。
+// 1 曲リピートでは順送りで進まない (Next がいまの曲を返し続ける) ので、
+// 従来どおり末尾に足して待ち行列に入れる (待ち行列は 1 曲リピートより先に鳴る)。
+func (p *Playlist) PlayNext(tracks ...Track) int {
+	if p.repeat != RepeatOne {
+		return p.AddNext(tracks...)
+	}
+	start := len(p.tracks)
+	p.Add(tracks...)
+	for i := range tracks {
+		p.Queue(start + i)
+	}
+	return start
+}
+
+// AddNow は enqueue now: 末尾に足して先頭の曲を選ぶ (TUI の Enter と同じ
+// playTrackImmediate の並べ方)。シャッフル中は足した曲をまとめていまの曲の
+// すぐ後ろへ並べてから選ぶので、これから鳴るはずだった曲は飛ばされず、
+// 2 曲目以降も足した順に続く。
+func (p *Playlist) AddNow(tracks ...Track) int {
+	start := len(p.tracks)
+	p.Add(tracks...)
+	idxs := make([]int, len(tracks))
+	for i := range idxs {
+		idxs[i] = start + i
+	}
+	p.PlaceNext(idxs...)
+	p.SetIndex(start)
+	return start
+}
+
+// AddAndSelect は止まっているときの enqueue end: 末尾に足して先頭の曲を選ぶ
+// (TUI の a と同じ)。シャッフル中は先頭の曲だけをいまの曲のすぐ後ろへ並べ、
+// 残りはこれからの順に混ぜたままにする。
+func (p *Playlist) AddAndSelect(tracks ...Track) int {
+	start := len(p.tracks)
+	p.Add(tracks...)
+	p.PlaceNext(start)
+	p.SetIndex(start)
+	return start
+}
diff --git a/playlist/gui_order_test.go b/playlist/gui_order_test.go
new file mode 100644
index 0000000..a004b0d
--- /dev/null
+++ b/playlist/gui_order_test.go
@@ -0,0 +1,299 @@
+package playlist
+
+// GUI の enqueue の並べ方 (AddNext, PlayNext, AddNow, AddAndSelect, PlaceNext) と、
+// 待ち行列の曲が鳴っている間の Remove の試験。daemon も同じ関数を使う。
+
+import (
+	"slices"
+	"testing"
+)
+
+// guiPlayed は Next で最後まで進めたときに鳴る曲の Title を返す。
+func guiPlayed(p *Playlist) []string {
+	var out []string
+	for range 200 {
+		t, ok := p.Next()
+		if !ok {
+			break
+		}
+		out = append(out, t.Title)
+	}
+	return out
+}
+
+func guiNamed(names ...string) []Track {
+	out := make([]Track, len(names))
+	for i, n := range names {
+		out[i] = Track{Path: n + ".mp3", Title: n}
+	}
+	return out
+}
+
+func guiTitlesOf(p *Playlist, idxs []int) []string {
+	out := make([]string, len(idxs))
+	for i, idx := range idxs {
+		out[i] = p.Tracks()[idx].Title
+	}
+	return out
+}
+
+// 「次に再生」はいまの曲のすぐ後ろに 1 度だけ鳴り、Upcoming もそのとおり。
+// 添字は末尾に続く (既存の曲の添字は動かない)。
+func TestPlayNextPlaysOnceRightAfterCurrent(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		current int
+		want    []string
+	}{
+		{"first", 0, []string{"X", "Y", "B", "C"}},
+		{"last", 2, []string{"X", "Y"}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			p := New()
+			p.Replace(guiNamed("A", "B", "C"))
+			p.SetIndex(tt.current)
+			gen := p.Gen()
+			if start := p.PlayNext(guiNamed("X", "Y")...); start != 3 {
+				t.Fatalf("start = %d, want 3", start)
+			}
+			if p.Gen() == gen || p.QueueLen() != 0 {
+				t.Fatalf("gen unchanged or queue used: queue=%v", p.QueueIndices())
+			}
+			if up := guiTitlesOf(p, p.Upcoming(10)); !slices.Equal(up, tt.want) {
+				t.Fatalf("Upcoming = %v, want %v", up, tt.want)
+			}
+			if got := guiPlayed(p); !slices.Equal(got, tt.want) {
+				t.Fatalf("played %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+// シャッフル中も、足した曲は順に、いまの曲のすぐ後ろで鳴り、他の曲は飛ばない。
+func TestPlayNextWithShuffle(t *testing.T) {
+	for range 50 {
+		p := New()
+		p.Replace(guiNamed("A", "B", "C", "D", "E"))
+		p.ToggleShuffle()
+		cur, _ := p.Current()
+		p.PlayNext(guiNamed("X", "Y")...)
+		got := guiPlayed(p)
+		if len(got) != 6 || got[0] != "X" || got[1] != "Y" {
+			t.Fatalf("played %v, want X Y then the 4 others", got)
+		}
+		for _, n := range []string{"A", "B", "C", "D", "E"} {
+			if n != cur.Title && !slices.Contains(got, n) {
+				t.Fatalf("%s skipped: %v", n, got)
+			}
+		}
+	}
+}
+
+// 待ち行列に入っている曲は「次に再生」より先に鳴る (従来の待ち行列の末尾に
+// 足したのと同じ順)。
+func TestPlayNextAfterExistingQueue(t *testing.T) {
+	p := New()
+	p.Replace(guiNamed("A", "B", "C"))
+	p.Queue(2)
+	p.PlayNext(guiNamed("X")...)
+	if got := guiPlayed(p); !slices.Equal(got, []string{"C", "X", "B", "C"}) {
+		t.Fatalf("played %v, want [C X B C]", got)
+	}
+}
+
+// 1 曲リピートでは順送りで進まないので、待ち行列に入れる。
+func TestPlayNextWithRepeatOneQueues(t *testing.T) {
+	p := New()
+	p.Replace(guiNamed("A", "B"))
+	p.SetRepeat(RepeatOne)
+	start := p.PlayNext(guiNamed("X")...)
+	if !slices.Equal(p.QueueIndices(), []int{start}) {
+		t.Fatalf("queue = %v, want [%d]", p.QueueIndices(), start)
+	}
+	if next, _ := p.Next(); next.Title != "X" {
+		t.Fatalf("next = %q, want X", next.Title)
+	}
+}
+
+// シャッフル中の enqueue now は、足した曲をまとめていまの曲のすぐ後ろに置き、
+// これから鳴るはずだった曲を飛ばさない。シャッフルでなければ TUI の Enter と
+// 同じく足した行へ飛ぶ。
+func TestAddNow(t *testing.T) {
+	for range 100 {
+		p := New()
+		p.Replace(guiNamed("A", "B", "C", "D", "E", "F", "G", "H"))
+		p.ToggleShuffle()
+		cur, _ := p.Current()
+		before := len(p.Upcoming(100))
+		start := p.AddNow(guiNamed("X", "Y")...)
+		if now, idx := p.Current(); now.Title != "X" || idx != start {
+			t.Fatalf("current = %q, want X", now.Title)
+		}
+		if got := len(p.Upcoming(100)); got != before+1 {
+			t.Fatalf("Upcoming has %d entries, want %d (Y + the others)", got, before+1)
+		}
+		got := guiPlayed(p)
+		if len(got) == 0 || got[0] != "Y" {
+			t.Fatalf("after X: %v, want Y first", got)
+		}
+		for _, n := range []string{"A", "B", "C", "D", "E", "F", "G", "H"} {
+			if n != cur.Title && !slices.Contains(got, n) {
+				t.Fatalf("%s skipped: %v", n, got)
+			}
+		}
+	}
+
+	p := New()
+	p.Replace(guiNamed("A", "B", "C"))
+	p.AddNow(guiNamed("X", "Y")...)
+	if cur, _ := p.Current(); cur.Title != "X" || !slices.Equal(guiPlayed(p), []string{"Y"}) {
+		t.Fatalf("linear: current %q, rest %v", cur.Title, guiPlayed(p))
+	}
+}
+
+// 止まっているときの enqueue end: 先頭の曲を選び、シャッフル中でも足した
+// 残りの曲とまだ鳴っていない曲を飛ばさない。
+func TestAddAndSelect(t *testing.T) {
+	for range 100 {
+		p := New()
+		p.Replace(guiNamed("A", "B", "C", "D"))
+		p.ToggleShuffle()
+		guiPlayed(p) // 最後まで鳴らし終えた
+		added := []string{"X0", "X1", "X2", "X3", "X4", "X5"}
+		p.AddAndSelect(guiNamed(added...)...)
+		if cur, _ := p.Current(); cur.Title != "X0" {
+			t.Fatalf("current = %q, want X0", cur.Title)
+		}
+		got := guiPlayed(p)
+		for _, n := range added[1:] {
+			if !slices.Contains(got, n) {
+				t.Fatalf("%s skipped: %v", n, got)
+			}
+		}
+	}
+	// 途中で止めたときも、まだ鳴っていない曲は残る。
+	for range 100 {
+		p := New()
+		p.Replace(guiNamed("A", "B", "C", "D", "E", "F"))
+		p.ToggleShuffle()
+		cur, _ := p.Current()
+		p.AddAndSelect(guiNamed("X")...)
+		got := guiPlayed(p)
+		for _, n := range []string{"A", "B", "C", "D", "E", "F"} {
+			if n != cur.Title && !slices.Contains(got, n) {
+				t.Fatalf("%s skipped: %v", n, got)
+			}
+		}
+	}
+}
+
+func TestPlaceNextIgnoresLinearAndPlayedSlots(t *testing.T) {
+	p := New()
+	p.Replace(guiNamed("A", "B", "C"))
+	p.SetIndex(1)
+	gen := p.Gen()
+	p.PlaceNext(2, 0)
+	if p.Gen() != gen || !slices.Equal(p.Upcoming(10), []int{2}) {
+		t.Fatal("PlaceNext changed a linear playlist")
+	}
+	p.ToggleShuffle() // B が先頭
+	p.PlaceNext(1)    // いまの曲は動かさない
+	if cur, _ := p.Current(); cur.Title != "B" {
+		t.Fatalf("current = %q", cur.Title)
+	}
+}
+
+// 待ち行列の曲が鳴っている間に、その前に鳴ったリストの曲 (order[pos]) を
+// 消しても、次に鳴るはずの曲は飛ばされない。
+func TestRemoveInterruptedTrackWhileQueuedKeepsSuccessor(t *testing.T) {
+	for _, tt := range []struct {
+		name           string
+		repeat         RepeatMode
+		current, queue int
+		remove         string
+		queued         string
+		want           []string
+	}{
+		{"first, repeat off", RepeatOff, 0, 4, "A", "E", []string{"B", "C", "D", "E"}},
+		{"middle, repeat off", RepeatOff, 1, 4, "B", "E", []string{"C", "D", "E"}},
+		{"first, repeat all", RepeatAll, 0, 4, "A", "E", []string{"B", "C", "D", "E"}},
+		// 最後の位置の曲を消したら、その後ろは無いのでふつうに終わる。
+		{"last slot", RepeatOff, 4, 0, "E", "A", nil},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			p := New()
+			p.Replace(guiNamed("A", "B", "C", "D", "E"))
+			p.SetRepeat(tt.repeat)
+			p.SetIndex(tt.current)
+			p.Queue(tt.queue)
+			if next, _ := p.Next(); next.Title != tt.queued || !p.CurrentIsQueued() {
+				t.Fatalf("queued %s not playing", tt.queued)
+			}
+			idx := slices.IndexFunc(p.Tracks(), func(tr Track) bool { return tr.Title == tt.remove })
+			p.Remove(idx)
+			if cur, _ := p.Current(); cur.Title != tt.queued {
+				t.Fatalf("current after removal = %q, want %s", cur.Title, tt.queued)
+			}
+			cut := func(s []string) []string {
+				if tt.repeat == RepeatAll {
+					return s[:min(len(s), len(tt.want))]
+				}
+				return s
+			}
+			if up := cut(guiTitlesOf(p, p.Upcoming(10))); !slices.Equal(up, tt.want) {
+				t.Fatalf("Upcoming = %v, want %v", up, tt.want)
+			}
+			if peek, ok := p.PeekNext(); ok != (tt.want != nil) || (ok && peek.Title != tt.want[0]) {
+				t.Fatalf("PeekNext = %q, %v; want %v", peek.Title, ok, tt.want)
+			}
+			if got := cut(guiPlayed(p)); !slices.Equal(got, tt.want) {
+				t.Fatalf("played %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRemoveInterruptedTrackWhileQueuedWithShuffle(t *testing.T) {
+	for range 50 {
+		p := New()
+		p.Replace(guiNamed("A", "B", "C", "D", "E", "F"))
+		p.ToggleShuffle()
+		p.Queue(p.Upcoming(10)[len(p.Upcoming(10))-1])
+		anchor, _ := p.Current()
+		p.Next() // 待ち行列の曲
+		want := guiTitlesOf(p, p.Upcoming(10))
+		idx := slices.IndexFunc(p.Tracks(), func(tr Track) bool { return tr.Title == anchor.Title })
+		p.Remove(idx)
+		if got := guiTitlesOf(p, p.Upcoming(10)); !slices.Equal(got, want) {
+			t.Fatalf("Upcoming after removing the played %s = %v, want %v", anchor.Title, got, want)
+		}
+		if got := guiPlayed(p); !slices.Equal(got, want) {
+			t.Fatalf("played %v, want %v", got, want)
+		}
+	}
+}
+
+// 待ち行列から戻ったあとや、選び直したあとは、ふつうに pos の次から進む。
+func TestResumeAtPosIsClearedWhenPositionMoves(t *testing.T) {
+	p := New()
+	p.Replace(guiNamed("A", "B", "C", "D"))
+	p.Queue(3)
+	p.Next()      // D (待ち行列)
+	p.Remove(0)   // B C D の B は未再生
+	p.SetIndex(1) // C を選び直したら、ふつうに C の次から進む
+	if got := guiPlayed(p); !slices.Equal(got, []string{"D"}) {
+		t.Fatalf("after SetIndex(C): %v, want [D]", got)
+	}
+
+	p = New()
+	p.Replace(guiNamed("A", "B", "C", "D"))
+	p.Queue(3)
+	p.Next()    // D (待ち行列)
+	p.Remove(0) // B は未再生
+	if next, _ := p.Next(); next.Title != "B" {
+		t.Fatalf("next = %q, want B", next.Title)
+	}
+	if next, _ := p.Next(); next.Title != "C" {
+		t.Fatalf("after B = %q, want C (resume flag must not stick)", next.Title)
+	}
+}
