diff --git a/status_plain_test.go b/status_plain_test.go
new file mode 100644
index 0000000..31003d1
--- /dev/null
+++ b/status_plain_test.go
@@ -0,0 +1,78 @@
+package main
+
+// `cliamp status` の平文の出力は、拡張のフィールド (playback_error など) が
+// 応答に増えても変わらない (Open-Voice がこの出力を読んでいる)。
+
+import (
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"cliamp/ipc"
+)
+
+type fixedStatus struct{ resp ipc.Response }
+
+func (f fixedStatus) Send(msg any) {
+	if m, ok := msg.(ipc.StatusRequestMsg); ok {
+		m.Reply <- f.resp
+	}
+}
+
+// plainStatus は HOME を一時ディレクトリにして (利用者のソケットには繋がない)、
+// resp を返すサーバーに `cliamp status` を打った出力を返す。
+func plainStatus(t *testing.T, resp ipc.Response, args ...string) string {
+	t.Helper()
+	home, err := os.MkdirTemp("", "st")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(home) })
+	t.Setenv("HOME", home)
+	sock := ipc.DefaultSocketPath()
+	if filepath.Dir(sock) != filepath.Join(home, ".config", "cliamp") {
+		t.Fatalf("socket %s is not under the temporary HOME", sock)
+	}
+	if err := os.MkdirAll(filepath.Dir(sock), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	srv, err := ipc.NewServerWith(sock, fixedStatus{resp}, ipc.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer srv.Close()
+
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout := os.Stdout
+	os.Stdout = w
+	runErr := statusCommand().Run(context.Background(), append([]string{"status"}, args...))
+	os.Stdout = stdout
+	w.Close()
+	out, _ := io.ReadAll(r)
+	if runErr != nil {
+		t.Fatal(runErr)
+	}
+	return string(out)
+}
+
+func TestStatusPlainTextIgnoresPlaybackError(t *testing.T) {
+	off := false
+	base := ipc.Response{
+		OK: true, State: "stopped", Volume: -6, Shuffle: &off, Repeat: "Off", Mono: &off, Speed: 1, EQPreset: "Flat",
+		Track: &ipc.TrackInfo{Title: "Song", Artist: "Artist", Path: "https://www.youtube.com/watch?v=x8VYWazR5mE"},
+	}
+	want := "State: stopped\nTrack: Song\nArtist: Artist\nVolume: -6 dB\nShuffle: off\nRepeat: Off\nMono: off\nSpeed: 1.00x\nEQ: Flat\n"
+	if got := plainStatus(t, base); got != want {
+		t.Fatalf("plain status without an error:\n%q\nwant\n%q", got, want)
+	}
+	failed := base
+	failed.PlaybackError = "yt-dlp: ERROR: [youtube] x8VYWazR5mE: Sign in to confirm your age."
+	if got := plainStatus(t, failed); got != want {
+		t.Fatalf("plain status with playback_error:\n%q\nwant\n%q", got, want)
+	}
+}
