+//go:build !windows
+
+package spotify
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"reflect"
+	"slices"
+	"testing"
+
+	"cliamp/playlist"
+)
+
+func TestBridgedTrack(t *testing.T) {
+	tests := []struct {
+		name       string
+		in         spotifyTrack
+		wantPath   string
+		wantArtist string
+	}{
+		{"single artist",
+			spotifyTrack{id: "id1", title: "Lemon", artists: []string{"米津玄師"}},
+			"ytsearch1:米津玄師 Lemon", "米津玄師"},
+		{"multiple artists are joined by spaces",
+			spotifyTrack{id: "id2", title: "Under Pressure", artists: []string{"Queen", "David Bowie"}},
+			"ytsearch1:Queen David Bowie Under Pressure", "Queen, David Bowie"},
+		{"artist names with commas stay whole",
+			spotifyTrack{id: "id3", title: "September", artists: []string{"Earth, Wind & Fire"}},
+			"ytsearch1:Earth, Wind & Fire September", "Earth, Wind & Fire"},
+		{"no artists",
+			spotifyTrack{id: "id4", title: "Untitled"},
+			"ytsearch1:Untitled", ""},
+		{"empty artist name is skipped",
+			spotifyTrack{id: "id5", title: "Song", artists: []string{"", "B"}},
+			"ytsearch1:B Song", ", B"},
+		{"special characters are kept (yt-dlp gets one argument, no shell)",
+			spotifyTrack{id: "id6", title: `Don't Stop Me Now? #1 / "Live" & 100% :)`, artists: []string{"AC/DC", "Beyoncé"}},
+			`ytsearch1:AC/DC Beyoncé Don't Stop Me Now? #1 / "Live" & 100% :)`, "AC/DC, Beyoncé"},
+		{"newlines, tabs and runs of spaces collapse",
+			spotifyTrack{id: "id7", title: "  Two\nLines\tTab  ", artists: []string{" Spaced  Out "}},
+			"ytsearch1:Spaced Out Two Lines Tab", " Spaced  Out "},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			in := tt.in
+			in.album, in.year, in.durationSecs, in.trackNumber, in.unplayable = "Album", 2018, 254, 3, true
+			got := in.track(true)
+			want := playlist.Track{
+				Path:         tt.wantPath,
+				Title:        in.title,
+				Artist:       tt.wantArtist,
+				Album:        "Album",
+				Year:         2018,
+				DurationSecs: 254,
+				TrackNumber:  3,
+				Unplayable:   false, // Spotify's restriction says nothing about YouTube
+				ProviderMeta: map[string]string{"spotify.id": in.id, "spotify.bridge": "youtube"},
+			}
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("bridged =\n %#v\nwant\n %#v", got, want)
+			}
+			if !playlist.IsYTSearch(got.Path) || !playlist.IsYTDL(got.Path) {
+				t.Fatalf("path %q is not played through yt-dlp", got.Path)
+			}
+			if playlist.IsM3U(got.Path) || playlist.IsPLS(got.Path) {
+				t.Fatalf("path %q would be expanded as a playlist wrapper", got.Path)
+			}
+			// The artists slice of the cached track must not be modified.
+			if len(tt.in.artists) > 0 && !slices.Equal(in.artists, tt.in.artists) {
+				t.Fatalf("artists modified: %q", in.artists)
+			}
+		})
+	}
+}
+
+// The premium shape is exactly what Tracks() produced before.
+func TestPremiumTrackShape(t *testing.T) {
+	in := spotifyTrack{id: "abc", title: "T", artists: []string{"A", "B"}, album: "Al", year: 1999, durationSecs: 61, trackNumber: 4, unplayable: true}
+	want := playlist.Track{Path: "spotify:track:abc", Title: "T", Artist: "A, B", Album: "Al", Year: 1999, DurationSecs: 61, TrackNumber: 4, Unplayable: true}
+	if got := in.track(false); !reflect.DeepEqual(got, want) {
+		t.Fatalf("premium track =\n %#v\nwant\n %#v", got, want)
+	}
+}
+
+func TestSpotifyTrackURI(t *testing.T) {
+	tests := []struct {
+		name  string
+		track playlist.Track
+		want  string
+	}{
+		{"spotify path", playlist.Track{Path: "spotify:track:abc"}, "spotify:track:abc"},
+		{"bridged track uses meta id", playlist.Track{Path: "ytsearch1:A T", ProviderMeta: map[string]string{"spotify.id": "abc", "spotify.bridge": "youtube"}}, "spotify:track:abc"},
+		{"path wins over meta", playlist.Track{Path: "spotify:track:abc", ProviderMeta: map[string]string{"spotify.id": "zzz"}}, "spotify:track:abc"},
+		{"other track unchanged", playlist.Track{Path: "https://example.com/a.mp3"}, "https://example.com/a.mp3"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := spotifyTrackURI(tt.track); got != tt.want {
+				t.Fatalf("spotifyTrackURI = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+// fakeLibrary serves Your Music, one playlist, search and /v1/me.
+func fakeLibrary(f *fakeSpotify) {
+	track := func(id, name string, artists []string, playable bool) map[string]any {
+		as := make([]map[string]string, len(artists))
+		for i, a := range artists {
+			as[i] = map[string]string{"name": a}
+		}
+		return map[string]any{
+			"id": id, "name": name, "artists": as,
+			"album":       map[string]string{"name": "Album " + id, "release_date": "2020-01-02"},
+			"duration_ms": 200500, "track_number": 7, "is_playable": playable,
+		}
+	}
+	f.json("GET /v1/me", 200, map[string]string{"id": "u1"})
+	f.json("GET /v1/me/tracks", 200, map[string]any{
+		"total": 2,
+		"items": []any{
+			map[string]any{"track": track("liked1", "Liked One", []string{"Artist A", "Artist B"}, true)},
+			map[string]any{"track": track("liked2", "Liked Two", nil, false)},
+		},
+	})
+	f.json("GET /v1/me/playlists", 200, map[string]any{
+		"total": 1,
+		"items": []any{map[string]any{"id": "pl1", "name": "Mine", "snapshot_id": "s1", "owner": map[string]string{"id": "u1"}, "items": map[string]int{"total": 1}}},
+	})
+	f.json("GET /v1/playlists/pl1/items", 200, map[string]any{
+		"total": 1,
+		"items": []any{map[string]any{"item": track("pl1t1", "In Playlist", []string{"Solo"}, true)}},
+	})
+	f.json("GET /v1/search", 200, map[string]any{
+		"tracks": map[string]any{"items": []any{track("found1", "Found", []string{"X", "Y"}, true)}},
+	})
+}
+
+// Web-only providers list the library from the Web API and return bridged
+// tracks from Tracks and SearchTracks; Premium ones keep spotify:track:.
+func TestProviderTracksByMode(t *testing.T) {
+	tests := []struct {
+		name    string
+		webOnly bool
+	}{
+		{"web-only", true},
+		{"premium", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			fakeLibrary(f)
+			var sess *Session
+			if tt.webOnly {
+				sess = webOnlyTestSession(t, "")
+			} else {
+				sess = premiumTestSession(t, &fakeBackend{})
+			}
+			p := New(sess, "cid", 320)
+			defer p.Close()
+
+			lists, err := p.Playlists()
+			if err != nil {
+				t.Fatalf("Playlists: %v", err)
+			}
+			if len(lists) != 2 || lists[0].ID != "YOUR MUSIC" || lists[0].TrackCount != 2 || lists[1].ID != "pl1" {
+				t.Fatalf("Playlists = %+v", lists)
+			}
+
+			liked, err := p.Tracks("YOUR MUSIC")
+			if err != nil {
+				t.Fatalf("Tracks(YOUR MUSIC): %v", err)
+			}
+			inList, err := p.Tracks("pl1")
+			if err != nil {
+				t.Fatalf("Tracks(pl1): %v", err)
+			}
+			found, err := p.SearchTracks(context.Background(), "q", 5)
+			if err != nil {
+				t.Fatalf("SearchTracks: %v", err)
+			}
+
+			var wantLiked, wantList, wantFound []playlist.Track
+			if tt.webOnly {
+				meta := func(id string) map[string]string {
+					return map[string]string{"spotify.id": id, "spotify.bridge": "youtube"}
+				}
+				wantLiked = []playlist.Track{
+					{Path: "ytsearch1:Artist A Artist B Liked One", Title: "Liked One", Artist: "Artist A, Artist B", Album: "Album liked1", Year: 2020, DurationSecs: 200, TrackNumber: 7, ProviderMeta: meta("liked1")},
+					{Path: "ytsearch1:Liked Two", Title: "Liked Two", Album: "Album liked2", Year: 2020, DurationSecs: 200, TrackNumber: 7, ProviderMeta: meta("liked2")},
+				}
+				wantList = []playlist.Track{
+					{Path: "ytsearch1:Solo In Playlist", Title: "In Playlist", Artist: "Solo", Album: "Album pl1t1", Year: 2020, DurationSecs: 200, TrackNumber: 7, ProviderMeta: meta("pl1t1")},
+				}
+				wantFound = []playlist.Track{
+					// Bridged search results keep Spotify's track_number too.
+					{Path: "ytsearch1:X Y Found", Title: "Found", Artist: "X, Y", Album: "Album found1", Year: 2020, DurationSecs: 200, TrackNumber: 7, ProviderMeta: meta("found1")},
+				}
+			} else {
+				wantLiked = []playlist.Track{
+					{Path: "spotify:track:liked1", Title: "Liked One", Artist: "Artist A, Artist B", Album: "Album liked1", Year: 2020, DurationSecs: 200, TrackNumber: 7},
+					{Path: "spotify:track:liked2", Title: "Liked Two", Album: "Album liked2", Year: 2020, DurationSecs: 200, TrackNumber: 7, Unplayable: true},
+				}
+				wantList = []playlist.Track{
+					{Path: "spotify:track:pl1t1", Title: "In Playlist", Artist: "Solo", Album: "Album pl1t1", Year: 2020, DurationSecs: 200, TrackNumber: 7},
+				}
+				wantFound = []playlist.Track{
+					// Premium search results are unchanged (no track number).
+					{Path: "spotify:track:found1", Title: "Found", Artist: "X, Y", Album: "Album found1", Year: 2020, DurationSecs: 200},
+				}
+			}
+			for _, c := range []struct {
+				name      string
+				got, want []playlist.Track
+			}{{"liked", liked, wantLiked}, {"playlist", inList, wantList}, {"search", found, wantFound}} {
+				if !reflect.DeepEqual(c.got, c.want) {
+					t.Errorf("%s tracks =\n %#v\nwant\n %#v", c.name, c.got, c.want)
+				}
+			}
+
+			// The cache serves the second call (and in the same shape).
+			again, _ := p.Tracks("pl1")
+			if f.count("GET /v1/playlists/pl1/items") != 1 || !reflect.DeepEqual(again, wantList) {
+				t.Fatalf("cached Tracks = %#v (fetches %d)", again, f.count("GET /v1/playlists/pl1/items"))
+			}
+		})
+	}
+}
+
+// Adding a bridged track to a Spotify playlist sends its Spotify id.
+func TestAddTrackToPlaylistBridged(t *testing.T) {
+	tests := []struct {
+		name  string
+		track playlist.Track
+		want  string
+	}{
+		{"bridged track", playlist.Track{Path: "ytsearch1:Queen David Bowie Under Pressure", ProviderMeta: map[string]string{"spotify.id": "2aoo2jlRnM3A0NyLQqMN2f", "spotify.bridge": "youtube"}}, "spotify:track:2aoo2jlRnM3A0NyLQqMN2f"},
+		{"spotify track", playlist.Track{Path: "spotify:track:2aoo2jlRnM3A0NyLQqMN2f"}, "spotify:track:2aoo2jlRnM3A0NyLQqMN2f"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			f.json("POST /v1/playlists/pl1/items", http.StatusCreated, map[string]string{"snapshot_id": "s2"})
+			p := New(webOnlyTestSession(t, ""), "cid", 320)
+			defer p.Close()
+			if err := p.AddTrackToPlaylist(context.Background(), "pl1", tt.track); err != nil {
+				t.Fatalf("AddTrackToPlaylist: %v", err)
+			}
+			bodies := f.body("POST /v1/playlists/pl1/items")
+			if len(bodies) != 1 {
+				t.Fatalf("requests = %d", len(bodies))
+			}
+			var got struct {
+				URIs []string `json:"uris"`
+			}
+			if err := json.Unmarshal([]byte(bodies[0]), &got); err != nil || !slices.Equal(got.URIs, []string{tt.want}) {
+				t.Fatalf("body = %s, want uris [%s]", bodies[0], tt.want)
+			}
+		})
+	}
+}
+
+// Creating a playlist and adding a bridged track works on a web-only session
+// (the TUI's "new playlist" flow). POST /v1/me/playlists needs no user id.
+func TestCreatePlaylistWebOnly(t *testing.T) {
+	f := isolate(t)
+	f.json("POST /v1/me/playlists", http.StatusCreated, map[string]string{"id": "newpl"})
+	f.json("POST /v1/playlists/newpl/items", http.StatusCreated, map[string]string{"snapshot_id": "s1"})
+	p := New(webOnlyTestSession(t, ""), "cid", 320)
+	defer p.Close()
+
+	id, err := p.CreatePlaylist(context.Background(), "From cliamp")
+	if err != nil || id != "newpl" {
+		t.Fatalf("CreatePlaylist = %q, %v", id, err)
+	}
+	if f.count("GET /v1/me") != 0 {
+		t.Fatal("CreatePlaylist asked /v1/me")
+	}
+	bridged := spotifyTrack{id: "tid", title: "T", artists: []string{"A"}}.track(true)
+	if err := p.AddTrackToPlaylist(context.Background(), id, bridged); err != nil {
+		t.Fatal(err)
+	}
+	if b := f.body("POST /v1/playlists/newpl/items"); len(b) != 1 || b[0] != `{"uris":["spotify:track:tid"]}` {
+		t.Fatalf("add body = %q", b)
+	}
+}
+
+// Without a session, the provider still asks for sign-in (unchanged).
+func TestProviderWithoutCredentialsNeedsAuth(t *testing.T) {
+	isolate(t)
+	p := New(nil, "cid", 320)
+	if _, err := p.Tracks("YOUR MUSIC"); !errors.Is(err, playlist.ErrNeedsAuth) {
+		t.Fatalf("Tracks err = %v, want ErrNeedsAuth", err)
+	}
+	if got := p.PlaybackVia(); got != "" {
+		t.Fatalf("PlaybackVia = %q", got)
+	}
+}
