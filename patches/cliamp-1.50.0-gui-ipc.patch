+func TestWebOnlyRestoreFailures(t *testing.T) {
+	t.Run("revoked refresh token clears credentials and needs sign-in", func(t *testing.T) {
+		f := isolate(t)
+		f.refreshes(map[string][2]string{}) // everything is invalid_grant
+		writeCredsFile(t, `{"refresh_token":"rt-dead","web_only":true}`)
+		_, err := NewSessionSilent(context.Background(), "cid")
+		if !errors.Is(err, playlist.ErrNeedsAuth) {
+			t.Fatalf("err = %v, want ErrNeedsAuth", err)
+		}
+		if got := readCredsFile(t); got != nil {
+			t.Fatalf("credentials not cleared: %v", got)
+		}
+	})
+	t.Run("transient refresh failure keeps the session and the token", func(t *testing.T) {
+		isolate(t) // token endpoint answers 500
+		writeCredsFile(t, `{"refresh_token":"rt-1","web_only":true,"user_id":"u1"}`)
+		s, err := NewSessionSilent(context.Background(), "cid")
+		if err != nil {
+			t.Fatalf("NewSessionSilent: %v", err)
+		}
+		defer s.Close()
+		if !s.WebOnly() {
+			t.Fatal("not web-only")
+		}
+		if got := readCredsFile(t); got["refresh_token"] != "rt-1" || got["web_only"] != true {
+			t.Fatalf("stored credentials = %v", got)
+		}
+		// The next Web API call retries the refresh (and fails as a normal
+		// error, not as a sign-in prompt).
+		_, err = s.webApiWithBody(context.Background(), "GET", "/v1/me", nil, nil, "")
+		if err == nil || errors.Is(err, playlist.ErrNeedsAuth) {
+			t.Fatalf("web api err = %v", err)
+		}
+	})
+}
+
+// Which stored file takes which path. Old files (no web_only) keep loading.
+func TestStoredCredentialFormats(t *testing.T) {
+	tests := []struct {
+		name        string
+		file        string
+		wantErr     string // substring; "" = success
+		wantBackend bool   // librespot was tried with the stored blob
+		wantWebOnly bool
+	}{
+		{"old premium file", `{"username":"u","data":"YmxvYg==","device_id":"00112233445566778899aabbccddeeff00112233","refresh_token":"rt-1"}`, "", true, false},
+		{"old premium file without refresh token", `{"username":"u","data":"YmxvYg==","device_id":"00112233445566778899aabbccddeeff00112233"}`, "", true, false},
+		{"old file without blob", `{"username":"u","data":null,"refresh_token":"rt-1"}`, "no stored credentials", false, false},
+		{"web-only file", `{"username":"","data":null,"refresh_token":"rt-1","web_only":true}`, "", false, true},
+		{"web-only file without refresh token", `{"web_only":true,"user_id":"u1"}`, "no stored credentials", false, false},
+		{"unknown future field is ignored", `{"username":"u","data":"YmxvYg==","refresh_token":"rt-1","something_new":1}`, "", true, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			f.refreshes(map[string][2]string{"rt-1": {"at-1", "rt-1"}})
+			backend := &fakeBackend{username: "u", data: []byte("blob")}
+			calls := setBackend(t, func(any) (streamBackend, error) { return backend, nil })
+			writeCredsFile(t, tt.file)
+
+			s, err := NewSessionSilent(context.Background(), "cid")
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("err = %v, want %q", err, tt.wantErr)
+				}
+			} else if err != nil {
+				t.Fatalf("NewSessionSilent: %v", err)
+			} else {
+				defer s.Close()
+				if s.WebOnly() != tt.wantWebOnly {
+					t.Fatalf("webOnly = %v, want %v", s.WebOnly(), tt.wantWebOnly)
+				}
+			}
+			if got := len(*calls) > 0; got != tt.wantBackend {
+				t.Fatalf("librespot tried = %v, want %v", got, tt.wantBackend)
+			}
+			if tt.wantBackend {
+				c, ok := (*calls)[0].creds.(session.StoredCredentials)
+				if !ok || c.Username != "u" || string(c.Data) != "blob" {
+					t.Fatalf("librespot creds = %#v", (*calls)[0].creds)
+				}
+				if got := readCredsFile(t); got["web_only"] != nil || got["user_id"] != nil {
+					t.Fatalf("premium file gained web-only fields: %v", got)
+				}
+			}
+		})
+	}
+}
