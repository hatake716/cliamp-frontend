+// fakeCatalog は Catalog の試験用の実装。呼ばれた引数を覚えておく。
+type fakeCatalog struct {
+	providers []ProviderInfo
+	lists     []playlist.PlaylistInfo
+	tracks    []playlist.Track
+	lyrics    []LyricLine
+	synced    bool
+	history   []TrackInfo
+	err       error
+	block     chan struct{} // 閉じられるまで Tracks を待たせる
+	panicMsg  string
+
+	gotProvider, gotID, gotQuery, gotName string
+	gotLimit, gotIndex                    int
+	gotTracks                             []playlist.Track
+	calls                                 []string
+}
+
+func (f *fakeCatalog) Providers() []ProviderInfo {
+	f.calls = append(f.calls, "providers")
+	return f.providers
+}
+
+func (f *fakeCatalog) Playlists(provider string) ([]playlist.PlaylistInfo, error) {
+	f.calls = append(f.calls, "playlists")
+	f.gotProvider = provider
+	return f.lists, f.err
+}
+
+func (f *fakeCatalog) Tracks(provider, id string) ([]playlist.Track, error) {
+	f.calls = append(f.calls, "tracks")
+	f.gotProvider, f.gotID = provider, id
+	if f.panicMsg != "" {
+		panic(f.panicMsg)
+	}
+	if f.block != nil {
+		<-f.block
+	}
+	return f.tracks, f.err
+}
+
+func (f *fakeCatalog) Search(provider, query string, limit int) ([]playlist.Track, error) {
+	f.calls = append(f.calls, "search")
+	f.gotProvider, f.gotQuery, f.gotLimit = provider, query, limit
+	return f.tracks, f.err
+}
+
+func (f *fakeCatalog) Lyrics(artist, title string) ([]LyricLine, bool, error) {
+	f.calls = append(f.calls, "lyrics")
+	f.gotQuery = artist + "/" + title
+	return f.lyrics, f.synced, f.err
+}
+
+func (f *fakeCatalog) History(limit int) ([]TrackInfo, error) {
+	f.calls = append(f.calls, "history")
+	f.gotLimit = limit
+	return f.history, f.err
+}
+
+func (f *fakeCatalog) PlaylistAdd(name string, tracks []playlist.Track) error {
+	f.calls = append(f.calls, "playlist_add")
+	f.gotName, f.gotTracks = name, tracks
+	return f.err
+}
+
+func (f *fakeCatalog) PlaylistDelete(name string) error {
+	f.calls = append(f.calls, "playlist_delete")
