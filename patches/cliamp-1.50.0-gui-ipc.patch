+	for i := range 20 {
+		base = append(base, playlist.Track{Path: fmt.Sprintf("/m/base%02d.flac", i), Title: fmt.Sprintf("base%02d", i)})
+	}
+	if err := p.AddTracks("mix", base); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for w := range 4 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range 25 {
+				id := fmt.Sprintf("w%d-%02d", w, i)
+				if err := p.AddTrack("mix", playlist.Track{Path: "/m/" + id + ".flac", Title: id, Artist: "artist-" + id}); err != nil {
+					t.Errorf("AddTrack: %v", err)
+				}
+			}
+		}()
+	}
+	for range 10 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := p.RemoveTrack("mix", 0); err != nil {
+				t.Errorf("RemoveTrack: %v", err)
+			}
+		}()
+	}
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for range 10 {
+			if err := p.SetBookmark("mix", 5); err != nil { // 長さは 10 より短くならない
+				t.Errorf("SetBookmark: %v", err)
+			}
+		}
+	}()
+	wg.Wait()
+
+	got, err := p.Tracks("mix")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 20-10+4*25 {
+		t.Fatalf("%d tracks, want %d", len(got), 20-10+4*25)
+	}
+	for _, tr := range got {
+		if tr.Path != "/m/"+tr.Title+".flac" || (strings.HasPrefix(tr.Title, "w") && tr.Artist != "artist-"+tr.Title) {
+			t.Fatalf("mixed-up track %+v", tr)
+		}
+	}
+	entries, _ := os.ReadDir(p.dir)
+	for _, e := range entries {
+		if e.Name() != "mix.toml" {
+			t.Fatalf("unexpected file left in the playlist dir: %s", e.Name())
+		}
+	}
+}
+
+// 書き直したプレイリストは、以前と同じく 0644 で残る (一時ファイルは 0600 で作られる)。
+func TestSavePlaylistKeepsMode(t *testing.T) {
+	p := newTestProvider(t)
+	if err := p.SavePlaylist("x", []playlist.Track{{Path: "/a", Title: "a"}}); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(p.dir + "/x.toml")
+	if err != nil || info.Mode().Perm() != 0o644 {
+		t.Fatalf("mode = %v, %v; want 0644", info.Mode(), err)
+	}
+}
+
+func TestRemoveTrackIf(t *testing.T) {
+	p := newTestProvider(t)
+	if err := p.AddTracks("x", []playlist.Track{{Path: "/a", Title: "a"}, {Path: "/b", Title: "b"}}); err != nil {
+		t.Fatal(err)
+	}
+	isB := func(tr playlist.Track) bool { return tr.Path == "/b" }
+	if err := p.RemoveTrackIf("x", 0, isB); !errors.Is(err, ErrTrackMismatch) {
+		t.Fatalf("mismatch err = %v", err)
+	}
+	if got, _ := p.Tracks("x"); len(got) != 2 {
+		t.Fatalf("mismatch changed the playlist: %+v", got)
+	}
+	if err := p.RemoveTrackIf("x", 1, isB); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := p.Tracks("x"); len(got) != 1 || got[0].Path != "/a" {
+		t.Fatalf("after remove = %+v", got)
+	}
+}
