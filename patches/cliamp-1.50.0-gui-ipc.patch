diff --git a/ui/model/ipc_gui.go b/ui/model/ipc_gui.go
new file mode 100644
index 0000000..019f738
--- /dev/null
+++ b/ui/model/ipc_gui.go
@@ -0,0 +1,384 @@
+package model
+
+// ipc_gui.go — GUI 向け拡張 IPC (ipc/gui.go) の状態系コマンドを TUI で処理する。
+//
+// どの処理も Update の goroutine で走るので、I/O はしない (再生の開始は既存の
+// playTrack と同じく tea.Cmd に回る)。答えは ipc.SendReply で必ず 1 回返す。
+// TUI の画面 (オーバーレイやフォーカス) は動かさない。Open-Voice が tmux で
+// キーを打ち込んでいるため、見えない所で画面が変わるとキーが別の所へ落ちる。
+
+import (
+	"fmt"
+
+	tea "charm.land/bubbletea/v2"
+
+	"cliamp/ipc"
+	"cliamp/playlist"
+)
+
+// EQPresetNames は組み込み EQ プリセットの名前を表示順に返す
+// (IPC の capabilities 用)。
+func EQPresetNames() []string {
+	names := make([]string, len(eqPresets))
+	for i, p := range eqPresets {
+		names[i] = p.Name
+	}
+	return names
+}
+
+// ResolveWrapperURLs はラジオの .m3u / .pls の中継 URL を実体の URL へ展開する。
+// TUI がプロバイダーのリストを読むときと同じ処理を IPC のカタログからも使う。
+// ネットワークを待つので Update の中では呼ばないこと。
+func ResolveWrapperURLs(tracks []playlist.Track) []playlist.Track {
+	return resolveWrapperURLs(tracks)
+}
+
+// handleGUIIPC は拡張 IPC のメッセージを処理する。知らないメッセージなら ok=false。
+func (m *Model) handleGUIIPC(msg tea.Msg) (tea.Cmd, bool) {
+	switch msg := msg.(type) {
+	case ipc.PlaylistRequestMsg:
+		resp := ipc.PlaylistSnapshot(m.playlist, msg.Limit)
+		resp.Source = m.listSource()
+		ipc.SendReply(msg.Reply, resp)
+		return nil, true
+	case ipc.PlayIndexMsg:
+		return m.guiPlayIndex(msg), true
+	case ipc.ReplaceMsg:
+		return m.guiReplace(msg), true
+	case ipc.EnqueueMsg:
+		return m.guiEnqueue(msg), true
+	case ipc.QueueEditMsg:
+		return m.guiQueueEdit(msg), true
+	case ipc.RemoveMsg:
+		return m.guiRemove(msg), true
+	}
+	return nil, false
+}
+
+// extendStatus は status の応答に拡張のフィールドを足す (既存のフィールドは
+// 平文の `cliamp status` がそのまま使うので、意味を変えない)。
+func (m *Model) extendStatus(resp *ipc.Response) {
+	resp.API = ipc.APIVersion
+	if cur, idx := m.playlist.Current(); idx >= 0 && cur.Path != "" {
+		ti := ipc.NewTrackInfo(cur)
+		resp.Track = &ti
+	}
+	// yt-dlp のシーク待ちの間は、TUI のつまみと同じくシーク先を返す
+	// (待ちの間の生の位置は古い値のままで、GUI のつまみが跳ね戻るため)。
+	if m.seek.active {
+		resp.Position = m.seek.targetPos.Seconds()
+	}
+	bands := m.player.EQBands()
+	resp.EQ = bands[:]
+	resp.Gen = m.playlist.Gen()
+	resp.Source = m.listSource()
+	resp.StreamTitle = m.streamTitle
+	buffering := m.buffering || m.feedLoading || m.feedTrackPending
+	resp.Buffering = &buffering
+	resp.PlaybackError = m.playbackError()
+}
+
+// setListSource はいまのリストの出どころを覚える。リストが別の経路で
+// 差し替わったら (playlist の Epoch が変わったら) 自然に無効になる。
+func (m *Model) setListSource(src ipc.SourceInfo) {
+	m.guiSource = src
+	m.guiSourceEpoch = m.playlist.Epoch()
+}
+
+// setLocalListSource はローカルのプレイリスト name を出どころとして覚える。
+func (m *Model) setLocalListSource(name string) {
+	m.setListSource(ipc.SourceInfo{Provider: "local", ID: name, Name: name})
+}
+
+// setProviderListSource は TUI のプロバイダー欄から読み込んだリストの出どころを覚える。
+func (m *Model) setProviderListSource() {
+	key := m.providerKey(m.provider)
+	id := m.activeProviderPlaylistID
+	if key == "" || id == "" {
+		m.setListSource(ipc.SourceInfo{})
+		return
+	}
+	src := ipc.SourceInfo{Provider: key, ID: id}
+	for _, pl := range m.providerLists {
+		if pl.ID == id {
+			src.Name = pl.Name
+			break
+		}
+	}
+	m.setListSource(src)
+}
+
+func (m *Model) listSource() *ipc.SourceInfo {
+	if m.guiSourceEpoch != m.playlist.Epoch() || m.guiSource == (ipc.SourceInfo{}) {
+		return nil
+	}
+	src := m.guiSource
+	return &src
+}
+
+// providerKey は登録されたプロバイダーの設定キー ("spotify" など) を返す。
+func (m *Model) providerKey(p playlist.Provider) string {
+	if p == nil {
+		return ""
+	}
+	for _, e := range m.providers {
+		if e.Provider == p {
+			return e.Key
+		}
+	}
+	return ""
+}
+
+// peekNextPath は次に鳴る曲の path を返す。先読みのやり直しが要るかの判定用。
+func (m *Model) peekNextPath() (string, bool) {
+	t, ok := m.playlist.PeekNext()
+	return t.Path, ok
+}
+
+// repreloadIfNextChanged は、リストや待ち行列の変更で次に鳴る曲が変わったとき
+// だけ gapless の先読みを捨てて取り直す。捨てないと、先読みした古い曲が鳴るのに
+// 表示は新しい曲へ進んでしまう。
+func (m *Model) repreloadIfNextChanged(beforePath string, beforeOK bool) tea.Cmd {
+	after, ok := m.peekNextPath()
+	if after == beforePath && ok == beforeOK {
+		return nil
+	}
+	m.player.ClearPreload()
+	if !m.player.IsPlaying() || m.buffering {
+		return nil
+	}
+	return m.preloadNext()
+}
+
+// refreshPlaylistViews は曲の添字が変わったあと、TUI 側で添字を握っている
+// 表示を合わせる。開いている検索欄の結果は添字の一覧なので、作り直さないと
+// 描画で範囲外を引いて落ちる。画面やフォーカスは変えない。
+func (m *Model) refreshPlaylistViews() {
+	if n := m.playlist.Len(); m.plCursor >= n {
+		m.plCursor = max(n-1, 0)
+	}
+	if m.search.active {
+		m.updateSearch()
+	}
+	if q := m.playlist.QueueLen(); m.queue.cursor >= q {
+		m.queue.cursor = max(q-1, 0)
+	}
+	m.adjustScroll()
+}
+
+// staleIndex は、GUI が添字と一緒に送った path (空なら確かめない) が
+// いまのリストのその曲と違うかを返す。違えば GUI の写しが古い
+// (TUI や別の操作でリストが動いた) ので、別の曲を操作しないよう断る。
+func (m *Model) staleIndex(index int, path string) bool {
+	return ipc.PathMismatch(m.playlist.Tracks()[index].Path, path)
+}
+
+// staleQueuePos は staleIndex の、待ち行列の位置 pos で指す版 (queue_edit move)。
+// 待ち行列の位置は、待ち行列の曲が鳴り始めるたびに 1 つずつ詰まる。範囲外は
+// false (範囲は MoveQueueTo が見る)。
+func (m *Model) staleQueuePos(pos int, path string) bool {
+	q := m.playlist.QueueIndices()
+	return pos >= 0 && pos < len(q) && m.staleIndex(q[pos], path)
+}
+
+// guiPlayIndex は TUI の「行で Enter」と同じ (keys.go の enter)。
+func (m *Model) guiPlayIndex(msg ipc.PlayIndexMsg) tea.Cmd {
+	if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return nil
+	}
+	if m.staleIndex(msg.Index, msg.Path) {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+		return nil
+	}
+	if (m.buffering || m.feedTrackPending) && msg.Index == m.playlist.Index() {
+		// その曲をいま読み込んでいる。Enter と同じく何もしない。
+		ipc.SendReply(msg.Reply, ipc.Response{OK: true})
+		return nil
+	}
+	m.scrobbleCurrent()
+	m.playlist.SetIndex(msg.Index)
+	cmd := m.playCurrentTrack()
+	m.notifyPlayback()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true})
+	return cmd
+}
+
+// guiReplace はリストを差し替えて Index の曲から再生する。プレイリスト管理の
+// plMgrLoadAndPlay と同じ順 (Stop・ClearPreload を先に。残った先読みが新しい
+// リストで GaplessAdvanced を起こさないように)。画面は切り替えない。
+func (m *Model) guiReplace(msg ipc.ReplaceMsg) tea.Cmd {
+	if len(msg.Tracks) == 0 || msg.Index < 0 || msg.Index >= len(msg.Tracks) {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return nil
+	}
+	m.scrobbleCurrent()
+	m.player.Stop()
+	m.player.ClearPreload()
+	m.resetYTDLBatch()
+	m.playlist.Replace(msg.Tracks)
+	m.playlist.StartAt(msg.Index)
+	m.setInitialHeaderState(msg.Tracks)
+	m.setListSource(msg.Source)
+
+	// ブックマークの書き込み先と、プロバイダー欄の強調を合わせる。
+	m.loadedPlaylist = ""
+	if msg.Source.Provider == "local" {
+		m.loadedPlaylist = msg.Source.ID
+	}
+	m.activeProviderPlaylistID = ""
+	if msg.Source.Provider != "" && msg.Source.Provider == m.providerKey(m.provider) {
+		m.activeProviderPlaylistID = msg.Source.ID
+	}
+
+	m.plCursor = msg.Index
+	m.refreshPlaylistViews()
+	m.status.Showf(statusTTLDefault, "Loaded %d track(s)", len(msg.Tracks))
+	cmd := m.playCurrentTrack()
+	// YouTube のミックス (list=RD…) は最初の 20 曲だけなので、TUI で URL を
+	// 開いたときと同じく残りを裏で読み足す。
+	if msg.Source.Provider == "url" && msg.Source.ID != "" {
+		if batch := m.initYTDLBatch([]string{msg.Source.ID}); batch != nil {
+			cmd = tea.Batch(cmd, batch)
+		}
+	}
+	m.notifyAll()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Total: m.playlist.Len(), Gen: m.playlist.Gen()})
+	return cmd
+}
+
+// guiEnqueue は曲を足す。next は「次に再生」(いまの曲のすぐ後ろ)、end は
+// TUI の a (appendTrack)、now は Enter (playTrackImmediate) にあたる。複数曲を
+// まとめて扱うため、既存の 1 曲用の関数を繰り返し呼ばずに同じ手順を書いている
+// (繰り返すと、読み込み中に 2 曲目がまた再生を始めてしまう)。並べ方は
+// daemon と共用の playlist の関数 (playlist/gui.go) で行う。
+func (m *Model) guiEnqueue(msg ipc.EnqueueMsg) tea.Cmd {
+	if len(msg.Tracks) == 0 {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "enqueue requires tracks"})
+		return nil
+	}
+	// フィードの展開待ちも止まっているとみなす: 足した曲を始めれば展開は
+	// 取り消される (待たせると、展開したエピソードがリストごと置き換えて
+	// 足した曲が消える)。
+	idle := !m.player.IsPlaying() && !m.buffering
+	beforePath, beforeOK := m.peekNextPath()
+	first := msg.Tracks[0]
+	mode := msg.Mode
+	if mode == "next" && m.playlist.Len() == 0 {
+		// 空のリストに「次に再生」は、末尾に足して先頭から鳴らすのと同じ。
+		mode = "end"
+	}
+
+	var cmd tea.Cmd
+	switch mode {
+	case "now":
+		m.scrobbleCurrent()
+		m.player.Stop()
+		m.player.ClearPreload()
+		start := m.playlist.AddNow(msg.Tracks...)
+		m.plCursor = start
+		m.status.Showf(statusTTLMedium, "Playing: %s", first.DisplayName())
+		cmd = m.playCurrentTrack()
+		m.notifyPlayback()
+	case "end":
+		m.status.Showf(statusTTLMedium, "Added: %s", first.DisplayName())
+		if idle {
+			start := m.playlist.AddAndSelect(msg.Tracks...)
+			m.plCursor = start
+			cmd = m.playCurrentTrack()
+			m.notifyPlayback()
+		} else {
+			m.playlist.Add(msg.Tracks...)
+			cmd = m.repreloadIfNextChanged(beforePath, beforeOK)
+		}
+	default: // "next"
+		m.playlist.PlayNext(msg.Tracks...)
+		m.status.Showf(statusTTLMedium, "Queued: %s", first.DisplayName())
+		if idle {
+			cmd = m.nextTrack()
+			m.notifyPlayback()
+		} else {
+			cmd = m.repreloadIfNextChanged(beforePath, beforeOK)
+		}
+	}
+	m.refreshPlaylistViews()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Total: m.playlist.Len(), Gen: m.playlist.Gen()})
+	return cmd
+}
+
+// guiQueueEdit は「次に再生」の待ち行列を編集する (TUI の a と A の画面にあたる)。
+func (m *Model) guiQueueEdit(msg ipc.QueueEditMsg) tea.Cmd {
+	beforePath, beforeOK := m.peekNextPath()
+	switch msg.Mode {
+	case "add":
+		if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+			return nil
+		}
+		if m.staleIndex(msg.Index, msg.Path) {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+			return nil
+		}
+		if m.playlist.QueuePosition(msg.Index) == 0 {
+			m.playlist.Queue(msg.Index)
+		}
+	case "remove":
+		if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+			return nil
+		}
+		if m.staleIndex(msg.Index, msg.Path) {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+			return nil
+		}
+		m.playlist.Dequeue(msg.Index)
+	case "move":
+		if m.staleQueuePos(msg.Index, msg.Path) {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+			return nil
+		}
+		if !m.playlist.MoveQueueTo(msg.Index, msg.To) {
+			ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "queue position out of range"})
+			return nil
+		}
+	case "clear":
+		m.playlist.ClearQueue()
+	default:
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: fmt.Sprintf("queue_edit: unknown mode %q", msg.Mode)})
+		return nil
+	}
+	m.refreshPlaylistViews()
+	cmd := m.repreloadIfNextChanged(beforePath, beforeOK)
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Queue: m.playlist.QueueIndices(), Gen: m.playlist.Gen()})
+	return cmd
+}
+
+// guiRemove はリストから 1 曲消す。再生中 (一時停止・読み込み中を含む) の曲は
+// 消さない。TUI の removeSelectedFromPlaylist は再生を止めてしまうが、GUI から
+// 誤って今の曲を消して音が途切れるのを避けるため。
+func (m *Model) guiRemove(msg ipc.RemoveMsg) tea.Cmd {
+	if msg.Index < 0 || msg.Index >= m.playlist.Len() {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "index out of range"})
+		return nil
+	}
+	if m.staleIndex(msg.Index, msg.Path) {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: ipc.ErrStale.Error()})
+		return nil
+	}
+	if msg.Index == m.playlist.Index() && (m.player.IsPlaying() || m.buffering || m.feedTrackPending) {
+		ipc.SendReply(msg.Reply, ipc.Response{OK: false, Error: "cannot remove the current track"})
+		return nil
+	}
+	beforePath, beforeOK := m.peekNextPath()
+	track := m.playlist.Tracks()[msg.Index]
+	m.playlist.Remove(msg.Index)
+	if m.plCursor > msg.Index {
+		m.plCursor--
+	}
+	m.refreshPlaylistViews()
+	m.status.Showf(statusTTLDefault, "Removed: %s", track.DisplayName())
+	cmd := m.repreloadIfNextChanged(beforePath, beforeOK)
+	m.notifyPlayback()
+	ipc.SendReply(msg.Reply, ipc.Response{OK: true, Total: m.playlist.Len(), Gen: m.playlist.Gen()})
+	return cmd
+}
diff --git a/ui/model/ipc_gui_playerr.go b/ui/model/ipc_gui_playerr.go
new file mode 100644
index 0000000..1ad11a9
--- /dev/null
+++ b/ui/model/ipc_gui_playerr.go
@@ -0,0 +1,55 @@
+package model
+
+// ipc_gui_playerr.go — status の playback_error を TUI で持つ。
+//
+// m.err (画面の "ERR: …") は設定の保存・プロバイダーの読み込み・歌詞など、
+// 再生と関係の無い誤りにも使われ、再生が始まっても消えないことがある。GUI には
+// 「いまの曲の最後の開始が失敗した」ことだけを伝えるので、再生の失敗の経路
+// (流れ・yt-dlp の開始の失敗、手元のファイルの同期の Play の失敗、フィードの
+// 展開の失敗、yt-dlp のシークによる組み直しの失敗) でだけ立て、次の開始
+// (beginPlay。同じ曲のやり直しも) と gapless で次の曲へ進んだときに消す。
+
+import (
+	"errors"
+
+	"cliamp/player"
+)
+
+// errNoEpisodes はフィードの曲を展開したらエピソードが無かったとき (鳴らせない)。
+var errNoEpisodes = errors.New("no episodes found in feed")
+
+// playFailed は最後の開始が err で失敗したことを記録する。追い越された開始
+// (ErrSuperseded) は失敗ではない (新しい開始が進んでいる)。
+func (m *Model) playFailed(err error) {
+	if errors.Is(err, player.ErrSuperseded) {
+		return
+	}
+	m.playFail.Fail(err)
+}
+
+// seekFinished はシークの完了 (seekTickMsg) を受ける。yt-dlp の曲はシークの
+// たびに yt-dlp を起こし直し、失敗すると音が止まったままになるので、再生の
+// 失敗として記録する (後のシークが成功すれば音が戻るので消す)。HTTP の流れの
+// シークは失敗しても前の流れに戻り、手元のファイルのシークは曲を止めないので
+// 記録しない。シークの後に別の曲を始めていたら (playSeq が進んでいたら) 古い
+// 曲のシークなので捨てる。
+func (m *Model) seekFinished(msg seekTickMsg) {
+	if msg.seq != m.playSeq || !m.player.IsYTDLSeek() {
+		return
+	}
+	if msg.err == nil {
+		m.playFail.SeekOK()
+		return
+	}
+	m.playFail.FailSeek(msg.err)
+}
+
+// playbackError は status の playback_error。いまの曲が最後に失敗した曲の
+// ときだけ返す。
+func (m *Model) playbackError() string {
+	cur, idx := m.playlist.Current()
+	if idx < 0 {
+		return ""
+	}
+	return m.playFail.Text(cur.Path)
+}
diff --git a/ui/model/ipc_gui_playerr_test.go b/ui/model/ipc_gui_playerr_test.go
new file mode 100644
index 0000000..dda2933
--- /dev/null
+++ b/ui/model/ipc_gui_playerr_test.go
@@ -0,0 +1,374 @@
+package model
+
+// status の playback_error (ipc_gui_playerr.go) の試験。
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+
+	"cliamp/internal/playback"
+	"cliamp/ipc"
+	"cliamp/player"
+	"cliamp/playlist"
+)
+
+// ageGateErr は yt-dlp が年齢確認の要る動画で出す誤り (cliamp は stderr をそのまま包む)。
+var ageGateErr = errors.New("yt-dlp: ERROR: [youtube] x8VYWazR5mE: Sign in to confirm your age. " +
+	"This video may be inappropriate for some users. Use --cookies-from-browser or --cookies for the authentication.")
+
+// failEngine は開始やシークの失敗を返せるプレイヤー。
+type failEngine struct {
+	guiFakeEngine
+	playErr    error // Play が返す値
+	ytdlErr    error // PlayYTDL が返す値
+	seekErr    error // Seek / SeekYTDL が返す値
+	ytdlSeek   bool  // IsYTDLSeek (yt-dlp を起こし直すシーク)
+	streamSeek bool  // IsStreamSeek (シークを Cmd で行う)
+}
+
+func (f *failEngine) Play(path string, _ time.Duration) error {
+	f.playCalls = append(f.playCalls, path)
+	if f.playErr != nil {
+		f.playing = false
+		return f.playErr
+	}
+	f.playing = true
+	return nil
+}
+
+func (f *failEngine) PlayYTDL(path string, _ time.Duration) error {
+	f.playCalls = append(f.playCalls, path)
+	if f.ytdlErr != nil {
+		return f.ytdlErr
+	}
+	f.playing = true
+	return nil
+}
+
+func (f *failEngine) Seek(time.Duration) error     { return f.seekErr }
+func (f *failEngine) SeekYTDL(time.Duration) error { return f.seekErr }
+func (f *failEngine) IsYTDLSeek() bool             { return f.ytdlSeek }
+func (f *failEngine) IsStreamSeek() bool           { return f.streamSeek }
+
+func newFailModel(tracks ...playlist.Track) (Model, *failEngine) {
+	m, _ := newGUITestModel()
+	eng := &failEngine{}
+	m.player = eng
+	m.playlist.Replace(tracks)
+	m.playlist.SetIndex(0)
+	return m, eng
+}
+
+func ytTrack(id string) playlist.Track {
+	return playlist.Track{Path: "https://www.youtube.com/watch?v=" + id, Title: id, Stream: true}
+}
+
+func statusOf(t *testing.T, m Model) (Model, ipc.Response) {
+	t.Helper()
+	return sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.StatusRequestMsg{Reply: r} })
+}
+
+func playbackErrorOf(t *testing.T, m Model) string {
+	t.Helper()
+	_, resp := statusOf(t, m)
+	return resp.PlaybackError
+}
+
+// yt-dlp の開始の失敗 (年齢確認) は、いまの曲のまま止まった状態で
+// playback_error に出る。同じ曲をやり直すと、始めた時点で消える。
+func TestPlaybackErrorFromFailedYTDLStart(t *testing.T) {
+	m, eng := newFailModel(ytTrack("x8VYWazR5mE"), ytTrack("b"))
+	eng.ytdlErr = ageGateErr
+	m = settle(t, m, m.playCurrentTrack())
+
+	m, resp := statusOf(t, m)
+	if resp.PlaybackError != ageGateErr.Error() {
+		t.Fatalf("playback_error = %q, want the yt-dlp error", resp.PlaybackError)
+	}
+	if resp.State != "stopped" || resp.Track == nil || resp.Track.Path != ytTrack("x8VYWazR5mE").Path {
+		t.Fatalf("status = state %q track %+v, want the failed track, stopped", resp.State, resp.Track)
+	}
+	if m.err == nil {
+		t.Fatal("the TUI's own ERR line should still show the error")
+	}
+
+	// やり直し: 読み込み中は失敗を出さない (新しい開始が進んでいる)。
+	eng.ytdlErr = nil
+	cmd := m.playCurrentTrack()
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error while retrying = %q, want empty", got)
+	}
+	m = settle(t, m, cmd)
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error after a successful retry = %q, want empty", got)
+	}
+}
+
+// 別の曲を始めたら (失敗した曲から移ったら) 消える。
+func TestPlaybackErrorClearedByNextTrack(t *testing.T) {
+	m, eng := newFailModel(ytTrack("a"), ytTrack("b"))
+	eng.ytdlErr = ageGateErr
+	m = settle(t, m, m.playCurrentTrack())
+	if playbackErrorOf(t, m) == "" {
+		t.Fatal("expected a playback error")
+	}
+	eng.ytdlErr = nil
+	m, cmd := update(m, playback.NextMsg{})
+	m = settle(t, m, cmd)
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error after next = %q, want empty", got)
+	}
+}
+
+// 失敗した曲がいまの曲でなくなったら (止まっている間に別の行が選ばれた、
+// リストが差し替わった) 出さない。
+func TestPlaybackErrorOnlyForTheFailedTrack(t *testing.T) {
+	m, eng := newFailModel(ytTrack("a"), ytTrack("b"))
+	eng.ytdlErr = ageGateErr
+	m = settle(t, m, m.playCurrentTrack())
+	m.playlist.SetIndex(1)
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error for another track = %q, want empty", got)
+	}
+	m.playlist.SetIndex(0)
+	if got := playbackErrorOf(t, m); got != ageGateErr.Error() {
+		t.Fatalf("playback_error back on the failed track = %q", got)
+	}
+}
+
+// 手元のファイルの同期の Play の失敗 (無いファイル・読めない形式) も出す。
+// Spotify のサインイン切れは TUI ではサインインの画面を出して ERR を出さないが、
+// GUI には理由を渡す。
+func TestPlaybackErrorFromSynchronousPlay(t *testing.T) {
+	missing := errors.New("open source: open /music/gone.flac: no such file or directory")
+	m, eng := newFailModel(playlist.Track{Path: "/music/gone.flac", Title: "gone"})
+	eng.playErr = missing
+	m = settle(t, m, m.playCurrentTrack())
+	if got := playbackErrorOf(t, m); got != missing.Error() {
+		t.Fatalf("playback_error = %q, want %q", got, missing)
+	}
+
+	auth := fmt.Errorf("custom streamer: spotify: stream auth error after silent reconnect: %w", playlist.ErrNeedsAuth)
+	m, eng = newFailModel(playlist.Track{Path: "spotify:track:abc", Title: "s"})
+	eng.playErr = auth
+	m = settle(t, m, m.playCurrentTrack())
+	if got := playbackErrorOf(t, m); got != auth.Error() {
+		t.Fatalf("playback_error = %q, want %q", got, auth)
+	}
+	if m.err != nil || !m.provSignIn {
+		t.Fatalf("TUI: err=%v provSignIn=%v, want the sign-in overlay without ERR", m.err, m.provSignIn)
+	}
+}
+
+// 再生と関係の無い誤り (プロバイダーの読み込み・設定の保存など、Update に
+// そのまま届く error) は m.err には出ても playback_error には出ない。
+func TestPlaybackErrorIgnoresUnrelatedErrors(t *testing.T) {
+	m, _ := newFailModel(playlist.Track{Path: "/music/a.flac", Title: "a"})
+	m = settle(t, m, m.playCurrentTrack())
+	m, _ = update(m, errors.New("save config: permission denied"))
+	if m.err == nil {
+		t.Fatal("expected the TUI ERR line")
+	}
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error = %q, want empty for an unrelated error", got)
+	}
+}
+
+// 追い越された古い開始の失敗や ErrSuperseded は記録しない。
+func TestPlaybackErrorIgnoresStaleStarts(t *testing.T) {
+	m, eng := newFailModel(ytTrack("a"), ytTrack("b"))
+	eng.ytdlErr = ageGateErr
+	late := runCmd(m.playCurrentTrack()) // a の開始は失敗で終わるが、届くのは b の後
+	m.playlist.SetIndex(1)
+	eng.ytdlErr = nil
+	m = settle(t, m, m.playCurrentTrack()) // b が鳴る
+	for _, msg := range late {
+		m, _ = update(m, msg)
+	}
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error from a superseded start = %q", got)
+	}
+
+	m, eng = newFailModel(ytTrack("a"))
+	eng.ytdlErr = player.ErrSuperseded
+	m = settle(t, m, m.playCurrentTrack())
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error for ErrSuperseded = %q", got)
+	}
+
+	// 手元のファイルの同期の Play も、裏で始まった別の開始に追い越されうる。
+	m, eng = newFailModel(playlist.Track{Path: "/music/a.flac", Title: "a"})
+	eng.playErr = player.ErrSuperseded
+	m = settle(t, m, m.playCurrentTrack())
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error for a superseded synchronous Play = %q", got)
+	}
+}
+
+// フィードの展開の失敗・エピソードが無いときも、その曲の失敗として出す。
+func TestPlaybackErrorFromFeedResolution(t *testing.T) {
+	feed := playlist.Track{Path: "https://example.com/podcast.xml", Title: "pod", Feed: true}
+	for _, tc := range []struct {
+		msg  func(m Model) feedTrackResolvedMsg
+		want string
+	}{
+		{func(m Model) feedTrackResolvedMsg {
+			return feedTrackResolvedMsg{err: errors.New("http status 404 Not Found"), seq: m.playSeq, epoch: m.playlist.Epoch()}
+		}, "http status 404 Not Found"},
+		{func(m Model) feedTrackResolvedMsg {
+			return feedTrackResolvedMsg{seq: m.playSeq, epoch: m.playlist.Epoch()}
+		}, errNoEpisodes.Error()},
+	} {
+		m, _ := newFailModel(feed)
+		_ = m.playCurrentTrack() // 展開の Cmd はネットワークに出るので走らせない
+		m, _ = update(m, tc.msg(m))
+		m, resp := statusOf(t, m)
+		if resp.PlaybackError != tc.want || *resp.Buffering {
+			t.Fatalf("playback_error = %q buffering=%v, want %q", resp.PlaybackError, *resp.Buffering, tc.want)
+		}
+	}
+}
+
+// yt-dlp の曲のシーク (yt-dlp の起こし直し) の失敗は音が止まるので出す。
+// HTTP の流れのシークの失敗 (前の流れに戻る) と、別の曲を始めた後に届いた
+// 古いシークの失敗は出さない。
+func TestPlaybackErrorFromYTDLSeek(t *testing.T) {
+	seekErr := errors.New("yt-dlp seek: yt-dlp: ERROR: [youtube] a: HTTP Error 403: Forbidden")
+	// 長さの分かる yt-dlp の曲は Seek (IsStreamSeek) を、分からない曲は SeekYTDL を通る。
+	for _, known := range []bool{true, false} {
+		m, eng := newFailModel(ytTrack("a"), ytTrack("b"))
+		m = settle(t, m, m.playCurrentTrack())
+		eng.seekErr = seekErr
+		eng.ytdlSeek = true
+		eng.streamSeek = known
+		m, cmd := update(m, playback.SetPositionMsg{Position: 30 * time.Second})
+		if cmd == nil {
+			t.Fatal("expected an async seek")
+		}
+		m = settle(t, m, cmd)
+		if got := playbackErrorOf(t, m); got != seekErr.Error() {
+			t.Fatalf("known=%v: playback_error after a failed yt-dlp seek = %q", known, got)
+		}
+		// 次のシークが成功すれば (yt-dlp を起こし直せたら) 音が戻るので消える。
+		eng.seekErr = nil
+		m, cmd = update(m, playback.SetPositionMsg{Position: 40 * time.Second})
+		m = settle(t, m, cmd)
+		if got := playbackErrorOf(t, m); got != "" {
+			t.Fatalf("known=%v: playback_error after a successful seek = %q", known, got)
+		}
+	}
+
+	// 開始の失敗は、(前の曲の流れへの) シークが成功しても消えない。
+	{
+		m, eng := newFailModel(ytTrack("a"))
+		eng.ytdlErr = ageGateErr
+		m = settle(t, m, m.playCurrentTrack())
+		eng.ytdlSeek, eng.streamSeek = true, true
+		m, cmd := update(m, playback.SetPositionMsg{Position: 30 * time.Second})
+		m = settle(t, m, cmd)
+		if got := playbackErrorOf(t, m); got != ageGateErr.Error() {
+			t.Fatalf("a successful seek cleared the start failure: %q", got)
+		}
+	}
+
+	m, eng := newFailModel(playlist.Track{Path: "https://example.com/ep.mp3", Title: "ep", Stream: true}, ytTrack("b"))
+	m = settle(t, m, m.playCurrentTrack())
+	eng.seekErr = errors.New("seek reconnect: http get: connection refused")
+	eng.streamSeek = true
+	m, cmd := update(m, playback.SetPositionMsg{Position: 30 * time.Second})
+	m = settle(t, m, cmd)
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error after a failed HTTP seek = %q, want empty", got)
+	}
+
+	m, eng = newFailModel(ytTrack("a"), ytTrack("b"))
+	m = settle(t, m, m.playCurrentTrack())
+	eng.seekErr = seekErr
+	eng.ytdlSeek = true
+	eng.streamSeek = true
+	m, seek := update(m, playback.SetPositionMsg{Position: 30 * time.Second})
+	m, next := update(m, playback.NextMsg{})
+	m = settle(t, m, next)
+	m = settle(t, m, seek)
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error from the previous track's seek = %q, want empty", got)
+	}
+}
+
+// 止めても (stop) 失敗は残る (TUI の ERR と同じ。いまの曲はまだ失敗した曲)。
+// JSON では、失敗していなければ playback_error は省かれる。
+func TestPlaybackErrorWire(t *testing.T) {
+	m, eng := newFailModel(ytTrack("a"))
+	m, resp := statusOf(t, m)
+	raw, _ := json.Marshal(resp)
+	if strings.Contains(string(raw), "playback_error") {
+		t.Fatalf("status without an error carries playback_error: %s", raw)
+	}
+	eng.ytdlErr = ageGateErr
+	m = settle(t, m, m.playCurrentTrack())
+	m, _ = update(m, playback.StopMsg{})
+	_, resp = statusOf(t, m)
+	raw, _ = json.Marshal(resp)
+	if !strings.Contains(string(raw), `"playback_error":"yt-dlp: ERROR: [youtube] x8VYWazR5mE`) {
+		t.Fatalf("status after stop: %s", raw)
+	}
+}
+
+// 長すぎる理由は文字の途中で切らずに縮める。
+func TestPlaybackErrorTruncated(t *testing.T) {
+	long := errors.New(strings.Repeat("あ", 2000))
+	m, eng := newFailModel(ytTrack("a"))
+	eng.ytdlErr = long
+	m = settle(t, m, m.playCurrentTrack())
+	got := playbackErrorOf(t, m)
+	if len(got) > 2048 || !strings.HasSuffix(got, "…") || !strings.HasPrefix(got, "あああ") {
+		t.Fatalf("truncated playback_error: len=%d suffix=%q", len(got), got[len(got)-6:])
+	}
+	for _, r := range got {
+		if r == '�' {
+			t.Fatal("truncation split a character")
+		}
+	}
+}
+
+// gaplessEngine は次の tick で gapless が次の曲へ進んだと答える。
+type gaplessEngine struct {
+	failEngine
+	advanced bool
+}
+
+func (f *gaplessEngine) GaplessAdvanced() bool {
+	adv := f.advanced
+	f.advanced = false
+	return adv
+}
+
+// gapless で次の曲へ進んだら (開始を経ずに曲が変わったら) 前の失敗は消える。
+// 1 曲リピートで同じ曲へ進んだときも、その曲は新しく鳴り始めている。
+func TestPlaybackErrorClearedByGaplessAdvance(t *testing.T) {
+	m, _ := newGUITestModel()
+	eng := &gaplessEngine{}
+	m.player = eng
+	m.playlist.Replace([]playlist.Track{ytTrack("a")})
+	m.playlist.SetIndex(0)
+	m.playlist.SetRepeat(playlist.RepeatOne)
+	m = settle(t, m, m.playCurrentTrack())
+	eng.seekErr = errors.New("yt-dlp seek: timed out waiting for audio data (30s)")
+	eng.ytdlSeek, eng.streamSeek = true, true
+	m, cmd := update(m, playback.SetPositionMsg{Position: 30 * time.Second})
+	m = settle(t, m, cmd)
+	if playbackErrorOf(t, m) == "" {
+		t.Fatal("expected a playback error after the failed seek")
+	}
+	eng.advanced = true
+	m, _ = update(m, tickMsg(time.Now()))
+	if got := playbackErrorOf(t, m); got != "" {
+		t.Fatalf("playback_error after a gapless advance = %q, want empty", got)
+	}
+}
diff --git a/ui/model/ipc_gui_stale.go b/ui/model/ipc_gui_stale.go
new file mode 100644
index 0000000..102223f
--- /dev/null
+++ b/ui/model/ipc_gui_stale.go
@@ -0,0 +1,121 @@
+package model
+
+// ipc_gui_stale.go — 遅れて届いた古い非同期の結果を捨てる。
+//
+// 再生の開始 (yt-dlp・HTTP)、gapless の先読み、フィードの展開はどれも
+// tea.Cmd で走り、数秒かかる。その間に GUI (や TUI) が別の曲を選ぶと、
+// 古い結果が後から届いて新しい状態を上書きしていた (表示と違う曲が鳴る、
+// 「次に再生」した曲が飛ばされる、差し替えたリストがフィードのエピソードに
+// 戻る)。どの Cmd にも出したときの番号を持たせ、届いたときに最新でなければ
+// 捨てる。GUI の操作はクリックひとつで起きるので、TUI のキー操作よりずっと
+// 起きやすい。
+
+import (
+	"errors"
+
+	tea "charm.land/bubbletea/v2"
+
+	"cliamp/player"
+)
+
+// beginPlay は playTrack のたびに呼び、この開始の番号を返す。フィードの曲なら
+// 展開待ちの印を立て、そうでなければ前のフィードの展開待ちを取り消す
+// (新しい開始が勝つ。遅れて届く展開の結果は dropStaleFeed で捨てる)。
+// 前の開始の失敗 (playback_error) もここで消す。
+func (m *Model) beginPlay(path string, feed bool) uint64 {
+	m.playSeq++
+	m.playFail.Begin(path)
+	switch {
+	case feed:
+		m.feedTrackPending = true
+	case m.feedTrackPending:
+		m.feedTrackPending = false
+		m.feedLoading = false
+	}
+	return m.playSeq
+}
+
+// cancelPendingStart は止めたとき (stop) に呼ぶ。読み込み中の開始や
+// フィードの展開を取り消し、遅れて届く結果を捨てさせる (止めたのに後から
+// 鳴り出したり、読み込み中のまま再生の操作を受け付けなかったりしないように)。
+func (m *Model) cancelPendingStart() {
+	m.playSeq++
+	m.buffering = false
+	if m.feedTrackPending {
+		m.feedTrackPending = false
+		m.feedLoading = false
+	}
+}
+
+// dropStalePlayed は streamPlayedMsg が古い開始のものなら捨てる (true)。
+// 新しい開始が進行中なら buffering はそちらが下ろす。プレイヤーが
+// ErrSuperseded を返した (開始の途中で Stop された) ときは読み込み待ちを
+// 下ろす。ただし鳴っているなら、後から始まった古い開始が勝っているので、
+// いまの曲をもう一度始める。
+func (m *Model) dropStalePlayed(msg streamPlayedMsg) (bool, tea.Cmd) {
+	if msg.seq != m.playSeq {
+		return true, nil
+	}
+	if !errors.Is(msg.err, player.ErrSuperseded) {
+		return false, nil
+	}
+	if m.player.IsPlaying() {
+		if track, idx := m.playlist.Current(); idx >= 0 {
+			return true, m.playTrack(track)
+		}
+	}
+	m.buffering = false
+	m.notifyAll()
+	return true, nil
+}
+
+// dropStaleFeed は feedTrackResolvedMsg が古い要求のものなら捨てる (true)。
+// 要求のあとに別の曲を始めた (playSeq が進んだ) か、リストが差し替わった
+// (Epoch が変わった) なら、展開したエピソードでリストを置き換えない。
+func (m *Model) dropStaleFeed(msg feedTrackResolvedMsg) bool {
+	if msg.seq != m.playSeq {
+		return true // 新しい開始が展開待ちの印を下ろしている
+	}
+	m.feedTrackPending = false
+	if msg.epoch != m.playlist.Epoch() {
+		m.feedLoading = false
+		return true
+	}
+	return false
+}
+
+// beginPreload は先読みを始めるたびに呼び、その番号を返す。
+func (m *Model) beginPreload() uint64 {
+	m.preloading = true
+	m.preloadSeq++
+	return m.preloadSeq
+}
+
+// preloadFinished は先読みの完了 (streamPreloadedMsg) を受ける。
+// プレイヤーは最後に終わった先読みを gapless の次に据えるので、次の曲が
+// 変わったあとに古い先読みが遅れて終わると、表示は新しい次の曲へ進むのに
+// 古い曲が鳴る。
+//   - 新しい先読みがまだ走っていれば、それが上書きするので何もしない。
+//   - 古い先読みが新しいものの後に終わった (上書きした) なら、捨てて取り直す。
+//   - 最新の先読みでも、その間に次の曲が変わっていれば (取り直しが
+//     読み込み中などで見送られたとき)、捨てて取り直す。
+func (m *Model) preloadFinished(msg streamPreloadedMsg) tea.Cmd {
+	if msg.seq != m.preloadSeq {
+		if m.preloading || msg.err != nil {
+			return nil // 新しい先読みが上書きする / 失敗して何も据えていない
+		}
+	} else {
+		m.preloading = false
+		if msg.err != nil {
+			return nil // 何も据えていない。tick が取り直す
+		}
+		if want, ok := m.playlist.PeekNext(); ok && want.Path == msg.path {
+			return nil
+		}
+	}
+	m.player.ClearPreload()
+	if m.player.IsPlaying() && !m.player.IsPaused() && !m.buffering {
+		return m.preloadNext()
+	}
+	return nil
+}
diff --git a/ui/model/ipc_gui_stale_test.go b/ui/model/ipc_gui_stale_test.go
new file mode 100644
index 0000000..1826fbc
--- /dev/null
+++ b/ui/model/ipc_gui_stale_test.go
@@ -0,0 +1,535 @@
+package model
+
+// 遅れて届く古い非同期の結果 (ipc_gui_stale.go) と、GUI の enqueue・remove の
+// 並べ方の試験。
+
+import (
+	"errors"
+	"slices"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+
+	"cliamp/internal/playback"
+	"cliamp/ipc"
+	"cliamp/player"
+	"cliamp/playlist"
+)
+
+// raceEngine は本物のプレイヤーの「最後に終わった Preload が gapless の次に
+// 据わる」を真似る。ytdlErr は PlayYTDL が返す値 (本物は、組み立て中に
+// Stop や別の開始があると ErrSuperseded を返す)。
+type raceEngine struct {
+	guiFakeEngine
+	armed   string
+	ytdlErr error
+}
+
+func (f *raceEngine) PlayYTDL(path string, _ time.Duration) error {
+	f.playCalls = append(f.playCalls, path)
+	if f.ytdlErr != nil {
+		return f.ytdlErr
+	}
+	f.playing = true
+	return nil
+}
+func (f *raceEngine) Preload(path string, _ time.Duration) error     { f.armed = path; return nil }
+func (f *raceEngine) PreloadYTDL(path string, _ time.Duration) error { f.armed = path; return nil }
+func (f *raceEngine) ClearPreload()                                  { f.clearPreloads++; f.armed = "" }
+func (f *raceEngine) HasPreload() bool                               { return f.armed != "" }
+
+func newRaceModel(tracks []playlist.Track) (Model, *raceEngine) {
+	m, _ := newGUITestModel()
+	eng := &raceEngine{}
+	m.player = eng
+	m.playlist.Replace(tracks)
+	return m, eng
+}
+
+// runCmd は cmd を走らせ (tea.Batch はほどく)、出たメッセージを返す。
+func runCmd(cmd tea.Cmd) []tea.Msg {
+	if cmd == nil {
+		return nil
+	}
+	msg := cmd()
+	if b, ok := msg.(tea.BatchMsg); ok {
+		var out []tea.Msg
+		for _, c := range b {
+			out = append(out, runCmd(c)...)
+		}
+		return out
+	}
+	if msg == nil {
+		return nil
+	}
+	return []tea.Msg{msg}
+}
+
+// settle は cmd を走らせ、出たメッセージを Update に通し、返った Cmd も
+// 尽きるまで同じく走らせる (bubbletea がするのと同じ)。
+func settle(t *testing.T, m Model, cmd tea.Cmd) Model {
+	t.Helper()
+	queue := []tea.Cmd{cmd}
+	for n := 0; len(queue) > 0; n++ {
+		if n > 50 {
+			t.Fatal("commands did not settle")
+		}
+		c := queue[0]
+		queue = queue[1:]
+		for _, msg := range runCmd(c) {
+			next, more := m.Update(msg)
+			m = next.(Model)
+			queue = append(queue, more)
+		}
+	}
+	return m
+}
+
+func update(m Model, msg tea.Msg) (Model, tea.Cmd) {
+	next, cmd := m.Update(msg)
+	return next.(Model), cmd
+}
+
+func titlesUntilEnd(pl *playlist.Playlist) []string {
+	var out []string
+	for range 100 {
+		t, ok := pl.Next()
+		if !ok {
+			break
+		}
+		out = append(out, t.Title)
+	}
+	return out
+}
+
+func assertArmedIsNext(t *testing.T, m Model, eng *raceEngine) {
+	t.Helper()
+	want, _ := m.playlist.PeekNext()
+	if eng.armed != want.Path {
+		t.Fatalf("gapless will play %q but playlist.Next() reports %q (preloading=%v)", eng.armed, want.Path, m.preloading)
+	}
+}
+
+// 次の曲の先読み (yt-dlp なら数秒) が走っている間に queue_edit で次の曲が
+// 変わっても、どちらの先読みが先に終わっても据わるのは新しい次の曲。
+func TestInFlightPreloadAfterQueueEdit(t *testing.T) {
+	for _, oldLast := range []bool{true, false} {
+		m, eng := newRaceModel(newGUITestTracks("a", "b", "c"))
+		m.playlist.SetIndex(0)
+		oldPreload := m.playCurrentTrack() // a を鳴らし、b の先読みが走る
+		if !m.preloading {
+			t.Fatal("expected a preload in flight")
+		}
+		m, newPreload := update(m, ipc.QueueEditMsg{Mode: "add", Index: 2, Reply: make(chan ipc.Response, 1)})
+		if oldLast {
+			m = settle(t, m, newPreload)
+			m = settle(t, m, oldPreload)
+		} else {
+			m = settle(t, m, oldPreload)
+			m = settle(t, m, newPreload)
+		}
+		assertArmedIsNext(t, m, eng)
+		if m.preloading {
+			t.Fatalf("oldLast=%v: preloading left set", oldLast)
+		}
+	}
+}
+
+// replace の前の先読みが replace の後に据わっても、新しいリストの次の曲に直す。
+func TestInFlightPreloadAfterReplace(t *testing.T) {
+	for _, oldLast := range []bool{true, false} {
+		m, eng := newRaceModel(newGUITestTracks("old1", "old2"))
+		m.playlist.SetIndex(0)
+		oldPreload := m.playCurrentTrack()
+		m, newCmds := update(m, ipc.ReplaceMsg{Tracks: newGUITestTracks("new1", "new2"), Index: 0, Reply: make(chan ipc.Response, 1)})
+		if oldLast {
+			m = settle(t, m, newCmds)
+			m = settle(t, m, oldPreload)
+		} else {
+			m = settle(t, m, oldPreload)
+			m = settle(t, m, newCmds)
+		}
+		if eng.armed != "new2.flac" {
+			t.Fatalf("oldLast=%v: gapless next = %q, want new2.flac", oldLast, eng.armed)
+		}
+	}
+}
+
+// 読み込みに時間のかかる曲 (yt-dlp) へ replace した直後に、前のリストの
+// 先読みが据わった: 新しい先読みは始まっていないので、番号ではなく曲で見分けて捨てる。
+func TestInFlightPreloadAfterReplaceWithBufferingTrack(t *testing.T) {
+	m, eng := newRaceModel(newGUITestTracks("old1", "old2"))
+	m.playlist.SetIndex(0)
+	oldPreload := m.playCurrentTrack()
+	yt := playlist.Track{Path: "https://www.youtube.com/watch?v=AAAAAAAAAAA", Title: "yt"}
+	m, start := update(m, ipc.ReplaceMsg{Tracks: []playlist.Track{yt, {Path: "new2.flac", Title: "new2"}}, Reply: make(chan ipc.Response, 1)})
+	if !m.buffering {
+		t.Fatal("expected buffering")
+	}
+	m = settle(t, m, oldPreload) // old2 が据わる
+	if eng.armed != "" {
+		t.Fatalf("stale preload of %q left armed while the new list plays", eng.armed)
+	}
+	m = settle(t, m, start) // yt が鳴り出し、new2 を先読みする
+	if eng.armed != "new2.flac" {
+		t.Fatalf("gapless next = %q, want new2.flac", eng.armed)
+	}
+}
+
+// yt-dlp の曲の読み込み中に手元の曲へ replace した: 手元の曲は同期で鳴るので
+// その時点で読み込み待ちは終わり、遅れて届く古い開始の知らせは何も変えない。
+func TestReplaceWhileBufferingIgnoresStaleStart(t *testing.T) {
+	yt := playlist.Track{Path: "https://www.youtube.com/watch?v=AAAAAAAAAAA", Title: "A"}
+	for _, stale := range []error{nil, player.ErrSuperseded} {
+		m, eng := newRaceModel([]playlist.Track{yt})
+		m.playlist.SetIndex(0)
+		oldStart := m.playCurrentTrack()
+		if !m.buffering {
+			t.Fatal("expected buffering")
+		}
+		m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+			return ipc.ReplaceMsg{Tracks: newGUITestTracks("local"), Reply: r}
+		})
+		if m.buffering {
+			t.Fatal("still buffering after a synchronous local start")
+		}
+		eng.ytdlErr = stale
+		m = settle(t, m, oldStart)
+		cur, _ := m.playlist.Current()
+		if cur.Title != "local" || m.buffering || m.err != nil {
+			t.Fatalf("stale=%v: current=%q buffering=%v err=%v", stale, cur.Title, m.buffering, m.err)
+		}
+		if cmd := m.togglePlayPause(); m.buffering {
+			t.Fatalf("play/pause stuck (cmd=%v)", cmd != nil)
+		}
+	}
+}
+
+// 読み込み中に止めた (IPC の stop): プレイヤーは古い開始を捨てて
+// ErrSuperseded を返す。読み込み待ちを下ろし、エラーにはしない。
+func TestStopWhileBufferingClearsBuffering(t *testing.T) {
+	yt := playlist.Track{Path: "https://www.youtube.com/watch?v=AAAAAAAAAAA", Title: "A"}
+	m, eng := newRaceModel([]playlist.Track{yt})
+	m.playlist.SetIndex(0)
+	start := m.playCurrentTrack()
+	m, _ = update(m, playback.StopMsg{})
+	if m.buffering {
+		t.Fatal("still buffering right after stop")
+	}
+	eng.ytdlErr = player.ErrSuperseded
+	m = settle(t, m, start)
+	if m.buffering || m.err != nil {
+		t.Fatalf("after stop: buffering=%v err=%v", m.buffering, m.err)
+	}
+	var resp ipc.Response
+	m, resp = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.StatusRequestMsg{Reply: r} })
+	if resp.Buffering == nil || *resp.Buffering {
+		t.Fatalf("status buffering = %v, want false", resp.Buffering)
+	}
+}
+
+// 最新の開始が ErrSuperseded になったのに鳴っている: 後から始まった古い開始が
+// 勝っているので、いまの曲をもう一度始める。
+func TestSupersededLatestStartWhilePlayingRestarts(t *testing.T) {
+	yt := playlist.Track{Path: "https://www.youtube.com/watch?v=AAAAAAAAAAA", Title: "A"}
+	m, eng := newRaceModel([]playlist.Track{yt})
+	m.playlist.SetIndex(0)
+	start := m.playCurrentTrack()
+	eng.playing = true // 古い開始の曲が鳴っている
+	eng.ytdlErr = player.ErrSuperseded
+	msgs := runCmd(start)
+	eng.ytdlErr = nil
+	m, restart := update(m, msgs[0])
+	if restart == nil || !m.buffering {
+		t.Fatal("superseded latest start while playing was not restarted")
+	}
+	m = settle(t, m, restart)
+	if m.buffering || len(eng.playCalls) != 2 || eng.playCalls[1] != yt.Path {
+		t.Fatalf("buffering=%v plays=%v", m.buffering, eng.playCalls)
+	}
+}
+
+// フィードの曲の展開中に GUI がリストを差し替えたら、遅れて届いた展開は
+// 捨てる (差し替えたリストをエピソードで上書きしない)。
+func TestStaleFeedResolutionAfterGUIReplace(t *testing.T) {
+	feed := playlist.Track{Path: "https://example.com/podcast.rss", Title: "Pod", Feed: true, Stream: true}
+	m, eng := newRaceModel(nil)
+	// GUI が feed の行で replace し、続けてアルバムで replace する。
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.ReplaceMsg{Tracks: []playlist.Track{feed}, Reply: r}
+	})
+	if !m.feedLoading || !m.feedTrackPending {
+		t.Fatal("expected the feed to be loading")
+	}
+	seq, epoch := m.playSeq, m.playlist.Epoch()
+	src := ipc.SourceInfo{Provider: "local", ID: "Mine", Name: "Mine"}
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.ReplaceMsg{Tracks: newGUITestTracks("a", "b"), Source: src, Reply: r}
+	})
+	var status ipc.Response
+	m, status = sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.StatusRequestMsg{Reply: r} })
+	if *status.Buffering {
+		t.Fatal("status still reports buffering for the abandoned feed while the album plays")
+	}
+	m, _ = update(m, feedTrackResolvedMsg{tracks: newGUITestTracks("ep1", "ep2", "ep3"), seq: seq, epoch: epoch})
+	cur, _ := m.playlist.Current()
+	if cur.Title != "a" || m.playlist.Len() != 2 || eng.playCalls[len(eng.playCalls)-1] != "a.flac" {
+		t.Fatalf("stale feed result replaced the list: len=%d current=%q plays=%v", m.playlist.Len(), cur.Title, eng.playCalls)
+	}
+	if got := m.listSource(); got == nil || *got != src {
+		t.Fatalf("source = %v, want %v", got, src)
+	}
+
+	// 遅れて届いた展開の失敗も、新しい曲の読み込み待ちやエラーに触らない。
+	yt := playlist.Track{Path: "https://www.youtube.com/watch?v=AAAAAAAAAAA", Title: "yt"}
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.ReplaceMsg{Tracks: []playlist.Track{feed}, Reply: r}
+	})
+	seq, epoch = m.playSeq, m.playlist.Epoch()
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.ReplaceMsg{Tracks: []playlist.Track{yt}, Reply: r}
+	})
+	if !m.buffering {
+		t.Fatal("expected buffering for the yt-dlp track")
+	}
+	m, _ = update(m, feedTrackResolvedMsg{seq: seq, epoch: epoch, err: errors.New("feed: 404")})
+	if !m.buffering || m.err != nil {
+		t.Fatalf("stale feed error: buffering=%v err=%v", m.buffering, m.err)
+	}
+}
+
+// 最新のフィードの展開はこれまでどおりリストを置き換え、失敗はエラーに出す。
+func TestFreshFeedResolution(t *testing.T) {
+	feed := playlist.Track{Path: "https://example.com/podcast.rss", Title: "Pod", Feed: true, Stream: true}
+	m, _ := newRaceModel([]playlist.Track{feed})
+	m.loadedPlaylist = "Mine"
+	m.playlist.SetIndex(0)
+	_ = m.playCurrentTrack()
+	m, _ = update(m, feedTrackResolvedMsg{tracks: newGUITestTracks("ep1", "ep2"), seq: m.playSeq, epoch: m.playlist.Epoch()})
+	if cur, _ := m.playlist.Current(); cur.Title != "ep1" || m.feedLoading || m.feedTrackPending || m.loadedPlaylist != "" {
+		t.Fatalf("current=%q feedLoading=%v pending=%v loadedPlaylist=%q", cur.Title, m.feedLoading, m.feedTrackPending, m.loadedPlaylist)
+	}
+
+	m, _ = newRaceModel([]playlist.Track{feed})
+	m.playlist.SetIndex(0)
+	_ = m.playCurrentTrack()
+	m, _ = update(m, feedTrackResolvedMsg{seq: m.playSeq, epoch: m.playlist.Epoch(), err: errors.New("feed: 404")})
+	if m.err == nil || m.feedLoading || m.feedTrackPending {
+		t.Fatalf("err=%v feedLoading=%v pending=%v", m.err, m.feedLoading, m.feedTrackPending)
+	}
+}
