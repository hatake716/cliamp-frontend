@@ -0,0 +1,112 @@
+package main
+
+// daemon の status の playback_error の試験 (TUI 側は ui/model/ipc_gui_playerr_test.go)。
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"cliamp/internal/playback"
+	"cliamp/ipc"
+	"cliamp/player"
+)
+
+func daemonStatus(d *daemon) ipc.Response {
+	return daemonSend(d, func(r chan ipc.Response) any { return ipc.StatusRequestMsg{Reply: r} })
+}
+
+// 開始の失敗は、その曲がいまの曲の間だけ playback_error に出て、次の開始で消える。
+func TestDaemonPlaybackError(t *testing.T) {
+	ageGate := errors.New("yt-dlp: ERROR: [youtube] x8VYWazR5mE: Sign in to confirm your age.")
+	d, eng := newTestDaemon(t, -1, "a", "b")
+	eng.playErrs = []error{ageGate}
+	daemonSend(d, func(r chan ipc.Response) any { return ipc.PlayIndexMsg{Index: 0, Reply: r} })
+	status := daemonStatus(d)
+	if status.PlaybackError != ageGate.Error() || status.State != "stopped" || status.Track.Path != "a.flac" {
+		t.Fatalf("status after a failed start = %+v", status)
+	}
+
+	// 止まっている間に別の曲がいまの曲になったら出さない。戻れば出す。
+	d.mu.Lock()
+	d.playlist.SetIndex(1)
+	d.mu.Unlock()
+	if got := daemonStatus(d).PlaybackError; got != "" {
+		t.Fatalf("playback_error for another track = %q", got)
+	}
+	d.mu.Lock()
+	d.playlist.SetIndex(0)
+	d.mu.Unlock()
+	if got := daemonStatus(d).PlaybackError; got != ageGate.Error() {
+		t.Fatalf("playback_error back on the failed track = %q", got)
+	}
+
+	// やり直し (toggle) で消え、読み込み中にも出さない。
+	eng.block = make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		d.Send(playback.PlayPauseMsg{})
+		close(done)
+	}()
+	waitFor(t, func() bool { d.mu.Lock(); defer d.mu.Unlock(); return d.buffering })
+	if got := daemonStatus(d).PlaybackError; got != "" {
+		t.Fatalf("playback_error while retrying = %q", got)
+	}
+	close(eng.block)
+	<-done
+	if status := daemonStatus(d); status.PlaybackError != "" || status.State != "playing" {
+		t.Fatalf("status after a successful retry = %+v", status)
+	}
+}
+
+// 追い越された開始 (ErrSuperseded) は失敗ではない。
+func TestDaemonPlaybackErrorIgnoresSuperseded(t *testing.T) {
+	d, eng := newTestDaemon(t, -1, "a")
+	eng.playErrs = []error{player.ErrSuperseded}
+	daemonSend(d, func(r chan ipc.Response) any { return ipc.PlayIndexMsg{Index: 0, Reply: r} })
+	if got := daemonStatus(d).PlaybackError; got != "" {
+		t.Fatalf("playback_error for ErrSuperseded = %q", got)
+	}
+}
+
+// yt-dlp の曲のシークの失敗 (音が止まったまま) も出す。
+func TestDaemonPlaybackErrorFromSeek(t *testing.T) {
+	d, eng := newTestDaemon(t, 0, "a")
+	seekErr := errors.New("yt-dlp seek: yt-dlp: ERROR: [youtube] a: HTTP Error 403: Forbidden")
+	eng.mu.Lock()
+	eng.seekErr = seekErr
+	eng.mu.Unlock()
+	d.Send(playback.SetPositionMsg{Position: 30 * time.Second})
+	waitFor(t, func() bool { d.mu.Lock(); defer d.mu.Unlock(); return !d.seeking })
+	d.seekMu.Lock() // 走っているシークが終わるまで待つ
+	d.seekMu.Unlock()
+	if got := daemonStatus(d).PlaybackError; got != seekErr.Error() {
+		t.Fatalf("playback_error after a failed yt-dlp seek = %q", got)
+	}
+	// 次のシークが成功すれば消える。
+	eng.mu.Lock()
+	eng.seekErr = nil
+	eng.mu.Unlock()
+	d.Send(playback.SetPositionMsg{Position: 40 * time.Second})
+	waitFor(t, func() bool { d.mu.Lock(); defer d.mu.Unlock(); return !d.seeking })
+	d.seekMu.Lock()
+	d.seekMu.Unlock()
+	if got := daemonStatus(d).PlaybackError; got != "" {
+		t.Fatalf("playback_error after a successful seek = %q", got)
+	}
+	eng.mu.Lock()
+	eng.seekErr = seekErr
+	eng.mu.Unlock()
+	d.Send(playback.SetPositionMsg{Position: 50 * time.Second})
+	waitFor(t, func() bool { d.mu.Lock(); defer d.mu.Unlock(); return !d.seeking })
+	d.seekMu.Lock()
+	d.seekMu.Unlock()
+	if got := daemonStatus(d).PlaybackError; got != seekErr.Error() {
+		t.Fatalf("playback_error after the second failed seek = %q", got)
+	}
+	// 曲を始め直せば (同じ曲でも) 消える。
+	daemonSend(d, func(r chan ipc.Response) any { return ipc.PlayIndexMsg{Index: 0, Reply: r} })
+	if got := daemonStatus(d).PlaybackError; got != "" {
+		t.Fatalf("playback_error after restarting = %q", got)
+	}
+}
