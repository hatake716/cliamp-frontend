+package cmd
+
+import (
+	"strings"
+	"testing"
+)
+
+// The Spotify intro follows Spotify's February 2026 rules: an app of your
+// own can search (external/spotify/devmode.go), so neither choice is
+// described as lacking or bypassing a search restriction.
+func TestSpotifySetupIntroNoSearchRestriction(t *testing.T) {
+	var intro string
+	for _, p := range providers() {
+		if p.section == "spotify" {
+			intro = strings.Join(p.intro, " ")
+			break
+		}
+	}
+	if intro == "" {
+		t.Fatal("spotify spec missing")
+	}
+	if !strings.Contains(intro, "playlists, and search") {
+		t.Errorf("intro does not say your own client_id can search: %q", intro)
+	}
+	for _, stale := range []string{"search restriction", "can't use", "Nov 27", "bypass"} {
+		if strings.Contains(intro, stale) {
+			t.Errorf("intro still mentions %q: %q", stale, intro)
+		}
+	}
+}
