diff --git a/external/spotify/ratelimit.go b/external/spotify/ratelimit.go
new file mode 100644
index 0000000..7d1cba5
--- /dev/null
+++ b/external/spotify/ratelimit.go
@@ -0,0 +1,151 @@
+//go:build !windows
+
+package spotify
+
+// ratelimit.go — waiting on the Web API's 429 without parking for hours.
+//
+// Spotify answers 429 with Retry-After. For the shared client ID it has asked
+// for 86400 s; honouring that parked the caller (and the GUI's IPC request)
+// for a day. Short waits are still retried; anything longer than
+// maxRateLimitWait fails at once with a RateLimitError.
+//
+// Since July 2026 a 429 whose JSON body carries "reason": "QUOTA_EXCEEDED"
+// means the developer account's quota is used up (every Development Mode
+// client ID of one developer shares it). Retrying cannot help, so it fails at
+// once with a QuotaExceededError, whatever Retry-After says.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// maxRateLimitWait caps one wait between retries of a rate-limited call.
+const maxRateLimitWait = 30 * time.Second
+
+// RateLimitError is returned when Spotify asks to wait longer than
+// maxRateLimitWait before retrying.
+type RateLimitError struct {
+	RetryAfter time.Duration
+}
+
+func (e *RateLimitError) Error() string {
+	return fmt.Sprintf("spotify: rate limited by Spotify; retry after %v", e.RetryAfter)
+}
+
+// QuotaExceededError is returned when Spotify answers 429 with the reason
+// QUOTA_EXCEEDED. RetryAfter is zero when Spotify did not say how long.
+type QuotaExceededError struct {
+	RetryAfter time.Duration
+}
+
+func (e *QuotaExceededError) Error() string {
+	const msg = "spotify: Spotify quota exceeded for this developer account"
+	if e.RetryAfter > 0 {
+		return fmt.Sprintf("%s; retry after %v", msg, e.RetryAfter)
+	}
+	return msg
+}
+
+// quotaExceededReason is the "reason" of a 429 that no retry will fix.
+const quotaExceededReason = "QUOTA_EXCEEDED"
+
+// maxRateLimitBody caps how much of a 429 body is read for its reason.
+const maxRateLimitBody = 64 << 10
+
+// rateLimitReason returns the "reason" of a Web API error body
+// ({"error": {"status": 429, "message": …, "reason": …}}), or "" when the body
+// is empty, not JSON or of another shape (an ordinary rate limit).
+func rateLimitReason(body io.Reader) string {
+	data, err := io.ReadAll(io.LimitReader(body, maxRateLimitBody))
+	if err != nil && len(data) == 0 {
+		return ""
+	}
+	var v struct {
+		Error struct {
+			Reason string `json:"reason"`
+		} `json:"error"`
+	}
+	if json.Unmarshal(data, &v) != nil {
+		return ""
+	}
+	return strings.TrimSpace(v.Error.Reason)
+}
+
+// quotaExceeded returns the error to fail a 429 with at once, or nil when it
+// is an ordinary rate limit to wait out (rateLimitWait). reason is
+// rateLimitReason of its body.
+func quotaExceeded(reason string, h http.Header, now time.Time) error {
+	if !strings.EqualFold(reason, quotaExceededReason) {
+		return nil
+	}
+	asked, _ := retryAfter(h, now)
+	return &QuotaExceededError{RetryAfter: asked}
+}
+
+// retryAfter parses the Retry-After header (seconds or an HTTP date). ok is
+// false when it is missing, unparsable or not in the future.
+func retryAfter(h http.Header, now time.Time) (d time.Duration, ok bool) {
+	ra := h.Get("Retry-After")
+	if ra == "" {
+		return 0, false
+	}
+	// A number too large for an int is still a request to wait (Atoi then
+	// returns the clamped value with ErrRange).
+	if secs, err := strconv.Atoi(ra); err == nil || errors.Is(err, strconv.ErrRange) {
+		if secs <= 0 {
+			return 0, false
+		}
+		return secondsDuration(secs), true
+	}
+	if at, err := http.ParseTime(ra); err == nil {
+		d = at.Sub(now).Round(time.Second)
+		return d, d > 0
+	}
+	return 0, false
+}
+
+// rateLimitWait returns how long to wait before retrying after the attempt-th
+// (0-based) 429 with header h: Retry-After when given (seconds or an HTTP
+// date), else exponential backoff capped at maxRateLimitWait. It returns a
+// *RateLimitError instead when Retry-After exceeds maxRateLimitWait.
+func rateLimitWait(h http.Header, attempt int, now time.Time) (time.Duration, error) {
+	wait := min(time.Duration(1)<<min(attempt, 30)*time.Second, maxRateLimitWait)
+	asked, ok := retryAfter(h, now)
+	if !ok {
+		return wait, nil
+	}
+	if asked > maxRateLimitWait {
+		return 0, &RateLimitError{RetryAfter: asked}
+	}
+	return asked, nil
+}
+
+// secondsDuration converts secs to a Duration, saturating at the largest
+// Duration instead of overflowing (Retry-After: 9223372037 would otherwise
+// turn negative and be retried at once).
+func secondsDuration(secs int) time.Duration {
+	if int64(secs) > math.MaxInt64/int64(time.Second) {
+		return time.Duration(math.MaxInt64)
+	}
+	return time.Duration(secs) * time.Second
+}
+
+// rateLimitSleep waits d or until ctx ends.
+func rateLimitSleep(ctx context.Context, d time.Duration) error {
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
diff --git a/external/spotify/ratelimit_test.go b/external/spotify/ratelimit_test.go
new file mode 100644
index 0000000..0b1504c
--- /dev/null
+++ b/external/spotify/ratelimit_test.go
@@ -0,0 +1,152 @@
+//go:build !windows
+
+package spotify
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestRateLimitWait(t *testing.T) {
+	now := time.Date(2026, 9, 26, 12, 0, 0, 0, time.UTC)
+	tests := []struct {
+		name       string
+		retryAfter string
+		attempt    int
+		want       time.Duration
+		wantErr    string
+	}{
+		{"no header: backoff 1s", "", 0, time.Second, ""},
+		{"no header: backoff 16s", "", 4, 16 * time.Second, ""},
+		{"no header: backoff capped", "", 7, 30 * time.Second, ""},
+		{"no header: huge attempt capped", "", 62, 30 * time.Second, ""},
+		{"short Retry-After is honoured", "2", 0, 2 * time.Second, ""},
+		{"Retry-After at the cap", "30", 5, 30 * time.Second, ""},
+		{"Retry-After over the cap fails", "31", 0, 0, "spotify: rate limited by Spotify; retry after 31s"},
+		{"a day fails", "86400", 0, 0, "spotify: rate limited by Spotify; retry after 24h0m0s"},
+		{"HTTP date within the cap", now.Add(10 * time.Second).Format(http.TimeFormat), 0, 10 * time.Second, ""},
+		{"HTTP date an hour away fails", now.Add(time.Hour).Format(http.TimeFormat), 0, 0, "retry after 1h0m0s"},
+		{"zero falls back to backoff", "0", 1, 2 * time.Second, ""},
+		{"garbage falls back to backoff", "soon", 2, 4 * time.Second, ""},
+		// Seconds whose Duration would overflow int64 still fail at once
+		// (they used to wrap to a negative or tiny wait and be retried).
+		{"overflowing to negative fails", "9223372037", 0, 0, "retry after 2562047h47m16.854775807s"},
+		{"overflowing to a small wait fails", "18446744074", 0, 0, "retry after 2562047h47m16.854775807s"},
+		{"MaxInt64 seconds fails", "9223372036854775807", 0, 0, "retry after 2562047h47m16.854775807s"},
+		{"beyond int fails", "99999999999999999999", 0, 0, "retry after 2562047h47m16.854775807s"},
+		{"largest exact Duration", "9223372036", 0, 0, "retry after 2562047h47m16s"},
+		{"negative beyond int falls back to backoff", "-99999999999999999999", 3, 8 * time.Second, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.Header{}
+			if tt.retryAfter != "" {
+				h.Set("Retry-After", tt.retryAfter)
+			}
+			got, err := rateLimitWait(h, tt.attempt, now)
+			if tt.wantErr != "" {
+				var rl *RateLimitError
+				if !errors.As(err, &rl) || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("err = %v, want RateLimitError %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil || got != tt.want {
+				t.Fatalf("rateLimitWait = %v, %v; want %v", got, err, tt.want)
+			}
+		})
+	}
+}
+
+// End to end through the provider, with real waits: a day-long Retry-After
+// fails at once; a 2-second one is waited out and retried.
+func TestWebAPIRateLimit(t *testing.T) {
+	tests := []struct {
+		name       string
+		retryAfter string
+		wantErr    string
+		wantCalls  int
+		maxElapsed time.Duration
+		minElapsed time.Duration
+	}{
+		{"Retry-After 86400 fails fast", "86400", "spotify: rate limited by Spotify; retry after 24h0m0s", 1, 2 * time.Second, 0},
+		{"Retry-After 2 is retried", "2", "", 2, 10 * time.Second, 2 * time.Second},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			var calls atomic.Int32
+			f.handle("GET /v1/me/playlists", func(w http.ResponseWriter, _ *http.Request) {
+				if calls.Add(1) == 1 {
+					w.Header().Set("Retry-After", tt.retryAfter)
+					w.WriteHeader(http.StatusTooManyRequests)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"items":[],"total":0}`))
+			})
+			p := New(webOnlyTestSession(t, ""), "cid", 320)
+			defer p.Close()
+
+			// A broken cap would park here; the deadline turns that into a failure.
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			start := time.Now()
+			resp, err := p.webAPI(ctx, "GET", "/v1/me/playlists", nil)
+			elapsed := time.Since(start)
+			if resp != nil {
+				resp.Body.Close()
+			}
+			if tt.wantErr != "" {
+				var rl *RateLimitError
+				if !errors.As(err, &rl) || err.Error() != tt.wantErr {
+					t.Fatalf("err = %v, want %q", err, tt.wantErr)
+				}
+				if rl.RetryAfter != 24*time.Hour {
+					t.Fatalf("RetryAfter = %v", rl.RetryAfter)
+				}
+			} else if err != nil {
+				t.Fatalf("webAPI: %v", err)
+			}
+			if n := int(calls.Load()); n != tt.wantCalls {
+				t.Fatalf("requests = %d, want %d", n, tt.wantCalls)
+			}
+			if elapsed > tt.maxElapsed || elapsed < tt.minElapsed {
+				t.Fatalf("took %v, want between %v and %v", elapsed, tt.minElapsed, tt.maxElapsed)
+			}
+		})
+	}
+}
+
+// The rate-limit error reaches the catalog's callers (Playlists) intact.
+func TestPlaylistsRateLimited(t *testing.T) {
+	f := isolate(t)
+	f.handle("GET /v1/me", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Retry-After", "86400")
+		w.WriteHeader(http.StatusTooManyRequests)
+	})
+	f.handle("GET /v1/me/tracks", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Retry-After", "86400")
+		w.WriteHeader(http.StatusTooManyRequests)
+	})
+	p := New(webOnlyTestSession(t, ""), "cid", 320)
+	defer p.Close()
+	done := make(chan error, 1)
+	go func() {
+		_, err := p.Playlists()
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err == nil || !strings.Contains(err.Error(), "rate limited by Spotify; retry after 24h0m0s") {
+			t.Fatalf("Playlists err = %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Playlists is still waiting on Retry-After: 86400")
+	}
+}
diff --git a/external/spotify/restore_test.go b/external/spotify/restore_test.go
new file mode 100644
index 0000000..93ff178
--- /dev/null
+++ b/external/spotify/restore_test.go
@@ -0,0 +1,360 @@
+//go:build !windows
+
+package spotify
+
+// restore_test.go — restoring a stored session when several callers arrive at
+// once, and refresh tokens that Spotify refuses for good.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	login5pb "github.com/devgianlu/go-librespot/proto/spotify/login5/v3"
+	"golang.org/x/oauth2"
+
+	"cliamp/playlist"
+)
+
+// rotation is a fake accounts service whose refresh tokens are single use,
+// the premise savingTokenSource is built on: the current rt-N answers
+// at-(N+1) / rt-(N+1) once; a used or unknown token gets invalid_grant.
+//
+// The first refresh is held until a second one arrives (or hold passes), so a
+// duplicate refresh of the same stored token reliably overlaps with it.
+type rotation struct {
+	mu       sync.Mutex
+	current  string
+	n        int
+	requests int
+	second   chan struct{}
+}
+
+func (f *fakeSpotify) rotatingRefreshes(first string, hold time.Duration) *rotation {
+	r := &rotation{current: first, second: make(chan struct{})}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.token = func(w http.ResponseWriter, req *http.Request) {
+		_ = req.ParseForm()
+		r.mu.Lock()
+		r.requests++
+		nth := r.requests
+		if nth == 2 {
+			close(r.second)
+		}
+		r.mu.Unlock()
+		if nth == 1 {
+			select {
+			case <-r.second:
+			case <-time.After(hold):
+			}
+		}
+		r.mu.Lock()
+		defer r.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		if req.PostForm.Get("grant_type") != "refresh_token" || req.PostForm.Get("refresh_token") != r.current {
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = io.WriteString(w, `{"error":"invalid_grant","error_description":"Refresh token revoked"}`)
+			return
+		}
+		r.n++
+		r.current = fmt.Sprintf("rt-%d", r.n)
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": fmt.Sprintf("at-%d", r.n), "token_type": "Bearer", "expires_in": 3600, "refresh_token": r.current,
+		})
+	}
+	return r
+}
+
+func (r *rotation) state() (current string, requests int) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.current, r.requests
+}
+
+// firstUseConcurrently runs the GUI's catalog calls on a fresh provider at
+// once (the GUI has up to four workers) and returns their errors.
+func firstUseConcurrently(p *SpotifyProvider) []error {
+	calls := []func() error{
+		func() error { _, err := p.Playlists(); return err },
+		func() error { _, err := p.Tracks("YOUR MUSIC"); return err },
+		func() error { _, err := p.Tracks("pl1"); return err },
+		func() error { _, err := p.SearchTracks(context.Background(), "q", 5); return err },
+	}
+	errs := make([]error, len(calls))
+	var wg sync.WaitGroup
+	for i, call := range calls {
+		wg.Go(func() { errs[i] = call() })
+	}
+	wg.Wait()
+	return errs
+}
+
+// Concurrent first calls restore the stored session once: one refresh of the
+// stored token, nobody is asked to sign in, and the rotated token stays on
+// disk for the next launch.
+func TestConcurrentFirstUseRestoresOnce(t *testing.T) {
+	t.Run("web-only", func(t *testing.T) {
+		f := isolate(t)
+		fakeLibrary(f)
+		rot := f.rotatingRefreshes("rt-0", 300*time.Millisecond)
+		writeCredsFile(t, `{"refresh_token":"rt-0","web_only":true}`)
+
+		p := New(nil, "cid", 320)
+		defer p.Close()
+		for i, err := range firstUseConcurrently(p) {
+			if err != nil {
+				t.Errorf("call %d: %v", i, err)
+			}
+		}
+		current, requests := rot.state()
+		if requests != 1 {
+			t.Errorf("refreshes of the stored token = %d, want 1", requests)
+		}
+		if got := readCredsFile(t); got["refresh_token"] != current || got["web_only"] != true {
+			t.Fatalf("stored credentials = %v, want refresh_token %s", got, current)
+		}
+		if p.PlaybackVia() != PlaybackYouTube {
+			t.Fatal("provider is not web-only")
+		}
+	})
+	t.Run("premium", func(t *testing.T) {
+		f := isolate(t)
+		fakeLibrary(f)
+		rot := f.rotatingRefreshes("rt-0", 300*time.Millisecond)
+		backend := &fakeBackend{username: "u", data: []byte("blob")}
+		calls := setBackend(t, func(any) (streamBackend, error) { return backend, nil })
+		writeCredsFile(t, `{"username":"u","data":"YmxvYg==","device_id":"00112233445566778899aabbccddeeff00112233","refresh_token":"rt-0"}`)
+
+		p := New(nil, "cid", 320)
+		defer p.Close()
+		for i, err := range firstUseConcurrently(p) {
+			if err != nil {
+				t.Errorf("call %d: %v", i, err)
+			}
+		}
+		current, requests := rot.state()
+		if requests != 1 || len(*calls) != 1 {
+			t.Errorf("refreshes = %d, librespot sessions = %d, want 1 and 1", requests, len(*calls))
+		}
+		if got := readCredsFile(t); got["refresh_token"] != current || got["username"] != "u" {
+			t.Fatalf("stored credentials = %v, want refresh_token %s", got, current)
+		}
+	})
+}
+
+// Two restores that bypass the provider (a sign-in racing a silent restore)
+// take turns on the file: the second refreshes the token the first stored
+// instead of the one it read before, and nothing is deleted.
+func TestWebOnlyRestoresTakeTurns(t *testing.T) {
+	f := isolate(t)
+	rot := f.rotatingRefreshes("rt-0", 300*time.Millisecond)
+	writeCredsFile(t, `{"refresh_token":"rt-0","web_only":true,"user_id":"u1"}`)
+
+	sessions := make([]*Session, 2)
+	errs := make([]error, 2)
+	var wg sync.WaitGroup
+	for i := range 2 {
+		wg.Go(func() { sessions[i], errs[i] = NewSessionSilent(context.Background(), "cid") })
+	}
+	wg.Wait()
+	for i, err := range errs {
+		if err != nil {
+			t.Fatalf("restore %d: %v", i, err)
+		}
+		if !sessions[i].WebOnly() || sessions[i].UserID() != "u1" {
+			t.Fatalf("restore %d: webOnly=%v userID=%q", i, sessions[i].WebOnly(), sessions[i].UserID())
+		}
+	}
+	current, requests := rot.state()
+	if requests != 2 || current != "rt-2" {
+		t.Fatalf("refreshes = %d, current token %s; want 2 and rt-2", requests, current)
+	}
+	if got := readCredsFile(t); got["refresh_token"] != "rt-2" || got["user_id"] != "u1" {
+		t.Fatalf("stored credentials = %v", got)
+	}
+}
+
+// A restore handed credentials that another restore has since rotated uses
+// the file's newer token, and a refusal of an outdated token never deletes
+// the newer one.
+func TestWebOnlyRestoreUsesStoredToken(t *testing.T) {
+	f := isolate(t)
+	f.refreshes(map[string][2]string{"rt-new": {"at-1", "rt-newer"}}) // rt-old: invalid_grant
+	writeCredsFile(t, `{"refresh_token":"rt-new","web_only":true}`)
+
+	s, err := newWebOnlyFromStored("cid", &storedCreds{RefreshToken: "rt-old", WebOnly: true})
+	if err != nil {
+		t.Fatalf("newWebOnlyFromStored: %v", err)
+	}
+	if tok, err := s.tokenSource.Token(); err != nil || tok.AccessToken != "at-1" {
+		t.Fatalf("token = %v, %v", tok, err)
+	}
+	if got := readCredsFile(t)["refresh_token"]; got != "rt-newer" {
+		t.Fatalf("stored refresh token = %v, want rt-newer", got)
+	}
+}
+
+// refreshFailure answers every refresh with status and body.
+func refreshFailure(f *fakeSpotify, status int, body string, header map[string]string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.token = func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		for k, v := range header {
+			w.Header().Set(k, v)
+		}
+		w.WriteHeader(status)
+		_, _ = io.WriteString(w, body)
+	}
+}
+
+// Refresh failures at restore: Spotify refusing the token or the client for
+// good clears the web-only credentials and asks for sign-in; outages and rate
+// limits keep them and retry on the next Web API call.
+func TestWebOnlyRestoreRefreshFailures(t *testing.T) {
+	tests := []struct {
+		name      string
+		status    int
+		body      string
+		header    map[string]string
+		permanent bool
+	}{
+		{"invalid_grant", 400, `{"error":"invalid_grant","error_description":"Refresh token revoked"}`, nil, true},
+		{"invalid_client (app deleted or client_id changed)", 400, `{"error":"invalid_client","error_description":"Invalid client"}`, nil, true},
+		{"invalid_client as 401", 401, `{"error":"invalid_client","error_description":"Invalid client secret"}`, nil, true},
+		{"unauthorized_client", 400, `{"error":"unauthorized_client"}`, nil, true},
+		{"invalid_request", 400, `{"error":"invalid_request","error_description":"code_verifier required"}`, nil, true},
+		{"403 without a JSON error", 403, `forbidden`, nil, true},
+		{"server error", 500, `{"error":"server_error"}`, nil, false},
+		{"service unavailable", 503, `<html>down</html>`, nil, false},
+		{"rate limited", 429, `{"error":"rate_limited"}`, map[string]string{"Retry-After": "30"}, false},
+		{"request timeout", 408, ``, nil, false},
+		{"temporarily_unavailable as 400", 400, `{"error":"temporarily_unavailable"}`, nil, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			refreshFailure(f, tt.status, tt.body, tt.header)
+			writeCredsFile(t, `{"refresh_token":"rt-1","web_only":true,"user_id":"u1"}`)
+
+			s, err := NewSessionSilent(context.Background(), "cid")
+			if tt.permanent {
+				if !errors.Is(err, playlist.ErrNeedsAuth) {
+					t.Fatalf("err = %v, want ErrNeedsAuth", err)
+				}
+				if got := readCredsFile(t); got != nil {
+					t.Fatalf("credentials not cleared: %v", got)
+				}
+				// The provider asks for sign-in and is not web-only.
+				writeCredsFile(t, `{"refresh_token":"rt-1","web_only":true,"user_id":"u1"}`)
+				p := New(nil, "cid", 320)
+				if _, err := p.Playlists(); !errors.Is(err, playlist.ErrNeedsAuth) {
+					t.Fatalf("Playlists err = %v, want ErrNeedsAuth", err)
+				}
+				if p.PlaybackVia() != "" {
+					t.Fatal("PlaybackVia reports youtube without a session")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("NewSessionSilent: %v", err)
+			}
+			defer s.Close()
+			if !s.WebOnly() {
+				t.Fatal("not web-only")
+			}
+			if got := readCredsFile(t); got["refresh_token"] != "rt-1" || got["web_only"] != true {
+				t.Fatalf("stored credentials = %v", got)
+			}
+		})
+	}
+	t.Run("network error", func(t *testing.T) {
+		isolate(t)
+		oldEndpoint := oauthEndpoint
+		oauthEndpoint.TokenURL = "http://127.0.0.1:1/api/token" // refused at once
+		t.Cleanup(func() { oauthEndpoint = oldEndpoint })
+		writeCredsFile(t, `{"refresh_token":"rt-1","web_only":true}`)
+		s, err := NewSessionSilent(context.Background(), "cid")
+		if err != nil {
+			t.Fatalf("NewSessionSilent: %v", err)
+		}
+		defer s.Close()
+		if got := readCredsFile(t); got["refresh_token"] != "rt-1" {
+			t.Fatalf("stored credentials = %v", got)
+		}
+	})
+}
+
+// A web-only session whose refresh Spotify refuses for good later in the run
+// (e.g. it was restored during an outage, then the app turned out deleted)
+// asks for sign-in, and signing in replaces it. Premium sessions keep
+// returning the refresh error as before.
+func TestWebOnlyRefreshRefusedMidSession(t *testing.T) {
+	expired := &oauth2.Token{AccessToken: "at-old", TokenType: "Bearer", RefreshToken: "rt-1", Expiry: time.Now().Add(-time.Hour)}
+
+	t.Run("web-only", func(t *testing.T) {
+		f := isolate(t)
+		fakeLibrary(f)
+		refreshFailure(f, 400, `{"error":"invalid_client","error_description":"Invalid client"}`, nil)
+		p := New(newWebOnlySession("cid", generateDeviceID(), expired, "u1", "test"), "cid", 320)
+		defer p.Close()
+
+		_, err := p.Playlists()
+		if !errors.Is(err, playlist.ErrNeedsAuth) || !strings.Contains(err.Error(), "invalid_client") {
+			t.Fatalf("Playlists err = %v, want ErrNeedsAuth mentioning invalid_client", err)
+		}
+
+		// Signing in (the TUI's overlay) now runs instead of returning at once.
+		signIns := setAuthorize(t, signInToken())
+		setBackend(t, func(any) (streamBackend, error) { return nil, login5Err(login5pb.LoginError_INVALID_CREDENTIALS) })
+		if err := p.Authenticate(); err != nil {
+			t.Fatalf("Authenticate: %v", err)
+		}
+		if *signIns != 1 {
+			t.Fatalf("sign-ins = %d, want 1", *signIns)
+		}
+		if lists, err := p.Playlists(); err != nil || len(lists) != 2 {
+			t.Fatalf("Playlists after sign-in = %v, %v", lists, err)
+		}
+		if got := readCredsFile(t); got["refresh_token"] != "rt-signin" || got["web_only"] != true {
+			t.Fatalf("stored credentials = %v", got)
+		}
+		// A healthy session is not replaced by another sign-in.
+		if err := p.Authenticate(); err != nil || *signIns != 1 {
+			t.Fatalf("second Authenticate: %v, sign-ins = %d", err, *signIns)
+		}
+	})
+	t.Run("transient failure is not a sign-in prompt", func(t *testing.T) {
+		f := isolate(t)
+		refreshFailure(f, 503, `down`, nil)
+		s := newWebOnlySession("cid", generateDeviceID(), expired, "u1", "test")
+		_, err := s.webApiWithBody(context.Background(), "GET", "/v1/me", nil, nil, "")
+		if err == nil || errors.Is(err, playlist.ErrNeedsAuth) {
+			t.Fatalf("err = %v", err)
+		}
+		if s.signInRequired() {
+			t.Fatal("a 503 marked the session as needing sign-in")
+		}
+	})
+	t.Run("premium unchanged", func(t *testing.T) {
+		f := isolate(t)
+		refreshFailure(f, 400, `{"error":"invalid_client"}`, nil)
+		s := &Session{stream: &fakeBackend{}, devID: generateDeviceID(), clientID: "cid",
+			tokenSource: spotifyOAuthConfig("cid").TokenSource(context.Background(), expired)}
+		_, err := s.webApiWithBody(context.Background(), "GET", "/v1/me", nil, nil, "")
+		if err == nil || errors.Is(err, playlist.ErrNeedsAuth) || !strings.HasPrefix(err.Error(), "refresh access token: ") {
+			t.Fatalf("err = %v", err)
+		}
+		if s.signInRequired() {
+			t.Fatal("premium session marked as needing sign-in")
+		}
+	})
+}
