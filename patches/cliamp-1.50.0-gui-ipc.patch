+// Which failures of a later page end the search instead of returning the
+// pages so far.
+func TestRefusesEveryCall(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"quota", fmt.Errorf("spotify: search: %w", &QuotaExceededError{RetryAfter: time.Hour}), true},
+		{"quota without a wait", &QuotaExceededError{}, true},
+		{"long rate limit", fmt.Errorf("spotify: search: %w", &RateLimitError{RetryAfter: 24 * time.Hour}), true},
+		{"sign-in required", fmt.Errorf("spotify: search: refresh access token: %w", playlist.ErrNeedsAuth), true},
+		{"owner without Premium", errors.New(`spotify: search: http status 403 Forbidden: {"error":{"status":403,"message":"Active premium subscription required for the owner of the app"}}`), true},
+		{"server error", errors.New(`spotify: search: http status 500 Internal Server Error: {}`), false},
+		{"timeout", fmt.Errorf("spotify: search: %w", context.DeadlineExceeded), false},
+		{"retries used up", errors.New("spotify: web api rate-limited on /v1/search after 8 retries (try re-authenticating)"), false},
+		{"other 403", errors.New(`spotify: search: http status 403 Forbidden: {"error":{"status":403,"message":"Forbidden"}}`), false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := refusesEveryCall(tt.err); got != tt.want {
+				t.Fatalf("refusesEveryCall(%v) = %v, want %v", tt.err, got, tt.want)
+			}
+		})
+	}
