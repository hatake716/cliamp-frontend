+// シャッフル中の enqueue now は、これから鳴るはずだった曲を飛ばさない。
+func TestEnqueueNowWithShuffleKeepsUpcoming(t *testing.T) {
+	names := []string{"t00", "t01", "t02", "t03", "t04", "t05", "t06", "t07", "t08", "t09"}
+	for range 100 {
+		m, _ := newGUITestModel(names...)
+		m.playlist.ToggleShuffle()
+		startPlaying(&m, 0)
+		cur, _ := m.playlist.Current()
+		before := len(m.playlist.Upcoming(100))
+
+		m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+			return ipc.EnqueueMsg{Tracks: newGUITestTracks("X"), Mode: "now", Reply: r}
+		})
+		if now, _ := m.playlist.Current(); !resp.OK || now.Title != "X" {
+			t.Fatalf("resp=%+v current=%q", resp, now.Title)
+		}
+		if got := len(m.playlist.Upcoming(100)); got != before {
+			t.Fatalf("up next shrank from %d to %d", before, got)
+		}
+		played := titlesUntilEnd(m.playlist)
+		for _, n := range names {
+			if n != cur.Title && !slices.Contains(played, n) {
+				t.Fatalf("%s was skipped (played %v)", n, played)
+			}
+		}
+	}
+}
