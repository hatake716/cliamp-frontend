diff --git a/playlist/gui.go b/playlist/gui.go
new file mode 100644
index 0000000..3de0b2b
--- /dev/null
+++ b/playlist/gui.go
@@ -0,0 +1,86 @@
+package playlist
+
+import "slices"
+
+// gui.go — GUI 向け拡張 IPC (ipc/gui.go) が使う読み取りと操作。
+//
+// Playlist には鍵が無いので、ここの関数も TUI では Update の goroutine、
+// daemon では d.mu を持った状態でだけ呼ぶこと。
+
+// Gen はリストの世代番号を返す。曲の追加・削除・並べ替え、待ち行列、
+// シャッフル、リピートが変わるたびに増える。再生位置が進んだだけでは
+// 増えない (位置は Index で分かるため)。
+func (p *Playlist) Gen() uint64 { return p.gen }
+
+// Epoch は Replace のたびに増える番号を返す。リストが丸ごと差し替わった
+// ことを、途中の追加や待ち行列の変化と区別して知るために使う。
+func (p *Playlist) Epoch() uint64 { return p.epoch }
+
+// QueueIndices は「次に再生」の待ち行列に入っている曲の添字を順に返す (写し)。
+func (p *Playlist) QueueIndices() []int { return slices.Clone(p.queue) }
+
+// Upcoming は、再生順でいまの曲の後に来る曲の添字を最大 n 個返す。
+// 待ち行列に入っている曲と再生できない曲は除く (待ち行列は QueueIndices で
+// 別に示すため)。リピートがすべてでシャッフルでないときは先頭へ回り込み、
+// いまの曲の手前で止める。シャッフル中の回り込みは次の混ぜ方がまだ
+// 決まっていないので含めない。1 曲リピートは見ない (「次へ」で進む先の
+// 並びを示すため)。
+func (p *Playlist) Upcoming(n int) []int {
+	if n <= 0 || len(p.order) == 0 {
+		return nil
+	}
+	queued := make(map[int]bool, len(p.queue))
+	for _, idx := range p.queue {
+		queued[idx] = true
+	}
+	var out []int
+	add := func(slot int) bool {
+		idx := p.order[slot]
+		if queued[idx] || !p.isPlayable(idx) {
+			return true
+		}
+		out = append(out, idx)
+		return len(out) < n
+	}
+	for slot := p.pos + 1; slot < len(p.order); slot++ {
+		if !add(slot) {
+			return out
+		}
+	}
+	if p.repeat == RepeatAll && !p.shuffle {
+		for slot := 0; slot < p.pos && slot < len(p.order); slot++ {
+			if !add(slot) {
+				return out
+			}
+		}
+	}
+	return out
+}
+
+// StartAt は添字 i の曲を選び、シャッフル中なら i を先頭にして残りを混ぜ直す。
+// Replace の直後に呼ぶと「この曲から再生し、残りはシャッフル」になる
+// (SetIndex だけでは i より前に混ざった曲が再生済み扱いになり、一周するまで
+// 出てこない)。
+func (p *Playlist) StartAt(i int) {
+	p.SetIndex(i)
+	if p.shuffle && len(p.order) > 0 {
+		p.doShuffle()
+		p.gen++
+	}
+}
+
+// MoveQueueTo は待ち行列の位置 from の曲を位置 to へ動かす (間の曲は詰める)。
+// MoveQueue は 2 つの位置の入れ替えなので、ドラッグでの移動にはこちらを使う。
+func (p *Playlist) MoveQueueTo(from, to int) bool {
+	if from < 0 || from >= len(p.queue) || to < 0 || to >= len(p.queue) {
+		return false
+	}
+	if from == to {
+		return true
+	}
+	idx := p.queue[from]
+	p.queue = slices.Delete(p.queue, from, from+1)
+	p.queue = slices.Insert(p.queue, to, idx)
+	p.gen++
+	return true
+}
