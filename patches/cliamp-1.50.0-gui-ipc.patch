+// sendGUI は msg を Update に通し、返った答えと新しいモデルを返す。
+func sendGUI(t *testing.T, m Model, build func(reply chan ipc.Response) tea.Msg) (Model, ipc.Response) {
+	t.Helper()
+	reply := make(chan ipc.Response, 1)
+	next, _ := m.Update(build(reply))
+	select {
+	case resp := <-reply:
+		return next.(Model), resp
+	default:
+		t.Fatal("no reply")
+	}
+	return Model{}, ipc.Response{}
+}
