+// 「次に再生」した曲は 1 度だけ鳴り、up_next はそのとおりに示す。
+func TestEnqueueNextPlaysOnce(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		list    []string
+		current int
+		add     []string
+		want    []string
+	}{
+		{"middle", []string{"a", "b", "c"}, 0, []string{"X"}, []string{"X", "b", "c"}},
+		{"last track", []string{"a", "b", "c"}, 2, []string{"X"}, []string{"X"}},
+		{"album", []string{"a"}, 0, []string{"X1", "X2", "X3"}, []string{"X1", "X2", "X3"}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			m, _ := newGUITestModel(tt.list...)
+			startPlaying(&m, tt.current)
+			m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+				return ipc.EnqueueMsg{Tracks: newGUITestTracks(tt.add...), Mode: "next", Reply: r}
+			})
+			if !resp.OK {
+				t.Fatalf("resp = %+v", resp)
+			}
+			_, snap := sendGUI(t, m, func(r chan ipc.Response) tea.Msg { return ipc.PlaylistRequestMsg{Reply: r} })
+			var upNext []string
+			for _, i := range snap.UpNext {
+				upNext = append(upNext, snap.Tracks[i].Title)
+			}
+			played := titlesUntilEnd(m.playlist)
+			if !slices.Equal(played, tt.want) || !slices.Equal(upNext, tt.want) || len(snap.Queue) != 0 {
+				t.Fatalf("played %v, up_next %v, queue %v; want %v", played, upNext, snap.Queue, tt.want)
+			}
+		})
+	}
+}
