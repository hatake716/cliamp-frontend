+func TestGUIEnqueueNow(t *testing.T) {
+	m, eng := newGUITestModel("a", "b")
+	startPlaying(&m, 0)
+	stops := eng.stops
+	m, resp := sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.EnqueueMsg{Tracks: newGUITestTracks("x", "y"), Mode: "now", Reply: r}
+	})
+	if !resp.OK || eng.stops <= stops {
+		t.Fatalf("resp=%+v stops=%d", resp, eng.stops)
+	}
+	if cur, idx := m.playlist.Current(); cur.Title != "x" || idx != 2 {
+		t.Fatalf("current = (%q,%d), want (x,2)", cur.Title, idx)
+	}
+	// シャッフルでなければ y は並びのまま x に続く (待ち行列に入れると 2 度鳴る)。
+	if next, _ := m.playlist.PeekNext(); next.Title != "y" || m.playlist.QueueLen() != 0 {
+		t.Fatalf("next=%q queue=%v, want y and empty queue", next.Title, m.playlist.QueueIndices())
+	}
+
+	m, _ = newGUITestModel("a", "b")
+	m.playlist.ToggleShuffle()
+	startPlaying(&m, 0)
+	m, _ = sendGUI(t, m, func(r chan ipc.Response) tea.Msg {
+		return ipc.EnqueueMsg{Tracks: newGUITestTracks("x", "y"), Mode: "now", Reply: r}
+	})
+	// シャッフルでも y は再生順で x のすぐ後ろ (待ち行列には入れない)。
+	next, _ := m.playlist.PeekNext()
+	if cur, _ := m.playlist.Current(); cur.Title != "x" || next.Title != "y" || m.playlist.QueueLen() != 0 {
+		t.Fatalf("shuffle: current=%q next=%q queue=%v, want x, y and empty", cur.Title, next.Title, m.playlist.QueueIndices())
+	}
+}
