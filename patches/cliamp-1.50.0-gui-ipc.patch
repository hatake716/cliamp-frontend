+// A 429 whose body says QUOTA_EXCEEDED fails at once (even with a short
+// Retry-After); any other 429 keeps the capped retry.
+func TestWebAPIQuotaExceeded(t *testing.T) {
+	tests := []struct {
+		name       string
+		retryAfter string
+		body       string
+		wantErr    string // "" → retried once, then succeeds
+		wantCalls  int
+	}{
+		{"quota, Retry-After an hour", "3600", `{"error":{"status":429,"message":"Quota exceeded","reason":"QUOTA_EXCEEDED"}}`,
+			"spotify: Spotify quota exceeded for this developer account; retry after 1h0m0s", 1},
+		{"quota, short Retry-After is not retried", "1", `{"error":{"status":429,"message":"Quota exceeded","reason":"QUOTA_EXCEEDED"}}`,
+			"spotify: Spotify quota exceeded for this developer account; retry after 1s", 1},
+		{"quota, no Retry-After", "", `{"error":{"status":429,"reason":"QUOTA_EXCEEDED"}}`,
+			"spotify: Spotify quota exceeded for this developer account", 1},
+		{"quota, a day", "86400", `{"error":{"status":429,"message":"x","reason":"QUOTA_EXCEEDED"}}`,
+			"spotify: Spotify quota exceeded for this developer account; retry after 24h0m0s", 1},
+		{"ordinary rate limit with a JSON body", "1", `{"error":{"status":429,"message":"API rate limit exceeded"}}`, "", 2},
+		{"ordinary rate limit with another reason", "1", `{"error":{"status":429,"message":"slow down","reason":"RATE_LIMITED"}}`, "", 2},
+		{"ordinary rate limit without a body", "1", "", "", 2},
+		{"ordinary rate limit with a text body", "1", "Too Many Requests", "", 2},
+		{"ordinary long rate limit still fails fast", "86400", `{"error":{"status":429,"message":"API rate limit exceeded"}}`,
+			"spotify: rate limited by Spotify; retry after 24h0m0s", 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := isolate(t)
+			var calls atomic.Int32
+			f.handle("GET /v1/me/playlists", func(w http.ResponseWriter, _ *http.Request) {
+				if calls.Add(1) == 1 {
+					if tt.retryAfter != "" {
+						w.Header().Set("Retry-After", tt.retryAfter)
+					}
+					w.WriteHeader(http.StatusTooManyRequests)
+					_, _ = io.WriteString(w, tt.body)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"items":[],"total":0}`))
+			})
+			p := testProvider(t, true)
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			start := time.Now()
+			resp, err := p.webAPI(ctx, "GET", "/v1/me/playlists", nil)
+			elapsed := time.Since(start)
+			if resp != nil {
+				resp.Body.Close()
+			}
+			if tt.wantErr == "" {
+				if err != nil {
+					t.Fatalf("webAPI: %v", err)
+				}
+			} else {
+				if err == nil || err.Error() != tt.wantErr {
+					t.Fatalf("err = %v, want %q", err, tt.wantErr)
+				}
+				if elapsed > 2*time.Second {
+					t.Fatalf("failing took %v", elapsed)
+				}
+			}
+			if n := int(calls.Load()); n != tt.wantCalls {
+				t.Fatalf("requests = %d, want %d", n, tt.wantCalls)
+			}
+		})
+	}
+}
